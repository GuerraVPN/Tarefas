{
  "name": "tarefas-app",
  "version": "2.3.7",
  "private": true,
  "description": "TAREFAS Android 2.3.7 build 237 beta com Base Web 7.8.2, cópia de respostas e geração de arquivos pela IA.",
  "scripts": {
    "build:web": "node scripts/build-mobile-v237.mjs",
    "verify:web": "node scripts/verify-mobile-v237.mjs dist",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npm run build:web && npx cap sync android",
    "assets:android": "npx @capacitor/assets generate --android --assetPath assets --iconBackgroundColor '#040808' --iconBackgroundColorDark '#040808' --splashBackgroundColor '#040808' --splashBackgroundColorDark '#040808'",
    "cap:open": "npx cap open android",
    "android": "npm run cap:sync && npm run assets:android && npm run cap:open"
  },
  "dependencies": {
    "@capawesome-team/capacitor-file-opener": "8.0.2",
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.0",
    "@capacitor/file-transfer": "^2.0.4",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/local-notifications": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/push-notifications": "8.0.1",
    "@capacitor/share": "8.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.0",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "sharp": "0.35.4",
    "tar": "7.5.22",
    "uuid": "11.1.1"
  }
}

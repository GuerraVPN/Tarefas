{
  "name": "tarefas-app",
  "version": "1.9.0",
  "private": true,
  "description": "TAREFAS Android 1.9.0 build 190 oficial baseado na versão web 7.5.5",
  "scripts": {
    "build:web": "node scripts/build-mobile.mjs",
    "verify:web": "node scripts/verify-mobile-build.mjs dist",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npm run build:web && npx cap sync android",
    "assets:android": "npx @capacitor/assets generate --android --assetPath assets --iconBackgroundColor '#040808' --iconBackgroundColorDark '#040808' --splashBackgroundColor '#040808' --splashBackgroundColorDark '#040808'",
    "cap:open": "npx cap open android",
    "android": "npm run cap:sync && npm run assets:android && npm run cap:open"
  },
  "dependencies": {
    "@capawesome-team/capacitor-file-opener": "8.0.2",
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.0",
    "@capacitor/file-transfer": "^2.0.4",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/local-notifications": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/push-notifications": "8.0.1",
    "@capacitor/share": "8.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.0",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2"
  }
}
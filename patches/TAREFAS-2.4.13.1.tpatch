  "description": "Patch de teste da Beta 2.4.13 para evitar chamadas simultâneas à rotina de processamento de recorrências enquanto validamos a correção do banco.",
  "changelog": [
    "Protege o RPC processar_recorrencias_v4 contra chamadas simultâneas no mesmo WebView.",
    "Chamadas concorrentes compartilham a mesma execução em andamento, evitando processamento duplicado.",
    "A primeira execução continua sendo enviada normalmente ao Supabase; o patch não bloqueia a geração de recorrências.",
    "Mantém o restante do comportamento do aplicativo sem alterar tarefas, calendário ou permissões.",
    "Compatível com a Beta 2.4.13 / build 300."
  ],
  "order": 24131,
  "payload": {
    "js": "(()=>{'use strict';const MARK='__TAREFAS_24131_PATCH__';if(globalThis[MARK])return;globalThis[MARK]=true;function install(){const sb=globalThis.supabaseClient;if(!sb||typeof sb.rpc!=='function'||sb.__tarefas24131RpcGuard)return;if(sb.__tarefas24131RpcGuard)return;const original=sb.rpc.bind(sb);let inFlight=null;sb.rpc=function(fn,args,opts){if(String(fn)==='processar_recorrencias_v4'){if(inFlight)return inFlight;inFlight=original(fn,args,opts).finally(()=>{setTimeout(()=>{inFlight=null},1000)});return inFlight}return original(fn,args,opts)};try{Object.defineProperty(sb,'__tarefas24131RpcGuard',{value:true,configurable:false,enumerable:false})}catch(_){sb.__tarefas24131RpcGuard=true}}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',install,{once:true});else install();globalThis.TarefasPatch24131=Object.freeze({version:'2.4.13.1',base:'2.4.13',recurrenceRpcGuard:true})})();",

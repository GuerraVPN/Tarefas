  "description": "Ajusta somente o layout dos comandos de adicionar empresa, adicionar Nota Fiscal e avançar de etapa no módulo Notas Fiscais.",
  "changelog": [
    "Deixa Adicionar empresa com botão mais organizado, destacado e responsivo.",
    "Deixa Adicionar Nota Fiscal com o mesmo padrão visual do botão de empresa.",
    "Melhora o botão Avançar para, destacando a próxima etapa de forma mais clara.",
    "Ajusta espaçamentos, tamanhos, bordas, ícones e comportamento no celular.",
    "Não altera a lógica, banco, permissões, Escalas, biometria ou outros módulos."
  ],
  "order": 24909,
  "payload": {
    "js": "(()=>{'use strict';const MARK='__TAREFAS_2498_PATCH__';if(globalThis[MARK])return;globalThis[MARK]=true;const U='';const openNotes=()=>{document.getElementById('t984NotesOverlay')?.remove();document.body.insertAdjacentHTML('beforeend',\"<div class=\\\"t984-overlay\\\" id=\\\"t984NotesOverlay\\\"><section class=\\\"t984-page\\\"><header class=\\\"t984-top\\\"><div><h2>Orçamentários · Notas Fiscais</h2><p>Empresas de origem, notas fiscais, depósito de destino e andamento orçamentário.</p></div><button class=\\\"t984-close\\\" id=\\\"t984Close\\\" aria-label=\\\"Fechar\\\">×</button></header><div class=\\\"nf-hero\\\"><h3>Notas Fiscais</h3><p>Cadastre a empresa uma vez e selecione-a na origem de cada nota. O destino é um depósito já cadastrado no Orçamentários.</p></div><div class=\\\"nf-layout\\\"><section class=\\\"nf-panel\\\"><div class=\\\"nf-head\\\"><div><h3>Empresas</h3><span id=\\\"nfCompanyCount\\\">0 empresa(s)</span></div><div class=\\\"nf-actions\\\"><button class=\\\"orc-btn primary\\\" id=\\\"btnNovaEmpresa\\\"><span class=\\\"nf-btn-icon\\\">＋</span><span>Adicionar empresa</span></button></div></div><div class=\\\"nf-body\\\"><input class=\\\"nf-search\\\" id=\\\"nfCompanySearch\\\" placeholder=\\\"Buscar empresa...\\\"><div class=\\\"nf-company-list\\\" id=\\\"nfCompanyList\\\"><div class=\\\"nf-empty\\\">Carregando...</div></div></div></section><section class=\\\"nf-panel\\\"><div class=\\\"nf-head\\\"><div><h3>Notas Fiscais</h3><span id=\\\"nfListInfo\\\">0 nota(s)</span></div><div class=\\\"nf-actions\\\"><button class=\\\"orc-btn primary\\\" id=\\\"btnNovaNF\\\"><span class=\\\"nf-btn-icon\\\">＋</span><span>Adicionar Nota Fiscal</span></button></div></div><div class=\\\"nf-body\\\"><div class=\\\"nf-filters\\\"><input class=\\\"nf-search\\\" id=\\\"nfSearch\\\" placeholder=\\\"Buscar nº, empresa ou depósito...\\\"><select class=\\\"nf-select\\\" id=\\\"nfStatus\\\"><option value=\\\"\\\">Todos os andamentos</option></select><select class=\\\"nf-select\\\" id=\\\"nfNDFiltro\\\"><option value=\\\"\\\">Todas as ND</option><option value=\\\"30\\\">Material Consumo ND 30</option><option value=\\\"32\\\">Uso duradouro ND 32</option><option value=\\\"52\\\">Permanente ND 52</option></select></div><div class=\\\"nf-note-list\\\" id=\\\"nfList\\\"><div class=\\\"nf-empty\\\">Carregando...</div></div></div></section></div><section class=\\\"nf-panel\\\" id=\\\"nfDetailPanel\\\" style=\\\"margin-top:12px\\\"><div class=\\\"nf-detail\\\" id=\\\"nfDetail\\\"><div class=\\\"nf-empty\\\">Selecione uma Nota Fiscal para visualizar os dados.</div></div></section><div class=\\\"nf-modal\\\" id=\\\"empresaModal\\\"><div class=\\\"nf-modal-card\\\"><div class=\\\"nf-modal-head\\\"><h3>Nova empresa</h3><button class=\\\"nf-close\\\" id=\\\"closeEmpresa\\\">×</button></div><form class=\\\"nf-form\\\" id=\\\"empresaForm\\\"><div class=\\\"nf-field full\\\"><label>Empresa *</label><input class=\\\"nf-input\\\" id=\\\"empresaNome\\\" required maxlength=\\\"160\\\" placeholder=\\\"Nome / razão social\\\"></div><div class=\\\"nf-field\\\"><label>CNPJ (opcional)</label><input class=\\\"nf-input\\\" id=\\\"empresaCnpj\\\" inputmode=\\\"numeric\\\" maxlength=\\\"18\\\" placeholder=\\\"Somente números\\\"></div><div class=\\\"nf-form-actions\\\"><button type=\\\"button\\\" class=\\\"orc-btn\\\" id=\\\"cancelEmpresa\\\">Cancelar</button><button type=\\\"submit\\\" class=\\\"orc-btn primary\\\">Cadastrar empresa</button></div></form></div></div><div class=\\\"nf-modal\\\" id=\\\"nfModal\\\"><div class=\\\"nf-modal-card\\\"><div class=\\\"nf-modal-head\\\"><h3>Nova Nota Fiscal</h3><button class=\\\"nf-close\\\" id=\\\"closeNF\\\">×</button></div><form class=\\\"nf-form\\\" id=\\\"nfForm\\\"><div class=\\\"nf-field\\\"><label>Nº da Nota Fiscal *</label><input class=\\\"nf-input\\\" id=\\\"nfNumero\\\" required maxlength=\\\"60\\\" placeholder=\\\"Ex.: 000123\\\"></div><div class=\\\"nf-field\\\"><label>Valor total *</label><input class=\\\"nf-input\\\" id=\\\"nfValor\\\" required type=\\\"number\\\" min=\\\"0\\\" step=\\\"0.01\\\" placeholder=\\\"0,00\\\"></div><div class=\\\"nf-field\\\"><label>Empresa na origem *</label><select class=\\\"nf-select\\\" id=\\\"nfEmpresa\\\" required></select></div><div class=\\\"nf-field\\\"><label>Depósito no destino *</label><select class=\\\"nf-select\\\" id=\\\"nfDeposito\\\" required></select></div><div class=\\\"nf-field full\\\"><label>Classificação do material *</label><select class=\\\"nf-select\\\" id=\\\"nfND\\\" required><option value=\\\"\\\">Selecione...</option><option value=\\\"30\\\">Material Consumo ND 30</option><option value=\\\"32\\\">Uso duradouro ND 32</option><option value=\\\"52\\\">Permanente ND 52</option></select></div><div class=\\\"nf-form-actions\\\"><button type=\\\"button\\\" class=\\\"orc-btn\\\" id=\\\"cancelNF\\\">Cancelar</button><button type=\\\"submit\\\" class=\\\"orc-btn primary\\\">Cadastrar Nota Fiscal</button></div></form></div></div></section></div>\");const st=document.createElement('style');st.id='t984NotesStyle';st.textContent=\".t984-overlay{position:fixed;inset:0;z-index:2147483000;background:var(--v4-bg,#07100f);color:var(--v4-text,#fff);overflow:auto}.t984-page{padding:12px 12px 28px;max-width:1100px;margin:0 auto}.t984-top{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 2px 14px}.t984-top h2{font-size:17px;margin:0}.t984-top p{font-size:9px;color:var(--v4-muted);margin:4px 0 0}.t984-close{border:0;background:transparent;color:inherit;font-size:28px;line-height:1;padding:4px 8px}.nf-layout{display:grid;grid-template-columns:minmax(220px,.42fr) minmax(0,1.58fr);gap:12px}.nf-panel{background:var(--v4-surface);border:1px solid var(--v4-border);border-radius:12px;min-width:0}.nf-head{padding:13px 14px;border-bottom:1px solid var(--v4-border);display:flex;align-items:center;justify-content:space-between;gap:10px}.nf-head h3{font-size:12px;margin:0}.nf-head span{font-size:9px;color:var(--v4-muted)}.nf-body{padding:12px}.nf-actions{display:flex;gap:7px;flex-wrap:wrap};.nf-actions .orc-btn.primary{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:38px;padding:9px 13px;border-radius:10px;font-size:10px;font-weight:800;letter-spacing:.1px;white-space:nowrap;box-shadow:0 5px 14px rgba(0,0,0,.14);transition:transform .15s ease,filter .15s ease,box-shadow .15s ease}.nf-actions .orc-btn.primary:hover,.nf-actions .orc-btn.primary:focus-visible,.nf-advance-btn:hover,.nf-advance-btn:focus-visible{transform:translateY(-1px);filter:brightness(1.06);box-shadow:0 8px 18px rgba(0,0,0,.2)}.nf-btn-icon{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;border-radius:6px;background:rgba(255,255,255,.16);font-size:15px;line-height:1}.nf-advance-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px;padding:10px 15px;border-radius:11px;font-size:10px;font-weight:800;box-shadow:0 6px 16px rgba(0,0,0,.16)}.nf-btn-arrow{display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;border-radius:7px;background:rgba(255,255,255,.16);font-size:14px}.nf-advance-btn strong{font-size:10px}.nf-form-actions .orc-btn{min-height:38px;padding:9px 13px;border-radius:9px;font-size:10px;font-weight:800}@media(max-width:650px){.nf-head{align-items:flex-start;flex-direction:column}.nf-head .nf-actions{width:100%}.nf-head .nf-actions .orc-btn.primary{width:100%;min-height:40px}.nf-actions-bar{padding-top:4px}.nf-advance-btn{width:100%;min-height:44px}.nf-advance-btn strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}}.nf-search{width:100%;box-sizing:border-box;padding:9px 10px;border:1px solid var(--v4-border-strong);border-radius:8px;background:var(--v4-surface-2);color:var(--v4-text);outline:none}.nf-select,.nf-input{width:100%;box-sizing:border-box;padding:9px 10px;border:1px solid var(--v4-border-strong);border-radius:8px;background:var(--v4-surface-2);color:var(--v4-text)}.nf-filters{display:grid;grid-template-columns:minmax(180px,1.5fr) 180px 210px;gap:8px;margin-bottom:10px}.nf-company{border:1px solid var(--v4-border);border-radius:9px;padding:10px;margin-bottom:7px;cursor:pointer;background:var(--v4-surface-2)}.nf-company:hover,.nf-company.active{border-color:var(--v4-accent);background:var(--v4-accent-soft)}.nf-company strong{display:block;font-size:10px}.nf-company small{display:block;color:var(--v4-muted);font-size:8px;margin-top:3px}.nf-note-card{border:1px solid var(--v4-border);border-radius:10px;padding:11px;margin-bottom:7px;cursor:pointer;background:var(--v4-surface-2)}.nf-note-card:hover,.nf-note-card.active{border-color:var(--v4-accent);box-shadow:0 0 0 2px var(--v4-accent-soft)}.nf-note-top{display:flex;justify-content:space-between;align-items:flex-start;gap:8px}.nf-note-top strong{font-size:11px}.nf-note-meta{font-size:8px;color:var(--v4-muted);line-height:1.5;margin-top:5px}.nf-status{display:inline-flex;padding:4px 7px;border-radius:999px;font-size:8px;font-weight:800;border:1px solid var(--v4-border-strong);white-space:nowrap}.nf-status.wait{color:var(--v4-warning);border-color:var(--v4-warning)}.nf-status.ok{color:var(--v4-success,#16a34a);border-color:var(--v4-success,#16a34a)}.nf-status.info{color:var(--v4-accent);border-color:var(--v4-accent)}.nf-detail{padding:15px}.nf-detail-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.nf-kv{padding:10px;border:1px solid var(--v4-border);border-radius:9px;background:var(--v4-surface-2)}.nf-kv small{display:block;font-size:8px;color:var(--v4-muted);margin-bottom:4px}.nf-kv b{font-size:10px;overflow-wrap:anywhere}.nf-section{margin-top:12px;padding-top:12px;border-top:1px solid var(--v4-border)}.nf-flow{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}.nf-step{padding:9px 7px;border-radius:8px;border:1px solid var(--v4-border);background:var(--v4-surface-2);font-size:8px;text-align:center;line-height:1.3}.nf-step.current{border-color:var(--v4-accent);background:var(--v4-accent-soft);color:var(--v4-accent);font-weight:800}.nf-step.done{border-color:var(--v4-success,#16a34a);color:var(--v4-success,#16a34a)}.nf-actions-bar{display:flex;gap:7px;align-items:center;flex-wrap:wrap}.nf-empty{text-align:center;padding:35px 10px;color:var(--v4-muted);font-size:10px}.nf-history-item{padding:8px 0;border-bottom:1px solid var(--v4-border)}.nf-history-item:last-child{border-bottom:0}.nf-history-item strong{font-size:9px}.nf-history-item p{margin:3px 0;font-size:8px;color:var(--v4-text-2)}.nf-history-item small{font-size:7px;color:var(--v4-muted)}.nf-modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.65);align-items:center;justify-content:center;z-index:2147483005}.nf-modal.open{display:flex}.nf-modal-card{width:min(620px,94vw);max-height:90vh;overflow:auto;background:var(--v4-surface);border:1px solid var(--v4-border);border-radius:14px}.nf-modal-head{padding:13px 15px;border-bottom:1px solid var(--v4-border);display:flex;justify-content:space-between;align-items:center}.nf-modal-head h3{font-size:13px}.nf-close{border:0;background:transparent;color:var(--v4-text);font-size:22px}.nf-form{padding:15px;display:grid;grid-template-columns:1fr 1fr;gap:9px}.nf-field.full{grid-column:1/-1}.nf-field label{display:block;font-size:8px;font-weight:800;margin-bottom:5px;color:var(--v4-text-2)}.nf-form-actions{grid-column:1/-1;display:flex;justify-content:flex-end;gap:7px;padding-top:5px}.nf-note-list,.nf-company-list{max-height:430px;overflow:auto}.nf-hero{background:var(--v4-surface);border:1px solid var(--v4-border);border-radius:12px;padding:14px;margin-bottom:12px}.nf-hero h3{font-size:14px;margin:0}.nf-hero p{font-size:9px;color:var(--v4-muted);margin-top:4px}@media(max-width:850px){.nf-layout{grid-template-columns:1fr}.nf-filters{grid-template-columns:1fr}.nf-flow{grid-template-columns:1fr 1fr}}@media(max-width:650px){.t984-page{padding:8px 9px 24px}.nf-detail-grid,.nf-form{grid-template-columns:1fr}.nf-field.full{grid-column:auto}.nf-filters{grid-template-columns:1fr}}\";document.head.appendChild(st);document.getElementById('t984Close').onclick=()=>{document.getElementById('t984NotesOverlay')?.remove();document.getElementById('t984NotesStyle')?.remove()};if(!window.__TAREFAS_NF_CLIENT__){try{window.__TAREFAS_NF_CLIENT__=supabaseClient}catch(_){}}if(!window.__TAREFAS_NF_CLIENT__){alert('Não foi possível abrir Notas Fiscais: conexão do Supabase indisponível.');return}document.getElementById('tmDrawer')?.remove();startNF()};const $=id=>document.getElementById(id);\nconst esc=v=>String(v??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#039;'}[c]));\nconst norm=v=>String(v??'').normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').trim().toLowerCase();\nconst money=v=>Number(v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});\nconst dt=v=>v?new Date(v).toLocaleString('pt-BR'):'-';\nconst STATUS=[\n {id:'aguardando_aprovacao_fiscal_administrativo',label:'Aguardando aprovação do Fiscal Administrativo'},\n {id:'aguardando_inclusao_siscofis',label:'Aguardando inclusão no Siscofis'},\n {id:'aguardando_inclusao_carga',label:'Aguardando inclusão em carga'},\n {id:'pronto',label:'Pronto'}\n];\nconst ND={30:'Material Consumo ND 30',32:'Uso duradouro ND 32',52:'Permanente ND 52'};\nlet user=null,canApprove=false,empresas=[],depositos=[],notas=[],selected=null,historico=[];\nfunction profileId(){return user?.perfil_id!=null?Number(user.perfil_id):null}\nasync function initUser(){\n const base=JSON.parse(localStorage.getItem('usuarioLogado')||'null');if(!base?.id)return false;\n user=base;\n if(window.Perfis26){try{const p=await Perfis26.carregar(window.__TAREFAS_NF_CLIENT__,base);user=p.usuario}catch(_){}}\n const sec=norm(user.secao),pos=norm(user.posicao);\n canApprove=sec==='admin'||(sec==='fiscalizacao'&&['chefe','auxiliar','fiscal administrativo','fiscal_administrativo'].includes(pos));\n return true;\n}\nfunction timeout(p,ms,label){return Promise.race([p,new Promise((_,reject)=>setTimeout(()=>reject(new Error(label+' demorou mais de 7s.')),ms))])}\nasync function loadData(){\n const results=await Promise.allSettled([\n   timeout(window.__TAREFAS_NF_CLIENT__.from('orc_empresas').select('*').eq('ativo',true).order('nome'),7000,'Empresas'),\n   timeout(window.__TAREFAS_NF_CLIENT__.from('orc_depositos').select('id,nome').eq('ativo',true).order('ordem'),7000,'Depósitos'),\n   timeout(window.__TAREFAS_NF_CLIENT__.from('orc_notas_fiscais_resumo').select('*').order('criado_em',{ascending:false}),7000,'Notas Fiscais')\n ]);\n const e=results[0],d=results[1],n=results[2];\n if(e.status==='fulfilled'&&!e.value.error)empresas=e.value.data||[];else throw new Error(e.status==='rejected'?e.reason?.message:(e.value?.error?.message||'Falha ao carregar empresas.'));\n if(d.status==='fulfilled'&&!d.value.error)depositos=d.value.data||[];else throw new Error(d.status==='rejected'?d.reason?.message:(d.value?.error?.message||'Falha ao carregar depósitos.'));\n if(n.status==='fulfilled'&&!n.value.error)notas=n.value.data||[];else throw new Error(n.status==='rejected'?n.reason?.message:(n.value?.error?.message||'Falha ao carregar notas fiscais.'));\n fillSelects();renderEmpresas();renderNotas();\n}\nfunction fillSelects(){\n $('nfEmpresa').innerHTML='<option value=\"\">Selecione...</option>'+empresas.map(x=>'<option value=\"'+x.id+'\">'+esc(x.nome)+(x.cnpj?' · CNPJ '+esc(x.cnpj):'')+'</option>').join('');\n $('nfDeposito').innerHTML='<option value=\"\">Selecione...</option>'+depositos.map(x=>'<option value=\"'+x.id+'\">'+esc(x.nome)+'</option>').join('');\n $('nfStatus').innerHTML='<option value=\"\">Todos os andamentos</option>'+STATUS.map(x=>'<option value=\"'+x.id+'\">'+x.label+'</option>').join('');\n}\nfunction statusBy(id){return STATUS.find(x=>x.id===id)||STATUS[0]}\nfunction statusClass(id){return id==='pronto'?'ok':id==='aguardando_aprovacao_fiscal_administrativo'?'wait':'info'}\nfunction renderEmpresas(){\n const q=norm($('nfCompanySearch').value);\n const arr=empresas.filter(x=>!q||norm(x.nome+' '+(x.cnpj||'')).includes(q));\n $('nfCompanyCount').textContent=empresas.length+' empresa(s)';\n $('nfCompanyList').innerHTML=arr.length?arr.map(x=>'<article class=\"nf-company '+(selected&&String(selected.empresa_id)===String(x.id)?'active':'')+'\" data-company=\"'+x.id+'\"><strong>'+esc(x.nome)+'</strong><small>'+(x.cnpj?'CNPJ '+esc(x.cnpj):'Sem CNPJ cadastrado')+'</small></article>').join(''):'<div class=\"nf-empty\">Nenhuma empresa encontrada.</div>';\n}\nfunction filteredNotas(){\n const q=norm($('nfSearch').value),s=$('nfStatus').value,nd=$('nfNDFiltro').value;\n return notas.filter(n=>{\n   if(s&&n.status!==s)return false;if(nd&&String(n.nd)!==nd)return false;\n   return !q||norm(n.numero+' '+n.empresa_origem+' '+n.deposito_destino+' '+n.natureza_material).includes(q);\n });\n}\nfunction renderNotas(){\n const arr=filteredNotas();$('nfListInfo').textContent=arr.length+' nota(s)';\n $('nfList').innerHTML=arr.length?arr.map(n=>{const st=statusBy(n.status);return '<article class=\"nf-note-card '+(selected&&String(selected.id)===String(n.id)?'active':'')+'\" data-note=\"'+n.id+'\"><div class=\"nf-note-top\"><strong>NF '+esc(n.numero)+'</strong><span class=\"nf-status '+statusClass(n.status)+'\">'+esc(st.label)+'</span></div><div class=\"nf-note-meta\">'+esc(n.empresa_origem)+' → '+esc(n.deposito_destino)+'<br>'+esc(n.natureza_material)+' · '+money(n.valor_total)+'</div></article>'}).join(''):'<div class=\"nf-empty\">Nenhuma nota fiscal encontrada.</div>';\n}\nfunction renderDetail(){\n const e=$('nfDetail');if(!selected){e.innerHTML='<div class=\"nf-empty\">Selecione uma Nota Fiscal para visualizar os dados.</div>';return}\n const idx=STATUS.findIndex(x=>x.id===selected.status),st=statusBy(selected.status);\n const steps=STATUS.map((x,i)=>'<div class=\"nf-step '+(i<idx?'done ':'')+(i===idx?'current':'')+'\">'+(i<idx?'✓ ':'')+esc(x.label)+'</div>').join('');\n let button='';\n if(selected.status!=='pronto'){\n   const next=STATUS[idx+1];\n   const first=selected.status==='aguardando_aprovacao_fiscal_administrativo';\n   if(first&&!canApprove)button='<span style=\"font-size:9px;color:var(--v4-muted)\">Aguardando aprovação do Fiscal Administrativo.</span>';\n   else button='<button class=\"orc-btn primary\" id=\"btnNfAdvance\">Avançar para: '+esc(next.label)+'</button>';\n }\n e.innerHTML='<div class=\"nf-detail\"><div class=\"nf-head\" style=\"padding:0 0 12px;border:0\"><div><h3>Nota Fiscal '+esc(selected.numero)+'</h3><span>Cadastrada em '+dt(selected.criado_em)+'</span></div><span class=\"nf-status '+statusClass(selected.status)+'\">'+esc(st.label)+'</span></div><div class=\"nf-detail-grid\"><div class=\"nf-kv\"><small>Número</small><b>'+esc(selected.numero)+'</b></div><div class=\"nf-kv\"><small>Valor total</small><b>'+money(selected.valor_total)+'</b></div><div class=\"nf-kv\"><small>Empresa na origem</small><b>'+esc(selected.empresa_origem)+'</b></div><div class=\"nf-kv\"><small>Depósito no destino</small><b>'+esc(selected.deposito_destino)+'</b></div><div class=\"nf-kv\"><small>Classificação</small><b>'+esc(ND[selected.nd]||selected.natureza_material)+'</b></div><div class=\"nf-kv\"><small>Andamento atual</small><b>'+esc(st.label)+'</b></div></div><div class=\"nf-section\"><h3 style=\"font-size:11px;margin-bottom:8px\">Andamento</h3><div class=\"nf-flow\">'+steps+'</div><div class=\"nf-section nf-actions-bar\">'+button+'</div></div><div class=\"nf-section\"><h3 style=\"font-size:11px;margin-bottom:6px\">Histórico</h3><div id=\"nfHistory\"><div class=\"nf-empty\">Carregando histórico...</div></div></div></div>';\n if(selected.status!=='pronto' && (! (selected.status==='aguardando_aprovacao_fiscal_administrativo'&&!canApprove))) $('btnNfAdvance').onclick=advance;\n loadHistory(selected.id);\n}\nasync function loadHistory(id){\n const r=await timeout(window.__TAREFAS_NF_CLIENT__.from('orc_notas_fiscais_historico').select('*').eq('nota_fiscal_id',id).order('criado_em',{ascending:false}),7000,'Histórico');\n historico=r.error?[]:r.data||[];\n const box=$('nfHistory');if(!box)return;\n box.innerHTML=historico.length?historico.map(h=>'<div class=\"nf-history-item\"><strong>'+esc(statusBy(h.status_novo).label)+'</strong><p>'+esc(h.mensagem||'Andamento atualizado.')+'</p><small>'+dt(h.criado_em)+'</small></div>').join(''):'<div class=\"nf-empty\">Sem histórico.</div>';\n}\nasync function advance(){\n if(!selected)return;\n const i=STATUS.findIndex(x=>x.id===selected.status),next=STATUS[i+1];if(!next)return;\n if(selected.status==='aguardando_aprovacao_fiscal_administrativo'&&!canApprove)return;\n const b=$('btnNfAdvance');if(b)b.disabled=true;\n const r=await timeout(window.__TAREFAS_NF_CLIENT__.from('orc_notas_fiscais').update({status:next.id}).eq('id',selected.id),7000,'Atualização do andamento');\n if(r.error){alert('Erro ao avançar: '+r.error.message);if(b)b.disabled=false;return}\n selected={...selected,status:next.id};notas=notas.map(n=>String(n.id)===String(selected.id)?selected:n);renderNotas();renderEmpresas();renderDetail();\n}\nasync function createEmpresa(e){\n e.preventDefault();const nome=$('empresaNome').value.trim(),cnpj=$('empresaCnpj').value.replace(/\\D/g,'')||null;if(!nome)return;\n const b=e.submitter;b.disabled=true;const r=await timeout(window.__TAREFAS_NF_CLIENT__.from('orc_empresas').insert({nome,cnpj}),7000,'Cadastro de empresa');\n if(r.error){alert('Erro ao cadastrar empresa: '+r.error.message);b.disabled=false;return}\n $('empresaForm').reset();$('empresaModal').classList.remove('open');await loadData();toast('Empresa cadastrada.');b.disabled=false;\n}\nasync function createNF(e){\n e.preventDefault();const numero=$('nfNumero').value.trim(),valor=Number($('nfValor').value),empresa=Number($('nfEmpresa').value),dep=Number($('nfDeposito').value),nd=Number($('nfND').value);\n if(!numero||!Number.isFinite(valor)||!empresa||!dep||![30,32,52].includes(nd))return;\n const b=e.submitter;b.disabled=true;\n const r=await timeout(window.__TAREFAS_NF_CLIENT__.from('orc_notas_fiscais').insert({numero,valor_total:valor,empresa_id:empresa,deposito_id:dep,nd}),7000,'Cadastro da Nota Fiscal');\n if(r.error){alert('Erro ao cadastrar nota fiscal: '+r.error.message);b.disabled=false;return}\n $('nfForm').reset();$('nfModal').classList.remove('open');await loadData();toast('Nota Fiscal cadastrada.');b.disabled=false;\n}\nfunction toast(msg){const el=document.createElement('div');el.textContent=msg;el.style.cssText='position:fixed;right:18px;bottom:18px;z-index:500;background:var(--v4-surface);color:var(--v4-text);border:1px solid var(--v4-border);padding:10px 13px;border-radius:9px;font-size:10px;box-shadow:0 10px 30px rgba(0,0,0,.2)';document.body.appendChild(el);setTimeout(()=>el.remove(),2400)}\nfunction bind(){\n $('btnNovaEmpresa').onclick=()=>{$('empresaModal').classList.add('open');$('empresaNome').focus()};\n $('closeEmpresa').onclick=$('cancelEmpresa').onclick=()=>$('empresaModal').classList.remove('open');\n $('closeNF').onclick=$('cancelNF').onclick=()=>$('nfModal').classList.remove('open');\n $('empresaModal').onclick=e=>{if(e.target===$('empresaModal'))$('empresaModal').classList.remove('open')};\n $('nfModal').onclick=e=>{if(e.target===$('nfModal'))$('nfModal').classList.remove('open')};\n $('empresaForm').onsubmit=createEmpresa;$('nfForm').onsubmit=createNF;\n $('btnNovaNF').onclick=()=>{$('nfModal').classList.add('open');$('nfNumero').focus()};\n $('nfCompanySearch').oninput=renderEmpresas;$('nfSearch').oninput=renderNotas;$('nfStatus').onchange=renderNotas;$('nfNDFiltro').onchange=renderNotas;\n $('nfList').onclick=e=>{const card=e.target.closest('[data-note]');if(!card)return;selected=notas.find(n=>String(n.id)===String(card.dataset.note))||null;renderNotas();renderEmpresas();renderDetail()};\n $('nfCompanyList').onclick=e=>{const card=e.target.closest('[data-company]');if(!card)return;const empresa=empresas.find(x=>String(x.id)===String(card.dataset.company));$('nfSearch').value=empresa?empresa.nome:'';renderNotas()};\n}\nasync function startNF(){\n if(!await initUser()){location.replace('index.html');return}\n bind();\n try{await loadData()}catch(err){console.error(err);$('nfList').innerHTML='<div class=\"nf-empty\">Erro ao abrir Notas Fiscais:<br>'+esc(err.message)+'</div>';};\n}const installMenu=()=>{const d=document.getElementById('tmDrawer');if(!d||d.querySelector('[data-t984-notas]'))return;const g=d.querySelector('[data-href=\"orcamentarios.html?modulo=guias\"]');if(!g)return;const b=document.createElement('button');b.className=g.className;b.dataset.t984Notas='1';b.innerHTML='<span><strong>Notas Fiscais</strong><small>Notas, empresas e andamento orçamentário</small></span><span aria-hidden=\"true\">›</span>';b.addEventListener('click',e=>{e.preventDefault();e.stopPropagation();openNotes()},{capture:true});g.insertAdjacentElement('afterend',b)};document.addEventListener('click',e=>{if(e.target.closest?.('[data-menu]'))setTimeout(installMenu,0)},{capture:true});setTimeout(installMenu,0);})();",

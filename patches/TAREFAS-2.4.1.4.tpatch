{
  "format": "tarefas-tpatch-v1",
  "id": "2.4.1.4",
  "name": "TAREFAS 2.4.1.4 — Biometria sem login duplicado",
  "patchVersion": 4,
  "createdAt": "2026-09-22T17:50:00Z",
  "baseVersion": "2.4.1",
  "minBuild": 276,
  "maxBuild": 276,
  "channel": "alpha",
  "cumulative": true,
  "replacementMode": "replace-older-same-base",
  "replaces": [
    "2.4.1.1",
    "2.4.1.2",
    "2.4.1.3"
  ],
  "description": "Corrige o segundo pedido de login/biometria após uma autenticação já concluída na tela de entrada.",
  "changelog": [
    "Corrige o login biométrico sendo solicitado duas vezes ao entrar no aplicativo.",
    "Uma autenticação concluída na tela de login passa a valer como desbloqueio do ciclo atual do app.",
    "Login por senha também passa a impedir uma segunda solicitação biométrica logo após entrar.",
    "A biometria continua sendo solicitada novamente apenas em um novo início real do aplicativo.",
    "Mantém as correções de EXIT USERS/Reinício e sincronização da versão das Alphas anteriores.",
    "Preserva Base Web 7.9.1, seletor nativo de ícones e todas as funções da Beta 2.4.1."
  ],
  "order": 241104,
  "payload": {
    "js": "(()=>{\n'use strict';\n\nconst PATCH_VERSION='2.4.1.4';\nconst BASE_VERSION='2.4.1';\nconst BASE_BUILD=276;\nconst WEB_VERSION='7.9.1';\nconst MARK='__TAREFAS_ALPHA_2414_BIOMETRIC_HANDOFF__';\nconst SYNC_KEY='tarefas2414VersionSyncAt';\nconst SITE_EXIT_KEY='tarefas_site_791_exit_seen';\nconst SITE_RESTART_KEY='tarefas_site_791_restart_seen';\nconst SESSION_KEY='tarefasPushSession17';\nconst USER_KEY='usuarioLogado';\nconst PROCESS_SESSION_KEY='tarefasSecureProcessSessionV1';\nconst SECURE_UNLOCK_KEY='tarefasSecureUnlocked23249';\nconst SECURE_LOCK_KEY='tarefasSecureLockRequired23249';\n\nif(globalThis[MARK])return;\nglobalThis[MARK]=true;\n\nglobalThis.__TAREFAS_EFFECTIVE_VERSION__=PATCH_VERSION;\nglobalThis.__TAREFAS_WEB_BASE_VERSION__=WEB_VERSION;\ndocument.documentElement.dataset.tarefasEffectiveVersion=PATCH_VERSION;\ndocument.documentElement.dataset.tarefasWebVersion=WEB_VERSION;\n\nconst page=()=>String(location.pathname.split('/').pop()||'index.html').toLowerCase();\nconst isLoginPage=()=>page()==='index.html'||page()==='';\nconst getClient=()=>{try{return typeof supabaseClient!=='undefined'?supabaseClient:null}catch(_){return null}};\nconst sessionToken=()=>String(localStorage.getItem(SESSION_KEY)||'').trim();\nconst currentUser=()=>{try{return JSON.parse(localStorage.getItem(USER_KEY)||'null')}catch(_){return null}};\n\nfunction applyLabels(){\n  try{\n    document.querySelectorAll('.tm-app-brand small').forEach(el=>{\n      const wanted=PATCH_VERSION+' • WEB '+WEB_VERSION;\n      if(el.textContent.trim()!==wanted)el.textContent=wanted;\n    });\n    document.querySelectorAll('[data-tarefas-version],[data-app-version],.tm-about-version').forEach(el=>{\n      const text=String(el.textContent||'');\n      if(!text||text.length>160)return;\n      const next=text\n        .replace(/\\b2\\.4\\.1(?:\\.[123])?\\b/g,PATCH_VERSION)\n        .replace(/\\b2\\.3\\.222\\.1\\b/g,BASE_VERSION);\n      if(next!==text)el.textContent=next;\n    });\n  }catch(_){}\n}\n\nfunction markFreshAuthentication(){\n  if(!isLoginPage())return false;\n  const token=sessionToken();\n  const user=currentUser();\n  if(token.length<32||!user?.id)return false;\n  try{\n    sessionStorage.setItem(PROCESS_SESSION_KEY,'1');\n    sessionStorage.setItem(SECURE_UNLOCK_KEY,'1');\n    sessionStorage.removeItem(SECURE_LOCK_KEY);\n    sessionStorage.setItem('tarefasFreshAuth2414',String(Date.now()));\n  }catch(_){}\n  window.dispatchEvent(new CustomEvent('tarefas:secure-unlocked',{detail:{version:PATCH_VERSION,source:'login-handoff',at:Date.now()}}));\n  return true;\n}\n\nfunction installLoginHandoff(){\n  if(!isLoginPage()||globalThis.__TAREFAS_LOGIN_HANDOFF_2414__)return;\n  globalThis.__TAREFAS_LOGIN_HANDOFF_2414__=true;\n  const nativeSet=Storage.prototype.setItem;\n  Storage.prototype.setItem=function(key,value){\n    const result=nativeSet.call(this,key,value);\n    try{\n      if(this===localStorage&&(String(key)===SESSION_KEY||String(key)===USER_KEY)){\n        queueMicrotask(markFreshAuthentication);\n      }\n    }catch(_){}\n    return result;\n  };\n}\n\nlet syncing=null;\nasync function syncRegisteredVersion({force=false}={}){\n  if(syncing)return syncing;\n  syncing=(async()=>{\n    const token=sessionToken();\n    const client=getClient();\n    if(!token||token.length<32||!client)return false;\n    if(!force){\n      const last=Number(localStorage.getItem(SYNC_KEY)||0);\n      if(last&&Date.now()-last<5*60*1000)return true;\n    }\n    const {data,error}=await client.rpc('v2_4_1_1_sync_app_version',{p_session_token:token,p_app_version:BASE_VERSION});\n    if(error)throw error;\n    if(data!==true)return false;\n    localStorage.setItem(SYNC_KEY,String(Date.now()));\n    window.dispatchEvent(new CustomEvent('tarefas:app-version-synced',{detail:{baseVersion:BASE_VERSION,effectiveVersion:PATCH_VERSION,build:BASE_BUILD}}));\n    window.dispatchEvent(new CustomEvent('v6:notificacoes:update'));\n    return true;\n  })().catch(err=>{\n    console.warn('[TAREFAS 2.4.1.4] Falha ao sincronizar versão do aparelho:',err?.message||err);\n    return false;\n  }).finally(()=>{syncing=null});\n  return syncing;\n}\n\nasync function seedSiteControlTokens(){\n  try{\n    const panel=globalThis.SitePanel791;\n    if(!panel)return false;\n    let state=panel.state?.()||null;\n    if(!state&&panel.refresh){try{await panel.refresh()}catch(_){}state=panel.state?.()||null}\n    if(!state)return false;\n    if(localStorage.getItem(SITE_EXIT_KEY)===null&&state.acao_pendente!=='exit_users')localStorage.setItem(SITE_EXIT_KEY,String(Number(state.exit_token||0)));\n    if(localStorage.getItem(SITE_RESTART_KEY)===null&&state.acao_pendente!=='reiniciar')localStorage.setItem(SITE_RESTART_KEY,String(Number(state.restart_token||0)));\n    return true;\n  }catch(err){\n    console.warn('[TAREFAS 2.4.1.4] Falha ao criar baseline do Painel SITE:',err?.message||err);\n    return false;\n  }\n}\n\nlet baselineTimer=null;\nlet baselineAttempts=0;\nfunction ensureSiteBaseline(){\n  if(baselineTimer)return;\n  baselineAttempts=0;\n  const tick=async()=>{\n    baselineAttempts++;\n    const ok=await seedSiteControlTokens();\n    if(ok||baselineAttempts>=20){clearInterval(baselineTimer);baselineTimer=null}\n  };\n  tick();\n  baselineTimer=setInterval(tick,500);\n}\n\nfunction scheduleSync(force=false){setTimeout(()=>syncRegisteredVersion({force}),250)}\n\ninstallLoginHandoff();\napplyLabels();\nensureSiteBaseline();\nscheduleSync(true);\n\nwindow.addEventListener('pageshow',()=>{applyLabels();ensureSiteBaseline();scheduleSync(false)});\nwindow.addEventListener('focus',()=>{applyLabels();ensureSiteBaseline();scheduleSync(false)});\nwindow.addEventListener('tarefas:push-session-ready',()=>{markFreshAuthentication();ensureSiteBaseline();scheduleSync(true)});\nwindow.addEventListener('tarefas:push-status',event=>{if(event?.detail?.ready===true){ensureSiteBaseline();scheduleSync(true)}});\ndocument.addEventListener('visibilitychange',()=>{if(!document.hidden){applyLabels();ensureSiteBaseline();scheduleSync(false)}});\n\nconst observer=new MutationObserver(records=>{\n  for(const record of records){\n    for(const node of record.addedNodes){\n      if(node.nodeType!==1)continue;\n      if(node.matches?.('.tm-app-brand,.tm-about-version,[data-tarefas-version],[data-app-version]')||node.querySelector?.('.tm-app-brand,.tm-about-version,[data-tarefas-version],[data-app-version]')){queueMicrotask(applyLabels);return}\n    }\n  }\n});\nobserver.observe(document.body,{childList:true,subtree:true});\n\nglobalThis.TarefasAlpha2414=Object.freeze({\n  patchVersion:PATCH_VERSION,\n  baseVersion:BASE_VERSION,\n  build:BASE_BUILD,\n  webVersion:WEB_VERSION,\n  markFreshAuthentication,\n  sync:()=>syncRegisteredVersion({force:true}),\n  baselineSite:seedSiteControlTokens,\n  refresh:applyLabels\n});\n})();",
    "css": ""
  },
  "payloadSha256": "361dab72d8fd0dff531cf53f1714a74a9881ac697450f068b9d4ad5f6b99339a"
}

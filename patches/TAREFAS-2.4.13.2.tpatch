{
  "format": "tarefas-tpatch-v1",
  "id": "2.4.13.2",
  "name": "TAREFAS 2.4.13.2 — Calendário com lembretes independentes",
  "patchVersion": 1,
  "createdAt": "2026-10-07T14:13:00Z",
  "baseVersion": "2.4.13",
  "minBuild": 300,
  "maxBuild": 300,

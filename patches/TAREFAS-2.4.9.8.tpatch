    "js": "(()=>{'use strict';const MARK='__TAREFAS_2498_PATCH__';if(globalThis[MARK])return;globalThis[MARK]=true;const U='';const openNotes=()=>{document.getElementById('t984NotesOverlay')?.remove();document.body.insertAdjacentHTML('beforeend',\"<div class=\\\"t984-overlay\\\" id=\\\"t984NotesOverlay\\\"><section class=\\\"t984-page\\\"><header class=\\\"t984-top\\\"><div><h2>Orçamentários · Notas Fiscais</h2><p>Empresas de origem, notas fiscais, depósito de destino e andamento orçamentário.</p></div><button class=\\\"t984-close\\\" id=\\\"t984Close\\\" aria-label=\\\"Fechar\\\">×</button></header><div class=\\\"nf-hero\\\"><h3>Notas Fiscais</h3><p>Cadastre a empresa uma vez e selecione-a na origem de cada nota. O destino é um depósito já cadastrado no Orçamentários.</p></div><div class=\\\"nf-layout\\\"><section class=\\\"nf-panel\\\"><div class=\\\"nf-head\\\"><div><h3>Empresas</h3><span id=\\\"nfCompanyCount\\\">0 empresa(s)</span></div><div class=\\\"nf-actions\\\"><button class=\\\"orc-btn primary\\\" id=\\\"btnNovaEmpresa\\\">＋ Empresa</button></div></div><div class=\\\"nf-body\\\"><input class=\\\"nf-search\\\" id=\\\"nfCompanySearch\\\" placeholder=\\\"Buscar empresa...\\\"><div class=\\\"nf-company-list\\\" id=\\\"nfCompanyList\\\"><div class=\\\"nf-empty\\\">Carregando...</div></div></div></section><section class=\\\"nf-panel\\\"><div class=\\\"nf-head\\\"><div><h3>Notas Fiscais</h3><span id=\\\"nfListInfo\\\">0 nota(s)</span></div><div class=\\\"nf-actions\\\"><button class=\\\"orc-btn primary\\\" id=\\\"btnNovaNF\\\">＋ Nota Fiscal</button></div></div><div class=\\\"nf-body\\\"><div class=\\\"nf-filters\\\"><input class=\\\"nf-search\\\" id=\\\"nfSearch\\\" placeholder=\\\"Buscar nº, empresa ou depósito...\\\"><select class=\\\"nf-select\\\" id=\\\"nfStatus\\\"><option value=\\\"\\\">Todos os andamentos</option></select><select class=\\\"nf-select\\\" id=\\\"nfNDFiltro\\\"><option value=\\\"\\\">Todas as ND</option><option value=\\\"30\\\">Material Consumo ND 30</option><option value=\\\"32\\\">Uso duradouro ND 32</option><option value=\\\"52\\\">Permanente ND 52</option></select></div><div class=\\\"nf-note-list\\\" id=\\\"nfList\\\"><div class=\\\"nf-empty\\\">Carregando...</div></div></div></section></div><section class=\\\"nf-panel\\\" id=\\\"nfDetailPanel\\\" style=\\\"margin-top:12px\\\"><div class=\\\"nf-detail\\\" id=\\\"nfDetail\\\"><div class=\\\"nf-empty\\\">Selecione uma Nota Fiscal para visualizar os dados.</div></div></section><div class=\\\"nf-modal\\\" id=\\\"empresaModal\\\"><div class=\\\"nf-modal-card\\\"><div class=\\\"nf-modal-head\\\"><h3>Nova empresa</h3><button class=\\\"nf-close\\\" id=\\\"closeEmpresa\\\">×</button></div><form class=\\\"nf-form\\\" id=\\\"empresaForm\\\"><div class=\\\"nf-field full\\\"><label>Empresa *</label><input class=\\\"nf-input\\\" id=\\\"empresaNome\\\" required maxlength=\\\"160\\\" placeholder=\\\"Nome / razão social\\\"></div><div class=\\\"nf-field\\\"><label>CNPJ (opcional)</label><input class=\\\"nf-input\\\" id=\\\"empresaCnpj\\\" inputmode=\\\"numeric\\\" maxlength=\\\"18\\\" placeholder=\\\"Somente números\\\"></div><div class=\\\"nf-form-actions\\\"><button type=\\\"button\\\" class=\\\"orc-btn\\\" id=\\\"cancelEmpresa\\\">Cancelar</button><button type=\\\"submit\\\" class=\\\"orc-btn primary\\\">Cadastrar empresa</button></div></form></div></div><div class=\\\"nf-modal\\\" id=\\\"nfModal\\\"><div class=\\\"nf-modal-card\\\"><div class=\\\"nf-modal-head\\\"><h3>Nova Nota Fiscal</h3><button class=\\\"nf-close\\\" id=\\\"closeNF\\\">×</button></div><form class=\\\"nf-form\\\" id=\\\"nfForm\\\"><div class=\\\"nf-field\\\"><label>Nº da Nota Fiscal *</label><input class=\\\"nf-input\\\" id=\\\"nfNumero\\\" required maxlength=\\\"60\\\" placeholder=\\\"Ex.: 000123\\\"></div><div class=\\\"nf-field\\\"><label>Valor total *</label><input class=\\\"nf-input\\\" id=\\\"nfValor\\\" required type=\\\"number\\\" min=\\\"0\\\" step=\\\"0.01\\\" placeholder=\\\"0,00\\\"></div><div class=\\\"nf-field\\\"><label>Empresa na origem *</label><select class=\\\"nf-select\\\" id=\\\"nfEmpresa\\\" required></select></div><div class=\\\"nf-field\\\"><label>Depósito no destino *</label><select class=\\\"nf-select\\\" id=\\\"nfDeposito\\\" required></select></div><div class=\\\"nf-field full\\\"><label>Classificação do material *</label><select class=\\\"nf-select\\\" id=\\\"nfND\\\" required><option value=\\\"\\\">Selecione...</option><option value=\\\"30\\\">Material Consumo ND 30</option><option value=\\\"32\\\">Uso duradouro ND 32</option><option value=\\\"52\\\">Permanente ND 52</option></select></div><div class=\\\"nf-form-actions\\\"><button type=\\\"button\\\" class=\\\"orc-btn\\\" id=\\\"cancelNF\\\">Cancelar</button><button type=\\\"submit\\\" class=\\\"orc-btn primary\\\">Cadastrar Nota Fiscal</button></div></form></div></div></section></div>\");const st=document.createElement('style');st.id='t984NotesStyle';st.textContent=\".t984-overlay{position:fixed;inset:0;z-index:2147483000;background:var(--v4-bg,#07100f);color:var(--v4-text,#fff);overflow:auto}.t984-page{padding:12px 12px 28px;max-width:1100px;margin:0 auto}.t984-top{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 2px 14px}.t984-top h2{font-size:17px;margin:0}.t984-top p{font-size:9px;color:var(--v4-muted);margin:4px 0 0}.t984-close{border:0;background:transparent;color:inherit;font-size:28px;line-height:1;padding:4px 8px}.nf-layout{display:grid;grid-template-columns:minmax(220px,.42fr) minmax(0,1.58fr);gap:12px}.nf-panel{background:var(--v4-surface);border:1px solid var(--v4-border);border-radius:12px;min-width:0}.nf-head{padding:13px 14px;border-bottom:1px solid var(--v4-border);display:flex;align-items:center;justify-content:space-between;gap:10px}.nf-head h3{font-size:12px;margin:0}.nf-head span{font-size:9px;color:var(--v4-muted)}.nf-body{padding:12px}.nf-actions{display:flex;gap:7px;flex-wrap:wrap}.nf-search{width:100%;box-sizing:b
ion{margin-top:12px;padding-top:12px;border-top:1px solid var(--v4-border)}.nf-flow{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}.nf-step{padding:9px 7px;border-radius:8px;border:1px solid var(--v4-border);background:var(--v4-surface-2);font-size:8px;text-align:center;line-height:1.3}.nf-step.current{border-color:var(--v4-accent);background:var(--v4-accent-soft);color:var(--v4-accent);font-weight:800}.nf-step.done{border-color:var(--v4-success,#16a34a);color:var(--v4-success,#16a34a)}.nf-actions-bar{display:flex;gap:7px;align-items:center;flex-wrap:wrap}.nf-empty{text-align:center;padding:35px 10px;color:var(--v4-muted);font-size:10px}.nf-history-item{padding:8px 0;border-bottom:1px solid var(--v4-border)}.nf-history-item:last-child{border-bottom:0}.nf-history-item strong{font-size:9px}.nf-history-item p{margin:3px 0;font-size:8px;color:var(--v4-text-2)}.nf-history-item small{font-size:7px;color:var(--v4-muted)}.nf-modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.65);align-items:center;justify-content:center;z-index:2147483005}.nf-modal.open{display:flex}.nf-modal-card{width:min(620px,94vw);max-height:90vh;overflow:auto;background:var(--v4-surface);border:1px solid var(--v4-border);border-radius:14px}.nf-modal-head{padding:13px 15px;border-bottom:1px solid var(--v4-border);display:flex;justify-content:space-between;align-items:center}.nf-modal-head h3{font-size:13px}.nf-close{border:0;background:transparent;color:var(--v4-text);font-size:22px}.nf-form{padding:15px;display:grid;grid-template-columns:1fr 1fr;gap:9px}.nf-field.full{grid-column:1/-1}.nf-field label{display:block;font-size:8px;font-weight:800;margin-bottom:5px;color:var(--v4-text-2)}.nf-form-actions{grid-column:1/-1;display:flex;justify-content:flex-end;gap:7px;padding-top:5px}.nf-note-list,.nf-company-list{max-height:430px;overflow:auto}.nf-hero{background:var(--v4-surface);border:1px solid var(--v4-border);border-radius:12px;padding:14px;margin-bottom:12px}.nf-hero h3{font-size:14px;margin:0}.nf-hero p{font-size:9px;color:var(--v4-muted);margin-top:4px}@media(max-width:850px){.nf-layout{grid-template-columns:1fr}.nf-filters{grid-template-columns:1fr}.nf-flow{grid-template-columns:1fr 1fr}}@media(max-width:650px){.t984-page{padding:8px 9px 24px}.nf-detail-grid,.nf-form{grid-template-columns:1fr}.nf-field.full{grid-column:auto}.nf-filters{grid-template-columns:1fr}}\";document.head.appendChild(st);document.getElementById('t984Close').onclick=()=>{document.getElementById('t984NotesOverlay')?.remove();document.getElementById('t984NotesStyle')?.remove()};if(!window.__TAREFAS_NF_CLIENT__){try{window.__TAREFAS_NF_CLIENT__=supabaseClient}catch(_){}}if(!window.__TAREFAS_NF_CLIENT__){alert('Não foi possível abrir Notas Fiscais: conexão do Supabase indisponível.');return}document.getElementById('tmDrawer')?.remove()};const installMenu=()=>{const d=document.getElementById('tmDrawer');if(!d||d.querySelector('[data-t984-notas]'))return;const g=d.querySelector('[data-href=\"orcamentarios.html?modulo=guias\"]');if(!g)return;const b=document.createElement('button');b.className=g.className;b.dataset.t984Notas='1';b.innerHTML='<span><strong>Notas Fiscais</strong><small>Notas, empresas e andamento orçamentário</small></span><span aria-hidden=\"true\">›</span>';b.addEventListener('click',e=>{e.preventDefault();e.stopPropagation();openNotes()},{capture:true});g.insertAdjacentElement('afterend',b)};document.addEventListener('click',e=>{if(e.target.closest?.('[data-menu]'))setTimeout(installMenu,0)},{capture:true});setTimeout(installMenu,0);})();",

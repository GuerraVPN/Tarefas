  "payload": {
    "js": ";(()=>{const M='__TAREFAS_ALPHA_2419_HIDE_SUPERSEDED__';try{if(globalThis.__tm2419Observer){globalThis.__tm2419Observer.disconnect();globalThis.__tm2419Observer=null}}catch(_){}document.querySelectorAll('.tm-patch-empty').forEach(e=>{if(e.textContent==='Nenhum patch oficial novo para esta Beta.')e.remove()});globalThis[M]=null})();",

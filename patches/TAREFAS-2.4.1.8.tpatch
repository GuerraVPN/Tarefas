  "description": "Corrige o menu móvel para remover definitivamente Pessoal / Escalas e Missões e deixar apenas Escalas, com as três planilhas oficiais.",
  "changelog": [
    "Remove Pessoal / Escalas do menu móvel.",
    "Remove Missões do menu móvel.",
    "Adiciona somente Escalas em Serviços e pessoal.",
    "Escalas abre Motorista, Patrulheiro e Permanência.",
    "Mantém as três URLs oficiais das planilhas.",
    "Não altera a navegação base do app e não usa observador recursivo."
  ],
  "order": 241108,
  "payload": {
    "js": "(()=>{\n'use strict';\n\nconst PATCH_VERSION='2.4.1.7';\nconst BASE_VERSION='2.4.1';\nconst BASE_BUILD=276;\nconst WEB_VERSION='7.9.1';\nconst MARK='__TAREFAS_ALPHA_2417_BIOMETRIC_HANDOFF__';\nconst SYNC_KEY='tarefas2417VersionSyncAt';\nconst SITE_EXIT_KEY='tarefas_site_791_exit_seen';\nconst SITE_RESTART_KEY='tarefas_site_791_restart_seen';\nconst SESSION_KEY='tarefasPushSession17';\nconst USER_KEY='usuarioLogado';\nconst PROCESS_SESSION_KEY='tarefasSecureProcessSessionV1';\nconst SECURE_UNLOCK_KEY='tarefasSecureUnlocked23249';\nconst SECURE_LOCK_KEY='tarefasSecureLockRequired23249';\n\nif(globalThis[MARK])return;\nglobalThis[MARK]=true;\n\nglobalThis.__TAREFAS_EFFECTIVE_VERSION__=PATCH_VERSION;\nglobalThis.__TAREFAS_WEB_BASE_VERSION__=WEB_VERSION;\ndocument.documentElement.dataset.tarefasEffectiveVersion=PATCH_VERSION;\ndocument.documentElement.dataset.tarefasWebVersion=WEB_VERSION;\n\nconst page=()=>String(location.pathname.split('/').pop()||'index.html').toLowerCase();\nconst isLoginPage=()=>page()==='index.html'||page()==='';\nconst getClient=()=>{try{return typeof supabaseClient!=='undefined'?supabaseClient:null}catch(_){return null}};\nconst sessionToken=()=>String(localStorage.getItem(SESSION_KEY)||'').trim();\nconst currentUser=()=>{try{return JSON.parse(localStorage.getItem(USER_KEY)||'null')}catch(_){return null}};\n\nfunction applyLabels(){\n  try{\n    document.querySelectorAll('.tm-app-brand small').forEach(el=>{\n      const wanted=PATCH_VERSION+' • WEB '+WEB_VERSION;\n      if(el.textContent.trim()!==wanted)el.textContent=wanted;\n    });\n    document.querySelectorAll('[data-tarefas-version],[data-app-version],.tm-about-version').forEach(el=>{\n      const text=String(el.textContent||'');\n      if(!text||text.length>160)return;\n      const next=text\n        .replace(/\\b2\\.4\\.1(?:\\.[123])?\\b/g,PATCH_VERSION)\n        .replace(/\\b2\\.3\\.222\\.1\\b/g,BASE_VERSION);\n      if(next!==text)el.textContent=next;\n    });\n  }catch(_){}\n}\n\nfunction markFreshAuthentication(){\n  if(!isLoginPage())return false;\n  const token=sessionToken();\n  const user=currentUser();\n  if(token.length<32||!user?.id)return false;\n  try{\n    sessionStorage.setItem(PROCESS_SESSION_KEY,'1');\n    sessionStorage.setItem(SECURE_UNLOCK_KEY,'1');\n    sessionStorage.removeItem(SECURE_LOCK_KEY);\n    sessionStorage.setItem('tarefasFreshAuth2417',String(Date.now()));\n  }catch(_){}\n  window.dispatchEvent(new CustomEvent('tarefas:secure-unlocked',{detail:{version:PATCH_VERSION,source:'login-handoff',at:Date.now()}}));\n  return true;\n}\n\nfunction installLoginHandoff(){\n  if(!isLoginPage()||globalThis.__TAREFAS_LOGIN_HANDOFF_2417__)return;\n  globalThis.__TAREFAS_LOGIN_HANDOFF_2417__=true;\n  const nativeSet=Storage.prototype.setItem;\n  Storage.prototype.setItem=function(key,value){\n    const result=nativeSet.call(this,key,value);\n    try{\n      if(this===localStorage&&(String(key)===SESSION_KEY||String(key)===USER_KEY)){\n        queueMicrotask(markFreshAuthentication);\n      }\n    }catch(_){}\n    return result;\n  };\n}\n\nlet syncing=null;\nasync function syncRegisteredVersion({force=false}={}){\n  if(syncing)return syncing;\n  syncing=(async()=>{\n    const token=sessionToken();\n    const client=getClient();\n    if(!token||token.length<32||!client)return false;\n    if(!force){\n      const last=Number(localStorage.getItem(SYNC_KEY)||0);\n      if(last&&Date.now()-last<5*60*1000)return true;\n    }\n    const {data,error}=await client.rpc('v2_4_1_1_sync_app_version',{p_session_token:token,p_app_version:BASE_VERSION});\n    if(error)throw error;\n    if(data!==true)return false;\n    localStorage.setItem(SYNC_KEY,String(Date.now()));\n    window.dispatchEvent(new CustomEvent('tarefas:app-version-synced',{detail:{baseVersion:BASE_VERSION,effectiveVersion:PATCH_VERSION,build:BASE_BUILD}}));\n    window.dispatchEvent(new CustomEvent('v6:notificacoes:update'));\n    return true;\n  })().catch(err=>{\n    console.warn('[TAREFAS 2.4.1.7] Falha ao sincronizar versão do aparelho:',err?.message||err);\n    return false;\n  }).finally(()=>{syncing=null});\n  return syncing;\n}\n\nasync function seedSiteControlTokens(){\n  try{\n    const panel=globalThis.SitePanel791;\n    if(!panel)return false;\n    let state=panel.state?.()||null;\n    if(!state&&panel.refresh){try{await panel.refresh()}catch(_){}state=panel.state?.()||null}\n    if(!state)return false;\n    if(localStorage.getItem(SITE_EXIT_KEY)===null&&state.acao_pendente!=='exit_users')localStorage.setItem(SITE_EXIT_KEY,String(Number(state.exit_token||0)));\n    if(localStorage.getItem(SITE_RESTART_KEY)===null&&state.acao_pendente!=='reiniciar')localStorage.setItem(SITE_RESTART_KEY,String(Number(state.restart_token||0)));\n    return true;\n  }catch(err){\n    console.warn('[TAREFAS 2.4.1.7] Falha ao criar baseline do Painel SITE:',err?.message||err);\n    return false;\n  }\n}\n\nlet baselineTimer=null;\nlet baselineAttempts=0;\nfunction ensureSiteBaseline(){\n  if(baselineTimer)return;\n  baselineAttempts=0;\n  const tick=async()=>{\n    baselineAttempts++;\n    const ok=await seedSiteControlTokens();\n    if(ok||baselineAttempts>=20){clearInterval(baselineTimer);baselineTimer=null}\n  };\n  tick();\n  baselineTimer=setInterval(tick,500);\n}\n\nfunction scheduleSync(force=false){setTimeout(()=>syncRegisteredVersion({force}),250)}\n\ninstallLoginHandoff();\napplyLabels();\nensureSiteBaseline();\nscheduleSync(true);\n\nwindow.addEventListener('pageshow',()=>{applyLabels();ensureSiteBaseline();scheduleSync(false)});\nwindow.addEventListener('focus',()=>{applyLabels();ensureSiteBaseline();scheduleSync(false)});\nwindow.addEventListener('tarefas:push-session-ready',()=>{markFreshAuthentication();ensureSiteBaseline();scheduleSync(true)});\nwindow.addEventListener('tarefas:push-status',event=>{if(event?.detail?.ready===true){ensureSiteBaseline();scheduleSync(true)}});\ndocument.addEventListener('visibilitychange',()=>{if(!document.hidden){applyLabels();ensureSiteBaseline();scheduleSync(false)}});\n\nconst observer=new MutationObserver(records=>{\n  for(const record of records){\n    for(const node of record.addedNodes){\n      if(node.nodeType!==1)continue;\n      if(node.matches?.('.tm-app-brand,.tm-about-version,[data-tarefas-version],[data-app-version]')||node.querySelector?.('.tm-app-brand,.tm-about-version,[data-tarefas-version],[data-app-version]')){queueMicrotask(applyLabels);return}\n    }\n  }\n});\nobserver.observe(document.body,{childList:true,subtree:true});\n\nglobalThis.TarefasAlpha2417=Object.freeze({\n  patchVersion:PATCH_VERSION,\n  baseVersion:BASE_VERSION,\n  build:BASE_BUILD,\n  webVersion:WEB_VERSION,\n  markFreshAuthentication,\n  sync:()=>syncRegisteredVersion({force:true}),\n  baselineSite:seedSiteControlTokens,\n  refresh:applyLabels\n});\n})();\n;(()=>{\n'use strict';\nconst MARK='__TAREFAS_ALPHA_2417_EXTERNAL_SCALES__';\nif(globalThis[MARK])return;globalThis[MARK]=true;\nconst VERSION='2.4.1.7';\nconst LINKS=Object.freeze([\n{id:'motorista',label:'Escala de motorista',url:'https://docs.google.com/spreadsheets/d/1T_BM9KY0NLwVhlifetQ6W6AdetujQjx--zOZHa27eQs/edit?usp=drivesdk',icon:'🚙'},\n{id:'patrulheiro',label:'Escala de patrulheiro',url:'https://docs.google.com/spreadsheets/d/1_LlfIHx4EuSHkC9BOR2VorvXoaiMyLa028wU6C0dQLs/edit?usp=drivesdk',icon:'🛡️'},\n{id:'permanencia',label:'Escala de permanência',url:'https://docs.google.com/spreadsheets/d/13eEei_JdGjAdVo371BGfPS59QdYySe9lJ47DLjWb_x0/edit?usp=drivesdk',icon:'🏢'}\n]);\nconst page=()=>String(location.pathname.split('/').pop()||'').toLowerCase();\nfunction ensureCss(){\n if(document.getElementById('tmExternalScalesCss2415'))return;\n const s=document.createElement('style');s.id='tmExternalScalesCss2415';\n s.textContent='.v7-pessoal-sub a[data-v2415-scale]{display:flex!important;align-items:center;justify-content:space-between;gap:8px}.v7-pessoal-sub a[data-v2415-scale]::after{content:\"↗\";font-size:11px;opacity:.68}body.tm2415-legacy-scale .v7-page{display:none!important}body.tm2415-legacy-scale .v7-modal-bg{display:none!important}.tm2415-scales-page{padding:18px;max-width:1050px;margin:0 auto}.tm2415-scales-head{margin-bottom:16px}.tm2415-scales-head h2{margin:0 0 6px;font-size:22px}.tm2415-scales-head p{margin:0;color:var(--v4-muted,#64748b);font-size:12px;line-height:1.5}.tm2415-scales-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.tm2415-scale-card{display:flex;align-items:center;gap:12px;min-height:88px;padding:15px;border:1px solid var(--v4-border,#d7dce3);border-radius:15px;background:var(--v4-surface,#fff);color:var(--v4-text,#111827);text-decoration:none;box-shadow:0 5px 18px rgba(15,23,42,.07)}.tm2415-scale-card:hover{transform:translateY(-1px);border-color:var(--v4-accent,#2563eb)}.tm2415-scale-icon{width:48px;height:48px;display:grid;place-items:center;flex:0 0 auto;border-radius:13px;background:var(--v4-surface-3,#eef2f7);font-size:23px}.tm2415-scale-copy{min-width:0;flex:1}.tm2415-scale-copy strong{display:block;font-size:14px}.tm2415-scale-copy small{display:block;margin-top:4px;color:var(--v4-muted,#64748b);font-size:10px}.tm2415-scale-arrow{font-size:18px;opacity:.55}.tm2415-scales-note{margin-top:13px;padding:11px 12px;border:1px solid var(--v4-border,#d7dce3);border-radius:11px;background:var(--v4-surface-2,#f8fafc);font-size:10px;line-height:1.5;color:var(--v4-muted,#64748b)}@media(max-width:760px){.tm2415-scales-grid{grid-template-columns:1fr}.tm2415-scales-page{padding:13px}}';\n document.head.appendChild(s);\n}\nfunction makeScaleLink(row,className){\n const a=document.createElement('a');a.href=row.url;a.target='_blank';a.rel='noopener noreferrer external';a.className=className||'';a.dataset.v2415Scale=row.id;a.dataset.externalScale='1';return a;\n}\nfunction rewritePessoalNav(){return true}\nfunction renderLegacyScalePage(){\n const p=page();if(p!=='pessoal.html'&&p!=='missao.html')return false;if(document.getElementById('tmExternalScalesPage2415'))return true;\n const main=document.querySelector('.v7-main')||document.querySelector('main');if(!main)return false;ensureCss();document.body.classList.add('tm2415-legacy-scale');\n const header=main.querySelector('.v7-top b,.topbar b');if(header)header.textContent='Pessoal · Escalas';\n const host=document.createElement('section');host.id='tmExternalScalesPage2415';host.className='tm2415-scales-page';\n host.innerHTML='<div class=\"tm2415-scales-head\"><h2>Escalas</h2><p>As escalas de serviço e missão internas foram substituídas pelas planilhas oficiais abaixo.</p></div><div class=\"tm2415-scales-grid\"></div><div class=\"tm2415-scales-note\">Os links abrem as planilhas no Google Planilhas/Google Drive. Férias, dispensas e usuários continuam disponíveis no menu Pessoal.</div>';\n const grid=host.querySelector('.tm2415-scales-grid');\n for(const row of LINKS){const a=makeScaleLink(row,'tm2415-scale-card');a.innerHTML='<span class=\"tm2415-scale-icon\">'+row.icon+'</span><span class=\"tm2415-scale-copy\"><strong>'+row.label+'</strong><small>Abrir planilha oficial</small></span><span class=\"tm2415-scale-arrow\">↗</span>';grid.appendChild(a)}\n const oldPage=main.querySelector('.v7-page');if(oldPage)main.insertBefore(host,oldPage);else main.appendChild(host);return true;\n}\nlet scheduled=false;\nfunction refresh(){ensureCss();rewritePessoalNav();renderLegacyScalePage()}\nfunction schedule(){if(scheduled)return;scheduled=true;queueMicrotask(()=>{scheduled=false;refresh()})}\nrefresh();\nif(document.readyState==='loading')document.addEventListener('DOMContentLoaded',refresh,{once:true});\nwindow.addEventListener('pageshow',refresh);\nnew MutationObserver(mutations=>{for(const m of mutations){if(m.type!=='childList')continue;for(const node of [...m.addedNodes,...m.removedNodes]){if(!(node instanceof Element))continue;if(node.matches?.('.v7-pessoal-parent,.v7-pessoal-sub,.v7-main,.v7-page')||node.querySelector?.('.v7-pessoal-parent,.v7-pessoal-sub,.v7-main,.v7-page')){schedule();return}}}}).observe(document.documentElement,{childList:true,subtree:true});\nglobalThis.TarefasExternalScales2417=Object.freeze({version:VERSION,links:LINKS.map(x=>({...x})),refresh});\n})();\n;(()=>{\n'use strict';\nconst MARK='__TAREFAS_ALPHA_2417_SCALES_NAV_FIX__';\nif(globalThis[MARK])return;globalThis[MARK]=true;\nconst VERSION='2.4.1.7';\nconst LINKS=[\n{id:'motorista',label:'Motorista',url:'https://docs.google.com/spreadsheets/d/1T_BM9KY0NLwVhlifetQ6W6AdetujQjx--zOZHa27eQs/edit?usp=drivesdk'},\n{id:'patrulheiro',label:'Patrulheiro',url:'https://docs.google.com/spreadsheets/d/1_LlfIHx4EuSHkC9BOR2VorvXoaiMyLa028wU6C0dQLs/edit?usp=drivesdk'},\n{id:'permanencia',label:'Permanência',url:'https://docs.google.com/spreadsheets/d/13eEei_JdGjAdVo371BGfPS59QdYySe9lJ47DLjWb_x0/edit?usp=drivesdk'}\n];\nfunction ensureCss(){\n if(document.getElementById('tmScalesNavCss2417'))return;\n const s=document.createElement('style');s.id='tmScalesNavCss2417';\n s.textContent='.v2417-scales-parent{position:relative}.v2417-scales-sub{display:none;padding:4px 7px 9px 30px}.v2417-scales-parent.v62-subopen .v2417-scales-sub{display:grid}.v2417-scales-sub a{display:flex;align-items:center;justify-content:space-between;gap:8px;text-decoration:none;border:0;background:transparent;color:var(--v4-sidebar-text);border-radius:7px;padding:7px 8px;text-align:left;font-size:9px}.v2417-scales-sub a:hover{background:var(--v4-sidebar-hover);color:var(--v4-gold)}.v2417-scales-sub a::after{content:\"↗\";font-size:11px;opacity:.68}.v2417-scales-parent .v6-orc-arrow{transition:transform .15s}.v2417-scales-parent.v62-subopen .v6-orc-arrow{transform:rotate(180deg)}@media(min-width:901px){.v2417-scales-parent:hover .v2417-scales-sub{display:grid}}@media(max-width:900px){.v2417-scales-parent>.v6-orc-main{min-height:48px;padding:12px 11px!important}.v2417-scales-sub a{min-height:42px;padding:10px 11px!important;font-size:11px!important}}';\n document.head.appendChild(s);\n}\nfunction icon(){return '<svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M16 3v4M8 3v4M3 10h18\"/></svg>'}\nfunction arrow(){return '<svg viewBox=\"0 0 24 24\"><path d=\"m8 10 4 4 4-4\"/></svg>'}\nfunction removeOldEntries(){\n const pessoal=document.querySelector('.v7-pessoal-parent');\n if(pessoal){\n  pessoal.querySelectorAll('[data-v2415-scale],[data-v7-link=\"escala\"],[data-v7-link=\"missao\"],a[href=\"missao.html\"],a[href=\"pessoal.html\"]').forEach(a=>{\n   if(a.matches('[data-v7-main]'))return;\n   const t=(a.textContent||'').trim().toLowerCase();\n   if(t.includes('escala')||t.includes('miss'))a.remove();\n  });\n }\n document.querySelectorAll('.sidebar a[href=\"missao.html\"]').forEach(a=>a.closest('li')?.remove()||a.remove());\n}\nfunction ensureNav(){\n ensureCss();removeOldEntries();\n const list=document.querySelector('.sidebar ul');if(!list)return false;\n let li=list.querySelector('.v2417-scales-parent');\n if(!li){\n  li=document.createElement('li');li.className='v6-orc-parent v2417-scales-parent';\n  li.innerHTML='<a class=\"v6-orc-main\" href=\"#\" data-v2417-main aria-expanded=\"false\"><span class=\"v6-nav-icon\">'+icon()+'</span><span class=\"v6-nav-label\">Escalas</span><span class=\"v6-orc-arrow\">'+arrow()+'</span></a><div class=\"v2417-scales-sub\"></div>';\n  const pessoal=list.querySelector('.v7-pessoal-parent');if(pessoal)list.insertBefore(li,pessoal);else list.appendChild(li);\n }\n const sub=li.querySelector('.v2417-scales-sub');\n if(sub&&!sub.dataset.ready){\n  for(const row of LINKS){const a=document.createElement('a');a.href=row.url;a.target='_blank';a.rel='noopener noreferrer external';a.textContent=row.label;a.dataset.v2417Scale=row.id;sub.appendChild(a)}\n  sub.dataset.ready='1';\n }\n const main=li.querySelector('[data-v2417-main]');\n if(main&&!main.dataset.wired){\n  main.dataset.wired='1';\n  main.addEventListener('click',e=>{e.preventDefault();e.stopPropagation();li.classList.toggle('v62-subopen');main.setAttribute('aria-expanded',li.classList.contains('v62-subopen')?'true':'false')},true);\n }\n return true;\n}\nfunction updateLegacyPage(){\n const pg=String(location.pathname.split('/').pop()||'').toLowerCase();\n if(pg!=='pessoal.html'&&pg!=='missao.html')return;\n document.querySelectorAll('.v7-top b,.topbar b').forEach(x=>{if(x.textContent!=='Escalas')x.textContent='Escalas'});\n const box=document.getElementById('tmExternalScalesPage2415');\n if(box){const h=box.querySelector('.tm2415-scales-head h2');if(h&&h.textContent!=='Escalas')h.textContent='Escalas';const d=box.querySelector('.tm2415-scales-head p');const wanted='Acesse as planilhas oficiais de Motorista, Patrulheiro e Permanência.';if(d&&d.textContent!==wanted)d.textContent=wanted}\n}\nlet tries=0,timer=null;\nfunction boot(){\n tries++;const ok=ensureNav();updateLegacyPage();\n if(ok||tries>=80){if(timer){clearInterval(timer);timer=null}}\n}\nboot();\nif(!document.querySelector('.sidebar ul'))timer=setInterval(boot,125);\nwindow.addEventListener('pageshow',()=>{tries=0;if(!ensureNav()){if(timer)clearInterval(timer);timer=setInterval(boot,125)}updateLegacyPage()});\nglobalThis.TarefasScalesNav2417=Object.freeze({version:VERSION,links:LINKS.map(x=>({...x})),refresh:()=>{ensureNav();updateLegacyPage()}});\n})();\n;(()=>{ \n'use strict';\nconst MARK='__TAREFAS_ALPHA_2418_DRAWER_SCALES_FIX__';\nif(globalThis[MARK])return;globalThis[MARK]=true;\nconst LINKS=[\n {label:'Escala de motorista',url:'https://docs.google.com/spreadsheets/d/1T_BM9KY0NLwVhlifetQ6W6AdetujQjx--zOZHa27eQs/edit?usp=drivesdk'},\n {label:'Escala de patrulheiro',url:'https://docs.google.com/spreadsheets/d/1_LlfIHx4EuSHkC9BOR2VorvXoaiMyLa028wU6C0dQLs/edit?usp=drivesdk'},\n {label:'Escala de permanência',url:'https://docs.google.com/spreadsheets/d/13eEei_JdGjAdVo371BGfPS59QdYySe9lJ47DLjWb_x0/edit?usp=drivesdk'}\n];\nfunction openScales(){\n const old=document.getElementById('tm2418ScalesSheet');if(old)old.remove();\n const wrap=document.createElement('div');wrap.id='tm2418ScalesSheet';wrap.className='tm-sheet-wrap';\n wrap.innerHTML='<div class=\"tm-sheet-backdrop\" data-close></div><section class=\"tm-sheet\" role=\"dialog\" aria-modal=\"true\"><header><h2>Escalas</h2><button class=\"tm-icon\" data-close aria-label=\"Fechar\">×</button></header><div class=\"tm-sheet-body\"><div class=\"tm2418-scale-list\"></div></div></section>';\n wrap.querySelectorAll('[data-close]').forEach(b=>b.addEventListener('click',()=>wrap.remove()));\n const list=wrap.querySelector('.tm2418-scale-list');\n LINKS.forEach(x=>{const a=document.createElement('a');a.href=x.url;a.target='_blank';a.rel='noopener noreferrer external';a.textContent=x.label;a.style.cssText='display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 4px;border-bottom:1px solid rgba(127,127,127,.18);color:inherit;text-decoration:none;font-weight:600';const s=document.createElement('span');s.textContent='↗';s.style.opacity='.6';a.appendChild(s);list.appendChild(a)});\n document.body.appendChild(wrap);requestAnimationFrame(()=>wrap.classList.add('open'));\n}\nfunction cleanDrawer(drawer){\n const body=drawer.querySelector('.tm-sheet-body');if(!body)return;\n body.querySelectorAll('.tm-drawer-item[data-href]').forEach(btn=>{\n   const href=String(btn.getAttribute('data-href')||'').toLowerCase();\n   const label=String(btn.querySelector('strong')?.textContent||btn.textContent||'').trim().toLowerCase();\n   if(href==='missao.html'||href==='pessoal.html'||label==='missões'||label==='pessoal / escalas')btn.remove();\n });\n const groups=[...body.querySelectorAll('.tm-drawer-group')];\n let service=groups.find(g=>(g.querySelector('h3')?.textContent||'').trim().toLowerCase()==='serviços e pessoal');\n if(!service)return;\n let item=[...service.querySelectorAll('.tm-drawer-item')].find(b=>b.dataset.t2418Scales==='1');\n if(!item){\n   item=document.createElement('button');item.type='button';item.className='tm-drawer-item';item.dataset.t2418Scales='1';\n   item.innerHTML='<span><strong>Escalas</strong><small>Motorista, patrulheiro e permanência</small></span><span aria-hidden=\"true\">›</span>';\n   item.addEventListener('click',()=>{drawer.remove();openScales()});\n   const ferias=[...service.querySelectorAll('.tm-drawer-item')].find(b=>String(b.dataset.href||'').toLowerCase()==='ferias_dispensas.html');\n   service.insertBefore(item,ferias||null);\n }\n}\nfunction watch(){\n const body=document.body;if(!body)return;\n const existing=document.getElementById('tmDrawer');if(existing)cleanDrawer(existing);\n if(globalThis.__tm2418DrawerObserver)return;\n const mo=new MutationObserver(ms=>{for(const m of ms)for(const n of m.addedNodes){if(n instanceof Element&&n.id==='tmDrawer'){cleanDrawer(n);return}}});\n mo.observe(body,{childList:true,subtree:false});globalThis.__tm2418DrawerObserver=mo;\n}\nif(document.readyState==='loading')document.addEventListener('DOMContentLoaded',watch,{once:true});else watch();\n})();",

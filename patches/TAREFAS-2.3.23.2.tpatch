{
  "format": "tarefas-tpatch-v1",
  "id": "2.3.23.2",
  "name": "TAREFAS 2.3.23.2 — Tema e versão",
  "patchVersion": 1,
  "createdAt": "2026-09-21T13:18:00Z",
  "baseVersion": "2.3.23.1",
  "minBuild": 270,
  "maxBuild": 270,
  "description": "Corrige a troca inesperada para o tema claro e atualiza os rótulos visíveis de versão que ainda exibiam 2.3.22/2.3.23.1.",
  "changelog": [
    "Mantém como prioridade o tema escolhido localmente pelo usuário.",
    "Evita que uma preferência remota antiga force o tema claro ao abrir ou voltar para o app.",
    "Continua permitindo trocar o tema manualmente nas Configurações.",
    "Corrige o cabeçalho para exibir 2.3.23.2 em vez de 2.3.22.",
    "Atualiza os rótulos principais da tela Sobre para a versão efetiva 2.3.23.2."
  ],
  "order": 23232,
  "payload": {
    "js": "(()=>{\n'use strict';\n\nconst PATCH_VERSION='2.3.23.2';\nconst BASE_VERSION='2.3.23.1';\nconst BUILD=270;\nconst WEB_VERSION='7.8.2';\nconst MARK='__TAREFAS_PATCH_23232__';\nconst PIN_KEY='tarefasPatchTheme23232';\nconst VALID=new Set(['light','dark','night','military']);\n\nif(globalThis[MARK])return;\nglobalThis[MARK]=true;\nglobalThis.__TAREFAS_EFFECTIVE_VERSION__=PATCH_VERSION;\n\nfunction parse(value){\n  if(!value)return null;\n  if(typeof value==='object')return value;\n  try{return JSON.parse(value)}catch(_){return null}\n}\nfunction user(){\n  try{return JSON.parse(localStorage.getItem('usuarioLogado')||'null')}catch(_){return null}\n}\nfunction prefsKey(){\n  const u=user();\n  return u?.id!=null?`prefs_usuario_${u.id}`:null;\n}\nfunction norm(theme){\n  theme=String(theme||'');\n  return VALID.has(theme)?theme:null;\n}\nfunction storedTheme(){\n  const pinned=norm(localStorage.getItem(PIN_KEY));\n  if(pinned)return pinned;\n  const key=prefsKey();\n  const prefs=key?parse(localStorage.getItem(key)):null;\n  return norm(prefs?.tema)||norm(document.documentElement.dataset.theme)||norm(document.body?.dataset.theme)||'light';\n}\n\nlet pinnedTheme=storedTheme();\nlet applying=false;\n\nfunction persistTheme(theme){\n  theme=norm(theme);\n  if(!theme)return pinnedTheme;\n  pinnedTheme=theme;\n  try{localStorage.setItem(PIN_KEY,theme)}catch(_){}\n  try{\n    const key=prefsKey();\n    if(key){\n      const prefs=parse(localStorage.getItem(key))||{};\n      prefs.tema=theme;\n      localStorage.setItem(key,JSON.stringify(prefs));\n    }\n  }catch(_){}\n  return theme;\n}\n\nfunction reassertTheme(theme=pinnedTheme){\n  theme=persistTheme(theme);\n  if(!theme||applying)return;\n  applying=true;\n  try{\n    document.documentElement.dataset.theme=theme;\n    if(document.body)document.body.dataset.theme=theme;\n    document.documentElement.style.colorScheme=(theme==='light'||theme==='military')?'light':'dark';\n    try{window.Temas26?.aplicar?.(theme,true)}catch(_){}\n    window.dispatchEvent(new CustomEvent('prefs26:update',{\n      detail:{tema:theme,source:'patch-2.3.23.2',localFirst:true}\n    }));\n  }finally{\n    queueMicrotask(()=>{applying=false});\n  }\n}\n\nfunction captureThemeChoice(theme){\n  theme=norm(theme);\n  if(!theme)return;\n  persistTheme(theme);\n  setTimeout(()=>reassertTheme(theme),0);\n}\n\nfunction installThemeFix(){\n  // Captura a preferência local antes das sincronizações antigas com o banco.\n  persistTheme(pinnedTheme);\n\n  document.addEventListener('click',event=>{\n    const button=event.target.closest?.('[data-theme-choice]');\n    if(button)captureThemeChoice(button.dataset.themeChoice);\n  },true);\n\n  document.addEventListener('change',event=>{\n    if(event.target?.id==='tema')captureThemeChoice(event.target.value);\n  },true);\n\n  const guard=new MutationObserver(()=>{\n    const htmlTheme=norm(document.documentElement.dataset.theme);\n    const bodyTheme=norm(document.body?.dataset.theme);\n    if((htmlTheme&&htmlTheme!==pinnedTheme)||(bodyTheme&&bodyTheme!==pinnedTheme)){\n      setTimeout(()=>reassertTheme(pinnedTheme),0);\n    }\n  });\n  guard.observe(document.documentElement,{attributes:true,attributeFilter:['data-theme']});\n  if(document.body)guard.observe(document.body,{attributes:true,attributeFilter:['data-theme']});\n\n  // Faz o v7.6.8 tratar a preferência local como alteração recente,\n  // impedindo a preferência remota antiga de trocar o tema sozinha.\n  reassertTheme(pinnedTheme);\n\n  window.addEventListener('focus',()=>reassertTheme(pinnedTheme));\n  window.addEventListener('pageshow',()=>reassertTheme(pinnedTheme));\n}\n\nfunction fixVersionLabels(){\n  const root=document.documentElement;\n  root.dataset.tarefasAppVersion=PATCH_VERSION;\n  root.dataset.tarefasAppBuild=String(BUILD);\n  root.dataset.tarefasPatchVersion=PATCH_VERSION;\n\n  document.querySelectorAll('.tm-app-brand small').forEach(el=>{\n    const web=el.textContent.match(/WEB\\s*([0-9.]+)/i)?.[1]||WEB_VERSION;\n    const wanted=`${PATCH_VERSION} • WEB ${web}`;\n    if(el.textContent.trim()!==wanted)el.textContent=wanted;\n  });\n\n  document.querySelectorAll('.tm-about-grid article').forEach(card=>{\n    const label=card.querySelector('small')?.textContent?.trim().toLowerCase()||'';\n    if(label==='versão do app'){\n      const value=card.querySelector('strong');\n      if(value&&value.textContent.trim()!==PATCH_VERSION)value.textContent=PATCH_VERSION;\n    }\n  });\n\n  const hero=document.querySelector('.tm-about-hero p');\n  if(hero){\n    const next=hero.textContent\n      .replace(/Alpha\\s+2\\.3\\.22(?:\\.\\d+)?/g,`Alpha ${PATCH_VERSION}`)\n      .replace(/Alpha\\s+2\\.3\\.23\\.1/g,`Alpha ${PATCH_VERSION}`);\n    if(next!==hero.textContent)hero.textContent=next;\n  }\n\n  document.querySelectorAll('.tm-about-card h2,.tm-about-footer').forEach(el=>{\n    const next=el.textContent\n      .replace(/\\b2\\.3\\.22(?:\\.\\d+)?\\b/g,PATCH_VERSION)\n      .replace(/\\b2\\.3\\.23\\.1\\b/g,PATCH_VERSION);\n    if(next!==el.textContent)el.textContent=next;\n  });\n}\n\nfunction installVersionFix(){\n  let scheduled=false;\n  const schedule=()=>{\n    if(scheduled)return;\n    scheduled=true;\n    requestAnimationFrame(()=>{\n      scheduled=false;\n      fixVersionLabels();\n    });\n  };\n  fixVersionLabels();\n  const observer=new MutationObserver(schedule);\n  observer.observe(document.documentElement,{childList:true,subtree:true});\n  window.addEventListener('pageshow',schedule);\n}\n\nfunction boot(){\n  installThemeFix();\n  installVersionFix();\n}\n\npersistTheme(pinnedTheme);\nif(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});\nelse boot();\n\nglobalThis.TarefasPatch23232={\n  version:PATCH_VERSION,\n  baseVersion:BASE_VERSION,\n  build:BUILD,\n  theme:()=>pinnedTheme,\n  reapplyTheme:()=>reassertTheme(pinnedTheme),\n  refreshVersion:fixVersionLabels\n};\n})();",
    "css": ""
  },
  "payloadSha256": "53195798e4da17cf06cf2a45efef95fd23d4e7a935b5dcd489031fb3fb7f8d63"
}

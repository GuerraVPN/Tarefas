{
  "format": "tarefas-tpatch-v1",
  "id": "2.4.4-prebeta2",
  "name": "TAREFAS 2.4.4-prebeta2 — Escalas diretas do Google",
  "patchVersion": 1,
  "createdAt": "2026-09-23T16:20:00Z",
  "baseVersion": "2.4.3",
  "minBuild": 278,

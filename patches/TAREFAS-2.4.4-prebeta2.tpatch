  "replacementMode": "replace-older-same-base",
  "replaces": ["2.4.3.1","2.4.3.2","2.4.3.3","2.4.3.4","2.4.3.5","2.4.3.6","2.4.4-prebeta"],
  "description": "Corrige a 2.4.4-prebeta para voltar a carregar as escalas diretamente das planilhas oficiais do Google, sem tentar sincronizar pelo Supabase/Apps Script.",
  "changelog": ["Mantém a base cumulativa da 2.4.3.6.","Remove o fluxo de sincronização Google Sheets → Apps Script → Supabase da tela de Escalas.","As escalas Motorista PA, Patrulheiro e Permanência passam a abrir diretamente as planilhas oficiais do Google.","Remove Pessoal / Escalas e Missões da navegação.","Mantém a remoção do Próximo Serviço.","Substitui integralmente a 2.4.4-prebeta anterior."],
  "order": 2440202,
  "payload": {
    "js": "(()=>{'use strict';\nconst MARK='__TAREFAS_ALPHA_244_PREBETA2_GOOGLE_SCALES__';\nif(globalThis[MARK])return;globalThis[MARK]=true;\nconst LINKS=Object.freeze([\n{id:'motorista_pa',label:'Motorista PA',url:'https://docs.google.com/spreadsheets/d/1T_BM9KY0NLwVhlifetQ6W6AdetujQjx--zOZHa27eQs/edit?usp=drivesdk',icon:'🚙'},\n{id:'patrulheiro',label:'Patrulheiro',url:'https://docs.google.com/spreadsheets/d/1_LlfIHx4EuSHkC9BOR2VorvXoaiMyLa028wU6C0dQLs/edit?usp=drivesdk',icon:'🛡️'},\n{id:'permanencia',label:'Permanência',url:'https://docs.google.com/spreadsheets/d/13eEei_JdGjAdVo371BGfPS59QdYySe9lJ47DLjWb_x0/edit?usp=drivesdk',icon:'🏢'}\n]);\nconst norm=v=>String(v??'').normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').replace(/\\s+/g,' ').trim().toLowerCase();\nfunction css(){if(document.getElementById('tm244pb2css'))return;const s=document.createElement('style');s.id='tm244pb2css';s.textContent='.tm244pb2-page{padding:16px;max-width:1050px;margin:0 auto}.tm244pb2-head{margin-bottom:14px}.tm244pb2-head h2{margin:0 0 5px}.tm244pb2-head p{margin:0;font-size:12px;opacity:.7}.tm244pb2-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.tm244pb2-card{display:flex;align-items:center;gap:12px;padding:15px;border:1px solid rgba(127,127,127,.25);border-radius:15px;background:var(--v4-surface,#fff);color:inherit;text-decoration:none}.tm244pb2-icon{font-size:24px}.tm244pb2-copy{flex:1}.tm244pb2-copy strong{display:block}.tm244pb2-copy small{display:block;margin-top:4px;opacity:.6;font-size:10px}.tm244pb2-arrow{opacity:.55}@media(max-width:760px){.tm244pb2-grid{grid-template-columns:1fr}}';document.head.appendChild(s)}\nfunction hideOld(){document.querySelectorAll('a,button,li,[role=\"menuitem\"]').forEach(el=>{const t=norm(el.textContent),h=String(el.getAttribute?.('href')||el.dataset?.href||'').toLowerCase();if(t==='missões'||t==='missoes'||t==='pessoal / escalas'||h.includes('missao.html')){const x=el.closest?.('li,[role=\"menuitem\"]')||el;x.style.display='none';x.setAttribute('data-tarefas-244pb2-hidden','1')}})}\nfunction link(row,cls){const a=document.createElement('a');a.href=row.url;a.target='_blank';a.rel='noopener noreferrer external';a.className=cls||'tm244pb2-card';a.dataset.tarefasGoogleScale=row.id;a.innerHTML='<span class=\"tm244pb2-icon\">'+row.icon+'</span><span class=\"tm244pb2-copy\"><strong>'+row.label+'</strong><small>Abrir planilha oficial no Google Planilhas</small></span><span class=\"tm244pb2-arrow\">↗</span>';return a}\nfunction injectPage(){if(document.getElementById('tm244pb2-page'))return;const main=document.querySelector('.v7-main,main');if(!main)return;const page=String(location.pathname.split('/').pop()||'').toLowerCase();if(page!=='pessoal.html'&&page!=='missao.html'&&!document.querySelector('[data-tarefas-244pb2-scales-host]'))return;css();const host=document.createElement('section');host.id='tm244pb2-page';host.dataset.tarefas244pb2ScalesHost='1';host.className='tm244pb2-page';host.innerHTML='<div class=\"tm244pb2-head\"><h2>Escalas</h2><p>As escalas são carregadas diretamente das planilhas oficiais do Google.</p></div><div class=\"tm244pb2-grid\"></div>';host.querySelector('.tm244pb2-grid').append(...LINKS.map(x=>link(x)));const old=main.querySelector('.v7-page');if(old)old.replaceWith(host);else main.appendChild(host)}\nfunction rewriteMenu(){const parents=[...document.querySelectorAll('.v7-pessoal-parent,[data-menu=\"pessoal\"],nav,aside')];for(const parent of parents){const sub=parent.querySelector('.v7-pessoal-sub,ul');if(!sub)continue;sub.querySelectorAll('a').forEach(a=>{const t=norm(a.textContent);if(t==='pessoal / escalas'||t==='missões'||t==='missoes')a.remove()});if(!sub.querySelector('[data-tarefas-google-scale=\"motorista_pa\"]')){for(const row of LINKS){const a=link(row,'');a.dataset.tarefasGoogleScale=row.id;a.textContent=row.label;sub.appendChild(a)}return true}}return false}\nfunction start(){hideOld();rewriteMenu();injectPage()}\nstart();if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start,{once:true});window.addEventListener('pageshow',start);window.addEventListener('focus',start);\nconst mo=new MutationObserver(()=>{hideOld();rewriteMenu();injectPage()});mo.observe(document.documentElement,{childList:true,subtree:true});\nglobalThis.TarefasAlpha244Prebeta2=Object.freeze({version:'2.4.4-prebeta2',links:LINKS.map(x=>({...x})),refresh:start});\n})();",
    "css": ""
  },
  "payloadSha256": "f745b812349d2730c72c1df0fa13cd8711f82566e9de39f87b55df022ab925f8"
}

{
  "format": "tarefas-tpatch-v1",
  "id": "2.3.23.5",
  "name": "TAREFAS 2.3.23.5 — Notificação imediata de patches",
  "patchVersion": 1,
  "createdAt": "2026-09-21T13:45:00Z",
  "baseVersion": "2.3.23.1",
  "minBuild": 270,
  "maxBuild": 270,
  "channel": "alpha",
  "cumulative": true,
  "replacementMode": "replace-older-same-base",
  "replaces": [
    "2.3.23.2",
    "2.3.23.3",
    "2.3.23.4"
  ],
  "description": "Corrige o atraso das notificações de patches e evita avisos depois que o patch já começou a ser instalado ou já está instalado.",
  "changelog": [
    "Checagem de novos patches passa a rodar imediatamente ao abrir ou retomar o aplicativo.",
    "Antes de notificar, o app consulta novamente os patches instalados para impedir aviso de uma versão que já foi aplicada.",
    "Ao tocar em Baixar e aplicar, o patch é marcado como visto antes do download, eliminando a corrida que gerava notificação após a instalação.",
    "A identificação do patch é reservada antes do disparo assíncrono para evitar notificações duplicadas.",
    "Mantidos o modelo cumulativo, correções de tema, histórico de patches e canais Alpha/Beta.",
    "A 2.3.23.5 substitui automaticamente a 2.3.23.4 e demais patches anteriores da mesma base.",
    "O catálogo de patches passa a usar cache-busting automático para novas versões aparecerem imediatamente no Gerenciador."
  ],
  "order": 23235,
  "payload": {
    "js": "(()=>{\n'use strict';\nconst CURRENT='2.3.23.5';\nconst BASE='2.3.23.1';\nconst DB_NAME='tarefas-patches-v1';\nconst STORE='patches';\nconst THEME_KEY='tarefasPatchTheme23235';\nconst LEGACY_THEME_KEYS=['tarefasPatchTheme23234','tarefasPatchTheme23232'];\nconst RELOAD_KEY='tarefasPatchReplacementReload';\nconst VALID_THEMES=new Set(['light','dark','night','military']);\nconst CORE_MARK='__TAREFAS_PATCH_23235_CUMULATIVE_CORE__';\nif(globalThis[CORE_MARK])return;\nglobalThis[CORE_MARK]=true;\n\nfunction parts(v){return String(v||'').split('.').map(n=>Number(n)||0)}\nfunction cmp(a,b){const aa=parts(a),bb=parts(b),n=Math.max(aa.length,bb.length);for(let i=0;i<n;i++){const d=(aa[i]||0)-(bb[i]||0);if(d)return d}return 0}\nfunction parse(v){if(!v)return null;if(typeof v==='object')return v;try{return JSON.parse(v)}catch(_){return null}}\nfunction user(){try{return JSON.parse(localStorage.getItem('usuarioLogado')||'null')}catch(_){return null}}\nfunction prefKey(){const u=user();return u?.id!=null?`prefs_usuario_${u.id}`:null}\nfunction normTheme(v){v=String(v||'');return VALID_THEMES.has(v)?v:null}\nfunction readTheme(){\n  const direct=normTheme(localStorage.getItem(THEME_KEY));if(direct)return direct;\n  for(const key of LEGACY_THEME_KEYS){const t=normTheme(localStorage.getItem(key));if(t)return t}\n  const k=prefKey(),prefs=k?parse(localStorage.getItem(k)):null;\n  return normTheme(prefs?.tema)||normTheme(document.documentElement.dataset.theme)||normTheme(document.body?.dataset.theme)||'light';\n}\nlet desiredTheme=readTheme(),applyingTheme=false;\nfunction persistTheme(theme){\n  theme=normTheme(theme);if(!theme)return desiredTheme;\n  desiredTheme=theme;\n  try{localStorage.setItem(THEME_KEY,theme)}catch(_){}\n  try{for(const key of LEGACY_THEME_KEYS)localStorage.removeItem(key)}catch(_){}\n  try{\n    const k=prefKey();if(k){const prefs=parse(localStorage.getItem(k))||{};prefs.tema=theme;localStorage.setItem(k,JSON.stringify(prefs))}\n  }catch(_){}\n  return theme;\n}\nfunction applyTheme(theme=desiredTheme){\n  theme=persistTheme(theme);if(!theme||applyingTheme)return;\n  applyingTheme=true;\n  try{\n    document.documentElement.dataset.theme=theme;\n    if(document.body)document.body.dataset.theme=theme;\n    document.documentElement.style.colorScheme=(theme==='light'||theme==='military')?'light':'dark';\n    try{window.Temas26?.aplicar?.(theme,true)}catch(_){}\n    window.dispatchEvent(new CustomEvent('prefs26:update',{detail:{tema:theme,source:'patch-2.3.23.5',localFirst:true}}));\n  }finally{queueMicrotask(()=>{applyingTheme=false})}\n}\nfunction installThemeGuard(){\n  persistTheme(desiredTheme);\n  applyTheme(desiredTheme);\n  document.addEventListener('click',e=>{const b=e.target.closest?.('[data-theme-choice]');const t=normTheme(b?.dataset?.themeChoice);if(t){desiredTheme=t;applyTheme(t)}},true);\n  document.addEventListener('change',e=>{if(e.target?.id==='tema'){const t=normTheme(e.target.value);if(t){desiredTheme=t;applyTheme(t)}}},true);\n  const guard=new MutationObserver(()=>{const h=normTheme(document.documentElement.dataset.theme),b=normTheme(document.body?.dataset.theme);if((h&&h!==desiredTheme)||(b&&b!==desiredTheme))setTimeout(()=>applyTheme(desiredTheme),0)});\n  guard.observe(document.documentElement,{attributes:true,attributeFilter:['data-theme']});\n  if(document.body)guard.observe(document.body,{attributes:true,attributeFilter:['data-theme']});\n  window.addEventListener('focus',()=>applyTheme(desiredTheme));\n  window.addEventListener('pageshow',()=>applyTheme(desiredTheme));\n}\nfunction purgeOlderPatches(){\n  return new Promise((resolve,reject)=>{\n    const req=indexedDB.open(DB_NAME,1);\n    req.onerror=()=>reject(req.error||new Error('Falha ao abrir patches.'));\n    req.onupgradeneeded=()=>{const db=req.result;if(!db.objectStoreNames.contains(STORE))db.createObjectStore(STORE,{keyPath:'id'})};\n    req.onsuccess=()=>{\n      const db=req.result;let removed=0;\n      const tx=db.transaction(STORE,'readwrite'),store=tx.objectStore(STORE),all=store.getAll();\n      all.onerror=()=>{try{tx.abort()}catch(_){}};\n      all.onsuccess=()=>{\n        for(const p of all.result||[]){\n          if(String(p?.baseVersion||'')!==BASE)continue;\n          const id=String(p?.id||'');\n          if(id&&id!==CURRENT&&cmp(id,CURRENT)<0){store.delete(id);removed++}\n        }\n      };\n      tx.oncomplete=()=>{db.close();resolve(removed)};\n      tx.onerror=()=>{const err=tx.error;db.close();reject(err||new Error('Falha ao substituir patch antigo.'))};\n      tx.onabort=()=>{const err=tx.error;db.close();reject(err||new Error('Substituição de patch cancelada.'))};\n    };\n  });\n}\nasync function installReplacementMode(){\n  try{\n    const removed=await purgeOlderPatches();\n    document.documentElement.dataset.tarefasPatchReplacement='cumulative';\n    document.documentElement.dataset.tarefasPatchReplacedCount=String(removed);\n    if(removed>0&&sessionStorage.getItem(RELOAD_KEY)!==CURRENT){\n      sessionStorage.setItem(RELOAD_KEY,CURRENT);\n      setTimeout(()=>location.reload(),180);\n    }\n  }catch(err){console.warn('[TAREFAS PATCH 2.3.23.5] limpeza dos patches antigos falhou',err?.message||err)}\n}\nfunction boot(){\n  document.getElementById('tmPatch23233Style')?.remove();\n  document.getElementById('tmPatchHistory23233')?.remove();\n  installThemeGuard();\n  installReplacementMode();\n}\nif(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();\nglobalThis.TarefasPatchCumulative={\n  version:CURRENT,baseVersion:BASE,\n  mode:'replace-older-same-base',\n  applyTheme:()=>applyTheme(desiredTheme),\n  cleanup:installReplacementMode\n};\n})();\n(()=>{\n'use strict';\n\nconst PATCH_VERSION='2.3.23.5';\nconst BASE_VERSION='2.3.23.1';\nconst BUILD=270;\nconst CATALOG_URL='https://raw.githubusercontent.com/GuerraVPN/Tarefas/app/releases/patches/catalog-v1.json';\nconst RAW_FETCH=globalThis.fetch?.bind(globalThis);\nfunction installCatalogCacheBuster(){\n  if(!RAW_FETCH||globalThis.__TAREFAS_PATCH_CATALOG_CACHEBUSTER__)return;\n  globalThis.__TAREFAS_PATCH_CATALOG_CACHEBUSTER__=true;\n  globalThis.fetch=(input,init)=>{\n    try{\n      const href=typeof input==='string'?input:input?.url;\n      if(href===CATALOG_URL){\n        const sep=href.includes('?')?'&':'?';\n        return RAW_FETCH(href+sep+'cb='+Date.now(),{...(init||{}),cache:'no-store'});\n      }\n    }catch(_){}\n    return RAW_FETCH(input,init);\n  };\n}\ninstallCatalogCacheBuster();\nconst SEEN_KEY='tarefasPatchNotificationsSeenV1';\nconst MARK='__TAREFAS_PATCH_23235__';\n\nif(globalThis[MARK])return;\nglobalThis[MARK]=true;\nglobalThis.__TAREFAS_EFFECTIVE_VERSION__=PATCH_VERSION;\n\nconst esc=v=>String(v??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#039;'}[c]));\nconst sleep=ms=>new Promise(r=>setTimeout(r,ms));\nconst pm=()=>globalThis.TarefasPatchManager||null;\nconst sessionToken=()=>String(localStorage.getItem('tarefasPushSession17')||'').trim();\nconst client=()=>{try{return typeof supabaseClient!=='undefined'?supabaseClient:null}catch(_){return null}};\n\nfunction versionParts(value){\n  return String(value||'').split('.').map(n=>Number(n)||0);\n}\nfunction compareVersions(a,b){\n  const aa=versionParts(a),bb=versionParts(b),len=Math.max(aa.length,bb.length);\n  for(let i=0;i<len;i++){const d=(aa[i]||0)-(bb[i]||0);if(d)return d}\n  return 0;\n}\nfunction channelLabel(channel){\n  channel=String(channel||'alpha').toLowerCase();\n  if(channel==='beta')return'BETA';\n  if(channel==='official')return'OFICIAL';\n  return'ALPHA';\n}\nfunction normalizeCatalogPatch(row){\n  return {\n    ...row,\n    id:String(row?.id||''),\n    channel:String(row?.channel||'alpha').toLowerCase(),\n    changelog:Array.isArray(row?.changelog)?row.changelog.map(String):[],\n    description:String(row?.description||'')\n  };\n}\nfunction readSeen(){\n  try{\n    const parsed=JSON.parse(localStorage.getItem(SEEN_KEY)||'[]');\n    return new Set(Array.isArray(parsed)?parsed.map(String):[]);\n  }catch(_){return new Set()}\n}\nfunction writeSeen(seen){\n  try{localStorage.setItem(SEEN_KEY,JSON.stringify([...seen].slice(-100)))}catch(_){}\n}\nasync function getCatalog(){\n  if(pm()?.checkCatalog)return pm().checkCatalog();\n  const res=await fetch(CATALOG_URL,{cache:'no-store'});\n  if(!res.ok)throw new Error(`Catálogo respondeu HTTP ${res.status}.`);\n  const data=await res.json();\n  if(!Array.isArray(data?.patches))throw new Error('Catálogo de patches inválido.');\n  return data;\n}\nasync function installedPatches(){\n  try{return await pm()?.list?.()||[]}catch(_){return[]}\n}\nfunction compatible(row){\n  if(String(row?.baseVersion||'')!==BASE_VERSION)return false;\n  const min=Number(row?.minBuild||0);\n  const max=row?.maxBuild==null?Number.MAX_SAFE_INTEGER:Number(row.maxBuild);\n  return BUILD>=min&&BUILD<=max;\n}\nasync function channelPreferences(){\n  const token=sessionToken();\n  const c=client();\n  let beta=false,alpha=false,alphaEligible=false;\n  if(!token||!c)return{beta,alpha,alphaEligible};\n  try{\n    const r=await c.rpc('v1_8_get_beta_updates',{p_session_token:token});\n    if(!r.error)beta=r.data===true;\n  }catch(_){}\n  try{\n    const r=await c.rpc('v2_3_21_alpha_context',{p_session_token:token});\n    if(!r.error){\n      const row=Array.isArray(r.data)?r.data[0]:r.data;\n      alphaEligible=row?.eligible===true;\n      alpha=alphaEligible&&row?.receive_alpha===true;\n    }\n  }catch(_){}\n  return{beta,alpha,alphaEligible};\n}\nfunction allowedByPreference(row,prefs){\n  const channel=String(row?.channel||'alpha').toLowerCase();\n  if(channel==='official')return true;\n  if(channel==='beta')return prefs.beta===true;\n  return prefs.alpha===true;\n}\nasync function notifyPatch(row){\n  const label=channelLabel(row.channel);\n  const title=`Patch ${label} ${row.id} disponível`;\n  const body=row.description||row.name||'Novo patch do TAREFAS disponível.';\n  const payload={\n    title,\n    body,\n    extra:{\n      tipo:'app_patch',\n      channel:String(row.channel||'alpha'),\n      patch_id:String(row.id),\n      destino_url:`about.html?patch=${encodeURIComponent(row.id)}`\n    }\n  };\n  try{\n    const fn=window.TarefasNative?.notifications?.notify;\n    if(fn){\n      await fn(payload);\n      window.dispatchEvent(new CustomEvent('v6:notificacoes:update'));\n      return true;\n    }\n  }catch(err){\n    console.warn('[TAREFAS PATCH 2.3.23.5] falha na notificação nativa',err?.message||err);\n  }\n  try{\n    if('Notification'in window&&Notification.permission==='granted'){\n      new Notification(title,{body,tag:`tarefas-patch-${row.id}`});\n      return true;\n    }\n  }catch(_){}\n  return false;\n}\nasync function isPatchInstalled(id){\n  const rows=await installedPatches();\n  return rows.some(p=>String(p?.id||'')===String(id)&&p?.enabled!==false);\n}\nfunction markPatchSeen(id){\n  id=String(id||'').trim();\n  if(!id)return;\n  const seen=readSeen();\n  seen.add(id);\n  writeSeen(seen);\n}\nasync function checkPatchNotifications(){\n  const manager=pm();\n  if(!manager)return;\n  const [catalog,prefs]=await Promise.all([getCatalog(),channelPreferences()]);\n  const seen=readSeen();\n\n  // Sincroniza primeiro os patches já instalados para nunca notificá-los.\n  for(const p of await installedPatches())seen.add(String(p.id));\n  writeSeen(seen);\n\n  const rows=(catalog.patches||[])\n    .map(normalizeCatalogPatch)\n    .filter(compatible)\n    .sort((a,b)=>compareVersions(a.id,b.id));\n\n  for(const row of rows){\n    if(!row.id||seen.has(row.id)||!allowedByPreference(row,prefs))continue;\n\n    // Segunda conferência imediatamente antes do aviso.\n    if(await isPatchInstalled(row.id)){\n      seen.add(row.id);\n      writeSeen(seen);\n      continue;\n    }\n\n    // Reserva o ID antes da chamada assíncrona para impedir corrida/duplicação.\n    seen.add(row.id);\n    writeSeen(seen);\n\n    const sent=await notifyPatch(row);\n    if(!sent){\n      // Se a instalação ocorreu enquanto tentávamos notificar, mantém como visto.\n      if(!(await isPatchInstalled(row.id))){\n        seen.delete(row.id);\n        writeSeen(seen);\n      }\n      continue;\n    }\n    await sleep(40);\n  }\n  writeSeen(seen);\n}\nfunction badgeHtml(channel){\n  const ch=String(channel||'alpha').toLowerCase();\n  return `<span class=\"tm-patch-history-channel ${esc(ch)}\">${channelLabel(ch)}</span>`;\n}\nfunction changelogHtml(items){\n  return items?.length?`<ul>${items.map(x=>`<li>${esc(x)}</li>`).join('')}</ul>`:'';\n}\nasync function renderPatchHistory(box){\n  const historyId='tmPatchHistory23235';\n  let section=box.querySelector('#'+historyId);\n  if(!section){\n    section=document.createElement('section');\n    section.id=historyId;\n    section.className='tm-patch-history23235';\n    const warning=box.querySelector('.tm-patch-warning');\n    if(warning)warning.before(section);else box.appendChild(section);\n  }\n  section.innerHTML='<div class=\"tm-patch-history-loading\">Carregando histórico de patches…</div>';\n  try{\n    const [catalog,installed]=await Promise.all([getCatalog(),installedPatches()]);\n    const installedMap=new Map(installed.map(p=>[String(p.id),p]));\n    const rows=(Array.isArray(catalog.history)?catalog.history:(catalog.patches||[]))\n      .map(normalizeCatalogPatch)\n      .filter(compatible)\n      .sort((a,b)=>compareVersions(b.id,a.id));\n    section.innerHTML=`<div class=\"tm-patch-history-title\"><div><span class=\"tm-update-eyebrow\">HISTÓRICO DE PATCHES</span><h3>O que mudou em cada patch</h3></div><span class=\"tm-patch-effective\">ATUAL ${PATCH_VERSION}</span></div>\n      <div class=\"tm-patch-history-list\">${rows.length?rows.map(row=>{\n        const installedRow=installedMap.get(row.id);\n        const active=installedRow&&installedRow.enabled!==false;\n        const state=active?'INSTALADO':installedRow?'DESATIVADO':'DISPONÍVEL';\n        return `<article class=\"tm-patch-history-item ${row.id===PATCH_VERSION?'current':''}\">\n          <div class=\"tm-patch-history-head\"><div><strong>${esc(row.id)}</strong><small>${esc(row.name||'Patch TAREFAS')}</small></div><div>${badgeHtml(row.channel)}<span class=\"tm-patch-history-state ${active?'installed':''}\">${state}</span></div></div>\n          ${row.description?`<p>${esc(row.description)}</p>`:''}\n          ${changelogHtml(row.changelog)}\n        </article>`;\n      }).join(''):'<div class=\"tm-patch-empty\">Nenhum patch publicado para esta base.</div>'}</div>`;\n  }catch(err){\n    section.innerHTML=`<div class=\"tm-patch-empty\">Não foi possível carregar o histórico de patches: ${esc(err?.message||err)}</div>`;\n  }\n}\nfunction ensureStyle(){\n  if(document.getElementById('tmPatch23235Style'))return;\n  const s=document.createElement('style');\n  s.id='tmPatch23235Style';\n  s.textContent=`\n    #tmPatchManager{margin-top:14px!important;margin-bottom:14px}\n    #tmPatchManager .tm-update-title h2{margin-bottom:2px}\n    .tm-patch-history23235{margin-top:18px;padding-top:16px;border-top:1px solid var(--v4-border,#263238)}\n    .tm-patch-history-title,.tm-patch-history-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}\n    .tm-patch-history-title h3{margin:4px 0 0;font-size:17px}\n    .tm-patch-effective{font-size:10px;font-weight:900;border-radius:999px;padding:6px 9px;background:var(--v4-accent-soft,#153e33);color:var(--v4-accent,#34d399);white-space:nowrap}\n    .tm-patch-history-list{display:grid;gap:10px;margin-top:12px}\n    .tm-patch-history-item{border:1px solid var(--v4-border,#2b3a38);border-radius:12px;padding:12px;background:var(--v4-surface-2,#0b1a17)}\n    .tm-patch-history-item.current{border-color:var(--v4-accent,#34d399)}\n    .tm-patch-history-head strong{font-size:18px;display:block}.tm-patch-history-head small{display:block;opacity:.72;margin-top:2px}\n    .tm-patch-history-head>div:last-child{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}\n    .tm-patch-history-channel,.tm-patch-history-state{font-size:9px;font-weight:900;border-radius:999px;padding:5px 7px;white-space:nowrap}\n    .tm-patch-history-channel.alpha{background:#52236b;color:#e9c5ff}.tm-patch-history-channel.beta{background:#5b4310;color:#ffda74}.tm-patch-history-channel.official{background:#174c3c;color:#a8f0d4}\n    .tm-patch-history-state{background:var(--v4-surface-3,#18241f);color:var(--v4-muted,#9aa6a2)}.tm-patch-history-state.installed{background:#164c3b;color:#b7f7df}\n    .tm-patch-history-item p{font-size:12px;line-height:1.45;margin:9px 0}.tm-patch-history-item ul{margin:8px 0 0;padding-left:20px;font-size:12px;line-height:1.55}\n    .tm-patch-history-loading{font-size:12px;opacity:.75;padding:10px 0}\n  `;\n  document.head.appendChild(s);\n}\nfunction fixEffectiveVersion(){\n  document.documentElement.dataset.tarefasPatchVersion=PATCH_VERSION;\n  document.documentElement.dataset.tarefasEffectiveVersion=PATCH_VERSION;\n  document.querySelectorAll('.tm-app-brand small').forEach(el=>{\n    const web=el.textContent.match(/WEB\\s*([0-9.]+)/i)?.[1]||'7.8.2';\n    el.textContent=`${PATCH_VERSION} • WEB ${web}`;\n  });\n}\nlet uiBusy=false;\nasync function placeManagerAndHistory(){\n  if(uiBusy)return false;\n  const root=document.getElementById('tmAppUpdates');\n  const box=document.getElementById('tmPatchManager');\n  const main=root?.querySelector('.tm-update-main');\n  if(!root||!box||!main)return false;\n  uiBusy=true;\n  try{\n    ensureStyle();\n    if(main.nextElementSibling!==box)main.insertAdjacentElement('afterend',box);\n    const title=box.querySelector('.tm-update-title h2');\n    if(title)title.textContent='Gerenciador de Patches';\n    const badge=box.querySelector('.tm-update-title .tm-update-channel');\n    if(badge){badge.textContent=`PATCH ${PATCH_VERSION}`;badge.classList.add('alpha')}\n    if(box.dataset.history23235!=='1'){\n      box.dataset.history23235='1';\n      await renderPatchHistory(box);\n    }\n    fixEffectiveVersion();\n    return true;\n  }finally{uiBusy=false}\n}\nfunction watchUi(){\n  let scheduled=false;\n  const schedule=()=>{\n    if(scheduled)return;\n    scheduled=true;\n    setTimeout(async()=>{\n      scheduled=false;\n      await placeManagerAndHistory().catch(()=>{});\n    },40);\n  };\n  schedule();\n  const obs=new MutationObserver(schedule);\n  obs.observe(document.documentElement,{childList:true,subtree:true});\n}\nfunction installNotificationWatcher(){\n  let running=null;\n  const run=()=>{\n    if(running)return running;\n    running=checkPatchNotifications()\n      .catch(err=>console.warn('[TAREFAS PATCH 2.3.23.5] check notification',err?.message||err))\n      .finally(()=>{running=null});\n    return running;\n  };\n\n  // Checagem imediata ao iniciar esta versão do patch.\n  queueMicrotask(run);\n\n  // Se o usuário iniciar a instalação manualmente, o patch é marcado como visto\n  // antes do download/aplicação, evitando aviso atrasado depois da recarga.\n  document.addEventListener('click',event=>{\n    const btn=event.target.closest?.('[data-install-official]');\n    const id=btn?.dataset?.installOfficial;\n    if(id)markPatchSeen(id);\n  },true);\n\n  window.addEventListener('focus',run);\n  window.addEventListener('online',run);\n  window.addEventListener('pageshow',run);\n  document.addEventListener('visibilitychange',()=>{if(!document.hidden)run()});\n  setInterval(()=>{if(!document.hidden)run()},15*60*1000);\n}\nfunction boot(){\n  fixEffectiveVersion();\n  watchUi();\n  installNotificationWatcher();\n}\nif(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});\nelse boot();\n\nglobalThis.TarefasPatch23235={\n  version:PATCH_VERSION,\n  baseVersion:BASE_VERSION,\n  build:BUILD,\n  refreshUi:placeManagerAndHistory,\n  checkNotifications:checkPatchNotifications,\n  markSeen:markPatchSeen,\n  isInstalled:isPatchInstalled\n};\n})();",
    "css": ""
  },
  "payloadSha256": "fa848888faa1743e76018b427b23c4a252a5c60ce3246d12e2fd7afaacebcbef"
}

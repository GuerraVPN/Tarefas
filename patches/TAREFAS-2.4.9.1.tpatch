  "description": "Corrige o travamento do módulo Orçamentários no Android reproduzindo a arquitetura da Web 7.9.7, com módulos separados, e atualiza a base Web carregada pelo app para a Web 7.9.7.",
  "changelog": [
    "Corrige o travamento de Orçamentários evitando o carregamento monolítico de orcamentarios.html.",
    "Divide a navegação de Orçamentários em páginas independentes, como na Web 7.9.7.",
    "Inclui Notas Fiscais como módulo independente ao lado de Guias.",
    "Mantém Baixa/Desrelacionamento, Distribuição, Movimentação, Material Carga, Passagem, Lavanderia e Relatório.",
    "Atualiza a base Web do módulo Orçamentários para a Web 7.9.7, fixada em commit conhecido do repositório.",
    "Preserva o cabeçalho/navegação nativos do Android e o acesso autenticado ao Supabase."
  ],
  "order": 24901,
  "payload": {
    "js": "(()=>{'use strict';\nconst MARK='__TAREFAS_ALPHA_2491_ORC_WEB797_FIX__';\nif(globalThis[MARK])return;\nglobalThis[MARK]=true;\nconst WEB='7.9.7';\nconst COMMIT='98973fa379abc49f1423fd5b57ad66bdb723bf7b';\nconst RAW='https://raw.githubusercontent.com/GuerraVPN/Tarefas/'+COMMIT+'/';\nconst ROUTES={\n 'orcamentarios.html':'orcamento_relatorio.html',\n 'guias.html':'guias.html',\n 'pedidos.html':'pedidos.html',\n 'movimentacoes.html':'movimentacoes.html',\n 'material_carga.html':'material_carga.html',\n 'passagem_carga.html':'passagem_carga.html',\n 'lavanderia.html':'lavanderia.html',\n 'orcamento_relatorio.html':'orcamento_relatorio.html',\n 'notas_fiscais.html':'notas_fiscais.html'\n};\nconst QUERY={\n 'guias':'guias.html',\n 'baixas':'pedidos.html?modulo=baixas',\n 'distribuicao':'pedidos.html?modulo=distribuicao',\n 'movimentacao':'movimentacoes.html?modulo=movimentacao',\n 'material_carga':'material_carga.html?modulo=material_carga',\n 'passagem_carga':'passagem_carga.html?modulo=passagem_carga',\n 'lavanderia':'lavanderia.html?modulo=lavanderia',\n 'relatorio':'orcamento_relatorio.html',\n 'notas_fiscais':'notas_fiscais.html?modulo=notas_fiscais'\n};\nconst isOrc=()=>{const p=(location.pathname.split('/').pop()||'index.html').toLowerCase();return p==='orcamentarios.html'||p==='guias.html'||p==='pedidos.html'||p==='movimentacoes.html'||p==='material_carga.html'||p==='passagem_carga.html'||p==='lavanderia.html'||p==='orcamento_relatorio.html'||p==='notas_fiscais.html'};\nconst target=()=>{\n const p=(location.pathname.split('/').pop()||'index.html').toLowerCase();\n if(p==='orcamentarios.html')return QUERY[new URLSearchParams(location.search).get('modulo')||'relatorio']||'orcamento_relatorio.html';\n return ROUTES[p]||null;\n};\nconst abs=v=>{try{return new URL(v,RAW).href}catch(_){return v}};\nfunction rewrite(doc){\n doc.querySelectorAll('[src],[href]').forEach(el=>{\n  const attr=el.hasAttribute('src')?'src':'href',v=el.getAttribute(attr);\n  if(!v||/^(?:[a-z][a-z0-9+.-]*:|#|\\/\\/|data:|javascript:)/i.test(v))return;\n  el.setAttribute(attr,abs(v));\n });\n doc.querySelectorAll('form[action]').forEach(el=>el.setAttribute('action',abs(el.getAttribute('action'))));\n return doc;\n}\nfunction saveShell(){return [...document.querySelectorAll('.tm-app-header,.tm-bottom-nav')].filter(Boolean)}\nfunction patchShell(shell){\n for(const el of document.querySelectorAll('.tm-app-header,.tm-bottom-nav'))el.remove();\n shell.forEach(el=>document.body.appendChild(el));\n const brand=document.querySelector('.tm-app-brand small');\n if(brand)brand.textContent='2.4.9.1 • WEB '+WEB;\n}\nfunction wireLinks(){\n if(document.documentElement.dataset.tm2491OrcLinks==='1')return;\n document.documentElement.dataset.tm2491OrcLinks='1';\n document.addEventListener('click',e=>{\n  const a=e.target.closest?.('a[href]');\n  if(!a||e.defaultPrevented)return;\n  const raw=a.getAttribute('href')||'';\n  if(/^(?:https?:|mailto:|tel:|#|javascript:)/i.test(raw))return;\n  const u=new URL(raw,location.href),p=u.pathname.split('/').pop().toLowerCase();\n  let route=null;\n  if(p==='orcamentarios.html')route=QUERY[u.searchParams.get('modulo')||'relatorio']||'orcamento_relatorio.html';\n  else if(ROUTES[p])route=raw;\n  if(!route)return;\n  e.preventDefault();e.stopPropagation();\n  const [file,query='']=route.split('?');\n  load(file,query?'?'+query:'');\n },true);\n}\nlet loading=false;\nasync function load(file,query=''){\n if(loading)return;\n loading=true;\n try{\n  const res=await fetch(RAW+file+'?v='+WEB,{cache:'no-store'});\n  if(!res.ok)throw new Error('Web '+WEB+' indisponível ('+res.status+').');\n  const html=await res.text();\n  const parsed=rewrite(new DOMParser().parseFromString(html,'text/html'));\n  const shell=saveShell();\n  document.title=parsed.title||'TAREFAS';\n  document.head.innerHTML=parsed.head.innerHTML;\n  document.body.innerHTML=parsed.body.innerHTML;\n  for(const old of [...parsed.querySelectorAll('script')]){\n   const s=document.createElement('script');\n   for(const a of old.attributes){if(a.name!=='src')s.setAttribute(a.name,a.value)}\n   if(old.src)s.src=old.src;else s.textContent=old.textContent;\n   s.async=false;\n   document.head.appendChild(s);\n   if(s.src)await new Promise((resolve,reject)=>{s.onload=resolve;s.onerror=reject});\n  }\n  patchShell(shell);\n  wireLinks();\n  document.dispatchEvent(new Event('DOMContentLoaded'));\n  window.dispatchEvent(new Event('load'));\n  const q=query||'';\n  history.replaceState({},'',file+q);\n }catch(err){\n  console.error('[TAREFAS 2.4.9.1]',err);\n  const box=document.createElement('div');\n  box.style.cssText='position:fixed;inset:0;z-index:2147483647;background:#08120f;color:#fff;display:grid;place-items:center;padding:24px;font-family:Arial';\n  box.innerHTML='<div style=\"max-width:420px;text-align:center\"><strong style=\"font-size:20px\">Orçamentários</strong><p style=\"opacity:.8;line-height:1.5\">Não foi possível carregar a base Web 7.9.7 agora. Verifique sua conexão e tente novamente.</p><button style=\"padding:12px 18px;border:0;border-radius:10px\" id=\"tm2491Retry\">Tentar novamente</button></div>';\n  document.body.appendChild(box);\n  box.querySelector('#tm2491Retry')?.addEventListener('click',()=>{box.remove();load(file,query)});\n }finally{loading=false}\n}\nfunction patchDrawer(){\n const fix=()=>{\n  const d=document.getElementById('tmDrawer');if(!d)return;\n  d.querySelectorAll('[data-href]').forEach(b=>{\n   const h=b.dataset.href||'';\n   if(h==='orcamentarios.html'||h.startsWith('orcamentarios.html?')){\n    const q=new URLSearchParams(h.split('?')[1]||'');\n    b.dataset.href=QUERY[q.get('modulo')||'relatorio']||'orcamento_relatorio.html';\n   }\n  });\n };\n fix();\n new MutationObserver(fix).observe(document.body,{childList:true,subtree:true});\n}\nglobalThis.TarefasAlpha2491OrcWeb=Object.freeze({version:'2.4.9.1',webBase:WEB,webCommit:COMMIT,splitOrcamentarios:true,remoteWebSource:true});\nif(isOrc()){\n patchDrawer();\n const t=target();\n if(t){const [file,q='']=t.split('?');setTimeout(()=>load(file,q?'?'+q:''),0)}\n}\n})();",
    "css": ""
  },

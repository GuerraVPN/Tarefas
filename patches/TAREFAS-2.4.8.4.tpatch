{
  "format": "tarefas-tpatch-v1",
  "id": "2.4.8.4",
  "name": "TAREFAS 2.4.8.4 — Correção do layout do pedido de Desrelacionamento / Baixa",
  "patchVersion": 2,
  "createdAt": "2026-09-25T12:45:00Z",
  "baseVersion": "2.4.8",
  "minBuild": 290,
  "maxBuild": 290,
  "channel": "alpha",
  "cumulative": true,
  "replacementMode": "replace-older-same-base",
  "replaces": [
    "2.4.8.3"
  ],
  "description": "Corrige o layout móvel da tela de criação do pedido de Desrelacionamento / Baixa, reservando espaço para a navegação inferior e mantendo os botões de ação acessíveis.",
  "changelog": [
    "Corrige o recorte dos botões no rodapé do Novo pedido em telas Android com navegação inferior.",
    "O modal reserva espaço para a barra de navegação do aplicativo.",
    "O formulário passa a rolar internamente.",
    "Cancelar e Cadastrar pedido permanecem visíveis/acessíveis na área de ações.",
    "Compatível com safe-area e telas estreitas.",
    "Sem alteração das regras de cadastro."
  ],
  "order": 24804,
  "payload": {
    "js": "(()=>{'use strict';\nconst MARK='__TAREFAS_ALPHA_2484_PEDIDO_LAYOUT_FIX__';\nif(globalThis[MARK])return;\nglobalThis[MARK]=true;\nfunction ensurePedidoModalLayout(){\n  const bg=document.getElementById('newPedidoBg');\n  if(!bg)return false;\n  bg.classList.add('tm-2484-pedido-layout');\n  const modal=bg.querySelector('.orc-modal');\n  const form=bg.querySelector('#newPedidoForm');\n  const actions=bg.querySelector('.pedido-form-actions');\n  if(modal)modal.classList.add('tm-2484-pedido-modal');\n  if(form)form.classList.add('tm-2484-pedido-form');\n  if(actions)actions.classList.add('tm-2484-pedido-actions');\n  return true;\n}\nfunction boot(){\n  ensurePedidoModalLayout();\n  let tries=0;\n  const timer=setInterval(()=>{\n    ensurePedidoModalLayout();\n    if(++tries>=80)clearInterval(timer);\n  },125);\n  window.addEventListener('pageshow',ensurePedidoModalLayout);\n  window.addEventListener('focus',ensurePedidoModalLayout);\n}\nif(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();\nglobalThis.TarefasAlpha2484PedidoLayout=Object.freeze({version:'2.4.8.4',base:'2.4.8',build:290,pedidoModalScrollable:true,actionButtonsVisible:true});\n})();",
    "css": "/* Alpha 2.4.8.4 — pedido de Desrelacionamento/Baixa: não deixar os botões sob a navegação móvel */\n#newPedidoBg.tm-2484-pedido-layout{\n  align-items:flex-start!important;\n  justify-content:center!important;\n  overflow:hidden!important;\n  padding:7px 7px calc(82px + env(safe-area-inset-bottom))!important;\n  box-sizing:border-box!important;\n}\n#newPedidoBg.tm-2484-pedido-layout .tm-2484-pedido-modal{\n  width:min(980px,calc(100vw - 14px))!important;\n  max-width:calc(100vw - 14px)!important;\n  height:auto!important;\n  max-height:calc(100dvh - 96px - env(safe-area-inset-bottom))!important;\n  min-height:0!important;\n  margin:0 auto!important;\n  display:flex!important;\n  flex-direction:column!important;\n  overflow:hidden!important;\n  box-sizing:border-box!important;\n}\n#newPedidoBg.tm-2484-pedido-layout .tm-2484-pedido-modal .orc-modal-head{\n  flex:0 0 auto!important;\n  position:relative!important;\n  z-index:3!important;\n}\n#newPedidoBg.tm-2484-pedido-layout .tm-2484-pedido-form{\n  flex:1 1 auto!important;\n  min-height:0!important;\n  max-height:none!important;\n  overflow-y:auto!important;\n  overflow-x:hidden!important;\n  -webkit-overflow-scrolling:touch!important;\n  overscroll-behavior:contain!important;\n  padding:15px 15px calc(18px + env(safe-area-inset-bottom))!important;\n  box-sizing:border-box!important;\n}\n#newPedidoBg.tm-2484-pedido-layout .tm-2484-pedido-actions{\n  position:sticky!important;\n  bottom:0!important;\n  z-index:20!important;\n  flex:0 0 auto!important;\n  display:flex!important;\n  justify-content:stretch!important;\n  gap:8px!important;\n  background:var(--v4-surface,#101816)!important;\n  box-shadow:0 -8px 18px rgba(0,0,0,.32)!important;\n  padding:11px 15px calc(11px + env(safe-area-inset-bottom))!important;\n  margin:0 -15px!important;\n  width:calc(100% + 30px)!important;\n  box-sizing:border-box!important;\n}\n#newPedidoBg.tm-2484-pedido-layout .tm-2484-pedido-actions .orc-btn{\n  flex:1 1 0!important;\n  min-height:46px!important;\n  white-space:nowrap!important;\n  min-width:0!important;\n}\n@media(max-width:420px){\n  #newPedidoBg.tm-2484-pedido-layout .tm-2484-pedido-actions .orc-btn{\n    padding-left:8px!important;\n    padding-right:8px!important;\n    font-size:11px!important;\n  }\n}"
  },
  "payloadSha256": "744fe9d4acd6cb51407a8fd269550947f7b8402b93c093bd0cb2a20142894b27"

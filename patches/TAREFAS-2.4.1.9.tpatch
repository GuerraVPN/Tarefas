  "name": "TAREFAS 2.4.1.9 — Ocultar patches antigos já substituídos",
  "patchVersion": 9,
  "createdAt": "2026-09-23T06:45:00Z",
  "baseVersion": "2.4.1",
  "minBuild": 276,
  "maxBuild": 276,
  "channel": "alpha",
  "cumulative": true,
  "replacementMode": "replace-older-same-base",
  "replaces": [
    "2.4.1.1",

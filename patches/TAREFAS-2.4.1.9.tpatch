  "description": "Corrige o Gerenciador de Patches para não exibir patches antigos que já foram substituídos por um patch cumulativo instalado.",
  "changelog": [
    "Oculta patches oficiais anteriores ao patch cumulativo atualmente instalado.",
    "Impede que a Alpha 2.4.1.7 continue aparecendo depois da instalação da 2.4.1.8.",
    "Funciona mesmo quando o catálogo antigo ficou preso em cache na interface.",
    "Observador limitado a alterações de conteúdo, sem loop recursivo."
  ],
  "order": 9,
  "payload": {
    "js": ";(()=>{\n'use strict';\nconst MARK='__TAREFAS_ALPHA_2419_HIDE_SUPERSEDED__';\nif(globalThis[MARK])return;globalThis[MARK]=true;\nconst DB='tarefas-patches-v1',STORE='patches',BASE='2.4.1';\nfunction parts(v){return String(v||'').split('.').map(n=>Number(n)||0)}\nfunction cmp(a,b){const x=parts(a),y=parts(b),n=Math.max(x.length,y.length);for(let i=0;i<n;i++){const d=(x[i]||0)-(y[i]||0);if(d)return d}return 0}\nfunction dbAll(){return new Promise((resolve,reject)=>{const r=indexedDB.open(DB,1);r.onsuccess=()=>{const db=r.result;try{const q=db.transaction(STORE,'readonly').objectStore(STORE).getAll();q.onsuccess=()=>{resolve(q.result||[]);db.close()};q.onerror=()=>{resolve([]);db.close()}}catch(_){resolve([]);try{db.close()}catch(_){}}};r.onerror=()=>resolve([])})}\nfunction clean(root,max){if(!root||!max)return;root.querySelectorAll('[data-install-official]').forEach(btn=>{const id=String(btn.getAttribute('data-install-official')||'');if(id&&cmp(id,max)<0){const card=btn.closest('.tm-patch-item');if(card)card.remove()}});const cards=root.querySelectorAll('.tm-patch-item');if(root.id==='tmPatchOfficial'&&!root.querySelector('[data-install-official]')&&!cards.length){const empty=document.createElement('div');empty.className='tm-patch-empty';empty.textContent='Nenhum patch oficial novo para esta Beta.';root.appendChild(empty)}}\nasync function run(){const rows=await dbAll();const installed=rows.filter(p=>p&&p.enabled!==false&&String(p.baseVersion||'')===BASE);if(!installed.length)return;let max=installed[0].id;for(const p of installed)if(cmp(p.id,max)>0)max=p.id;const apply=()=>{const root=document.getElementById('tmPatchOfficial');if(root)clean(root,max)};apply();if(globalThis.__tm2419Observer)return;const mo=new MutationObserver(()=>apply());mo.observe(document.body,{childList:true,subtree:true});globalThis.__tm2419Observer=mo;window.addEventListener('tarefas:patch-official-refreshed',apply)}\nif(document.readyState==='loading')document.addEventListener('DOMContentLoaded',()=>run(),{once:true});else run();\n})();",
    "css": ""
  },
  "payloadSha256": "03190daa09b025e37b225e7191a9c61a0561d510b2af6483d06760eb6857ef84"
}

{
  "format": "tarefas-tpatch-v1",
  "id": "2.4.6.6",
  "name": "TAREFAS 2.4.6.6 — Serviços e Escalas unificados",
  "patchVersion": 1,
  "createdAt": "2026-09-24T01:30:00Z",
  "baseVersion": "2.4.6",
  "minBuild": 281,
  "maxBuild": 281,
  "channel": "alpha",
  "cumulative": true,
  "replacementMode": "replace-older-same-base",
  "replaces": [
    "2.4.6.1",

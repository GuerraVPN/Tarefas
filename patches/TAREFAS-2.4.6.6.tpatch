  "description": "Restaura o atalho Serviços na hotbar e unifica o acesso às três escalas oficiais através da mesma API dinâmica, removendo abas e componentes legados duplicados.",
  "changelog": [
    "Restaura o atalho Serviços na hotbar.",
    "Serviços abre diretamente o mesmo componente de Escalas usado pela aba principal.",
    "Mantém somente uma aba Escalas no grupo de Serviços.",
    "Remove abas, componentes e navegações de escala legados ou duplicados.",
    "Motorista PA, Patrulheiro e Permanência continuam vindo exclusivamente da API tarefas-escalas.",
    "Mantém somente leitura e elimina edição/gravação da interface.",
    "Mantém a remoção do Próximo Serviço."
  ],
  "order": 24606,
  "url": "https://raw.githubusercontent.com/GuerraVPN/Tarefas/app/releases/patches/TAREFAS-2.4.6.6.tpatch",
  "installable": true,
  "payloadSha256": "",
  "payload": {
    "js": "(()=>{'use strict';\nconst MARK='__TAREFAS_ALPHA_2466_PATCH__';\nif(globalThis[MARK])return;\nglobalThis[MARK]=true;\n\nconst API='https://bpvijatnsluwsgnzklrd.supabase.co/functions/v1/tarefas-escalas';\nconst KEYS=Object.freeze(['motorista_pa','patrulheiro','permanencia']);\nconst OLD_IDS=Object.freeze(['tmScales2461','tmScales2462','tmScales2463','tmScales2464','tmScales2465']);\nconst norm=v=>String(v??'').normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').trim().toLowerCase();\nconst esc=v=>String(v??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#039;'}[c]));\nconst session=()=>String(localStorage.getItem('tarefasPushSession17')||'').trim();\n\nfunction removeNext(){\n document.querySelectorAll('#kNextServiceCard,#kNextService,.tm-next-service-kpi,[data-tarefas-next-service],[data-next-service],.next-service-card').forEach(e=>e.remove());\n document.querySelectorAll('h1,h2,h3,h4,h5,h6,strong,b,p,span,button,a').forEach(el=>{\n  if(!el.children.length&&norm(el.textContent)==='proximo servico'){\n   el.closest('.tm-next-service-kpi,#kNextServiceCard,#kNextService,.dashboard-card,.v4-card,.card,article,section')?.remove();\n  }\n });\n}\n\nfunction removeLegacyScaleUi(){\n OLD_IDS.forEach(id=>document.getElementById(id)?.remove());\n document.querySelectorAll('[data-tarefas-scale2465],[data-tarefas-scale2464],[data-tarefas-scale2463],[data-tarefas-scale2462],[data-tarefas-scale2461],.tm243-scales-list,.tm2464-scales-list').forEach(e=>e.remove());\n document.querySelectorAll('a,button,[role=\"button\"],li,.nav-item,.menu-item,.tab-item,.hotbar-item,.drawer-item').forEach(el=>{\n  const t=norm(el.textContent),h=norm(el.getAttribute?.('href')||el.getAttribute?.('data-href'));\n  if(['pessoal / escalas','missões','missoes'].includes(t)||h==='pessoal.html'||h==='missao.html'){\n   (el.closest('.tm-drawer-item,.nav-item,.menu-item,.tab-item,.hotbar-item,.drawer-item,li')||el).remove();\n  }\n });\n}\n\nfunction removeDuplicateScaleEntries(){\n const seen=new Set();\n document.querySelectorAll('.tm-drawer-item,a,button,[role=\"button\"],li,.nav-item,.menu-item,.tab-item').forEach(el=>{\n  if(el.dataset.tarefasScale2466==='keep')return;\n  const t=norm(el.textContent);\n  const h=norm(el.getAttribute?.('href')||el.getAttribute?.('data-href'));\n  if(t==='escalas'||h==='#escalas'){\n   const item=el.closest('.tm-drawer-item,.nav-item,.menu-item,.tab-item,.hotbar-item,.drawer-item,li')||el;\n   if(seen.has(item.parentElement)){item.remove();return}\n   seen.add(item.parentElement);\n  }\n });\n}\n\nfunction getServicesContainer(){\n const drawer=document.getElementById('tmDrawer');\n if(drawer){\n  const groups=[...drawer.querySelectorAll('.tm-drawer-group,.drawer-section,.menu-section')];\n  const g=groups.find(x=>['serviços e pessoal','servicos e pessoal','serviços','servicos'].includes(norm(x.querySelector('h3,h4,strong')?.textContent)));\n  if(g)return g;\n }\n const candidates=[...document.querySelectorAll('li,.nav-item,.menu-item,.drawer-section,.menu-section,.hotbar-section')];\n return candidates.find(x=>['serviços e pessoal','servicos e pessoal','serviços','servicos'].includes(norm(x.querySelector('h3,h4,strong')?.textContent)))||null;\n}\n\nfunction ensureSingleScaleTab(){\n const container=getServicesContainer();\n if(!container)return;\n const existing=[...container.querySelectorAll('a,button,[role=\"button\"],li,.nav-item,.menu-item,.tab-item')].filter(el=>{\n  const t=norm(el.textContent),h=norm(el.getAttribute?.('href')||el.getAttribute?.('data-href'));\n  return t==='escalas'||h==='#escalas';\n });\n existing.forEach((el,i)=>{\n  if(i>0||el.dataset.tarefasScale2466!=='keep')el.remove();\n });\n if(container.querySelector('[data-tarefas-scale2466=\"keep\"]'))return;\n const b=document.createElement('button');\n b.type='button';\n b.className='tm-drawer-item';\n b.dataset.href='#escalas';\n b.dataset.tarefasScale2466='keep';\n b.innerHTML='<span><strong>Escalas</strong><small>Motorista, Patrulheiro e Permanência · somente leitura</small></span><span aria-hidden=\"true\">›</span>';\n b.addEventListener('click',e=>{e.preventDefault();e.stopImmediatePropagation();openScales()},true);\n container.appendChild(b);\n}\n\nfunction createModal(){\n document.getElementById('tmScales2466')?.remove();\n const wrap=document.createElement('div');\n wrap.id='tmScales2466';\n wrap.dataset.readOnly='true';\n wrap.setAttribute('aria-readonly','true');\n wrap.style.cssText='position:fixed;inset:0;z-index:2147483646;background:rgba(0,0,0,.58);display:flex;align-items:flex-end;justify-content:center;padding:12px';\n const box=document.createElement('section');\n box.setAttribute('role','dialog');box.setAttribute('aria-modal','true');\n box.style.cssText='width:min(600px,100%);max-height:86vh;overflow:auto;background:var(--v4-card,#101816);color:var(--v4-text,#fff);border:1px solid rgba(255,255,255,.12);border-radius:20px;padding:18px';\n box.innerHTML='<header style=\"display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px\"><div><strong style=\"font-size:20px\">Escalas</strong><div style=\"font-size:11px;opacity:.7;margin-top:3px\">Motorista · Patrulheiro · Permanência · somente leitura</div></div><button type=\"button\" data-close-scale aria-label=\"Fechar\" style=\"border:0;background:transparent;color:inherit;font-size:24px\">×</button></header><div data-scale-status style=\"font-size:12px;opacity:.75;margin-bottom:10px\">Consultando escalas…</div><div data-scale-list style=\"display:grid;gap:10px\"></div>';\n wrap.appendChild(box);document.documentElement.appendChild(wrap);\n wrap.addEventListener('click',e=>{if(e.target===wrap||e.target.closest('[data-close-scale]'))wrap.remove()});\n return wrap;\n}\n\nfunction normalize(payload){\n const source=payload?.escalas_externas||payload?.escalas||payload?.data?.escalas_externas||payload?.data?.escalas||{};\n if(!source||typeof source!=='object'||Array.isArray(source))return [];\n return KEYS.filter(k=>Object.prototype.hasOwnProperty.call(source,k)).map(key=>{\n  const value=source[key]&&typeof source[key]==='object'?source[key]:{};\n  return {key,...value};\n });\n}\n\nasync function fetchScales(){\n const token=session();\n if(token.length<32)throw new Error('Sessão de escalas indisponível. Faça login novamente.');\n const r=await fetch(API+'?escala=todas&cb='+Date.now(),{method:'GET',headers:{'x-tarefas-session':token,'Accept':'application/json','Cache-Control':'no-cache'},cache:'no-store'});\n if(!r.ok)throw new Error('API de escalas respondeu HTTP '+r.status+'.');\n const d=await r.json();\n if(d?.ok===false)throw new Error(d.error||'A API de escalas não retornou sucesso.');\n return normalize(d);\n}\n\nfunction renderEntry(entry){\n const matches=Array.isArray(entry.matches)?entry.matches:[];\n const title=String(entry.tipo||entry.key);\n const body=matches.length?matches.slice(0,20).map(m=>{\n  const vals=Array.isArray(m?.values)?m.values.slice(0,12).map(v=>'<code style=\"display:block;font-size:10px;line-height:1.45;padding:2px 0\">'+esc((v?.col!=null?'C'+v.col+': ':'')+String(v?.value??''))+'</code>').join(''):'';\n  return '<article data-scale-entry style=\"border:1px solid rgba(255,255,255,.1);border-radius:12px;padding:11px\"><div style=\"display:flex;justify-content:space-between;gap:10px;font-size:11px;font-weight:800\"><span>'+esc(m?.aba||'Planilha')+'</span><span style=\"opacity:.65\">linha '+esc(m?.row??'-')+'</span></div><div style=\"margin-top:6px;font-size:12px\">'+esc(m?.cell||'Registro encontrado')+(m?.date?' · '+esc(m.date):'')+'</div>'+vals+'</article>';\n }).join(''):'<div style=\"border:1px dashed rgba(255,255,255,.14);border-radius:12px;padding:12px;font-size:12px;opacity:.7\">Nenhum registro encontrado para este usuário.</div>';\n return '<section data-scale-card data-key=\"'+esc(entry.key)+'\" data-read-only=\"true\" aria-readonly=\"true\" style=\"border:1px solid rgba(255,255,255,.12);border-radius:14px;padding:13px\"><div style=\"display:flex;justify-content:space-between;gap:12px\"><strong>'+esc(title)+'</strong><span style=\"font-size:10px;opacity:.65\">'+esc(entry.key)+'</span></div><div style=\"font-size:11px;opacity:.65;margin:4px 0 9px\">'+esc(String(entry.total??matches.length))+' registro(s) · somente leitura</div><div style=\"display:grid;gap:8px\">'+body+'</div></section>';\n}\n\nasync function openScales(){\n const old=document.getElementById('tmScales2466');if(old){old.remove();return}\n removeLegacyScaleUi();\n const wrap=createModal(),status=wrap.querySelector('[data-scale-status]'),list=wrap.querySelector('[data-scale-list]');\n try{\n  const entries=await fetchScales();\n  status.textContent='Dados carregados da fonte oficial de escalas. Edição desabilitada.';\n  list.innerHTML=entries.length?entries.map(renderEntry).join(''):'<div style=\"padding:12px;opacity:.7\">Nenhuma das três escalas está disponível.</div>';\n }catch(err){\n  status.textContent='Não foi possível carregar as escalas.';\n  list.innerHTML='<div style=\"padding:12px;border:1px solid rgba(255,255,255,.12);border-radius:12px;font-size:12px\">'+esc(err?.message||err)+'</div>';\n }\n}\n\nfunction wireHotbar(){\n const btn=document.querySelector('.tm-bottom-nav [data-key=\"services\"]');\n if(!btn)return;\n btn.dataset.href='#servicos-escalas';\n btn.setAttribute('aria-label','Serviços');\n btn.dataset.tarefasServices2466='keep';\n const span=btn.querySelector('span');if(span)span.textContent='Serviços';\n if(!btn.__tarefasServices2466){\n  btn.__tarefasServices2466=true;\n  btn.addEventListener('click',e=>{e.preventDefault();e.stopImmediatePropagation();openScales()},true);\n }\n}\n\nfunction blockLegacyServiceNavigation(){\n document.addEventListener('click',e=>{\n  const el=e.target.closest?.('a,button,[role=\"button\"]');if(!el)return;\n  const t=norm(el.textContent),h=norm(el.getAttribute?.('href')||el.getAttribute?.('data-href'));\n  if(h==='pessoal.html'||h==='missao.html'||t==='pessoal / escalas'||t==='missões'||t==='missoes'){\n   e.preventDefault();e.stopImmediatePropagation();openScales();\n  }\n },true);\n}\n\nfunction boot(){\n removeNext();removeLegacyScaleUi();removeDuplicateScaleEntries();wireHotbar();ensureSingleScaleTab();blockLegacyServiceNavigation();\n let n=0;\n const tm=setInterval(()=>{removeNext();removeLegacyScaleUi();removeDuplicateScaleEntries();wireHotbar();ensureSingleScaleTab();if(++n>120)clearInterval(tm)},250);\n window.addEventListener('focus',()=>{removeLegacyScaleUi();removeDuplicateScaleEntries();wireHotbar();ensureSingleScaleTab()});\n window.addEventListener('pageshow',()=>{removeLegacyScaleUi();removeDuplicateScaleEntries();wireHotbar();ensureSingleScaleTab()});\n}\nif(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();\n\nglobalThis.TarefasAlpha2466Patch=Object.freeze({\n version:'2.4.6.6',base:'2.4.6',\n hotbarServices:true,\n hotbarOpensSameScale:true,\n singleScaleTab:true,\n api:'tarefas-escalas',\n readOnly:true,\n allowedKeys:['motorista_pa','patrulheiro','permanencia'],\n removeLegacy:true,\n removeNextService:true\n});\n})();",
    "css": ""
  }
}

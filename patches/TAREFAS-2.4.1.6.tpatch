  "description": "Transforma Escalas em item próprio da navegação, remove Missões e integra a IA às planilhas oficiais de Motorista, Patrulheiro e Permanência.",
  "changelog": [
    "Escalas agora aparece como item próprio no menu, sem o caminho Pessoal/Escalas.",
    "Remove a aba/link de Missões da navegação.",
    "Mantém apenas as escalas externas de Motorista, Patrulheiro e Permanência.",
    "A IA passa a consultar em modo somente leitura a aba Previsão das três planilhas oficiais.",
    "Remove Escala de Serviço e Missões antigas do contexto consultável pela IA.",
    "Perguntas como quem está de motorista amanhã, próxima permanência ou patrulheiro em uma data passam a usar os dados das planilhas.",
    "Mantém login biométrico sem duplicidade, correções de EXIT USERS/Reinício e sincronização de versão.",
    "Preserva Base Web 7.9.1 e todas as funções da Beta 2.4.1."
  ],
  "order": 241106,
  "payload": {
    "js": "(()=>{\n'use strict';\n\nconst PATCH_VERSION='2.4.1.6';\nconst BASE_VERSION='2.4.1';\nconst BASE_BUILD=276;\nconst WEB_VERSION='7.9.1';\nconst MARK='__TAREFAS_ALPHA_2416_BIOMETRIC_HANDOFF__';\nconst SYNC_KEY='tarefas2416VersionSyncAt';\nconst SITE_EXIT_KEY='tarefas_site_791_exit_seen';\nconst SITE_RESTART_KEY='tarefas_site_791_restart_seen';\nconst SESSION_KEY='tarefasPushSession17';\nconst USER_KEY='usuarioLogado';\nconst PROCESS_SESSION_KEY='tarefasSecureProcessSessionV1';\nconst SECURE_UNLOCK_KEY='tarefasSecureUnlocked23249';\nconst SECURE_LOCK_KEY='tarefasSecureLockRequired23249';\n\nif(globalThis[MARK])return;\nglobalThis[MARK]=true;\n\nglobalThis.__TAREFAS_EFFECTIVE_VERSION__=PATCH_VERSION;\nglobalThis.__TAREFAS_WEB_BASE_VERSION__=WEB_VERSION;\ndocument.documentElement.dataset.tarefasEffectiveVersion=PATCH_VERSION;\ndocument.documentElement.dataset.tarefasWebVersion=WEB_VERSION;\n\nconst page=()=>String(location.pathname.split('/').pop()||'index.html').toLowerCase();\nconst isLoginPage=()=>page()==='index.html'||page()==='';\nconst getClient=()=>{try{return typeof supabaseClient!=='undefined'?supabaseClient:null}catch(_){return null}};\nconst sessionToken=()=>String(localStorage.getItem(SESSION_KEY)||'').trim();\nconst currentUser=()=>{try{return JSON.parse(localStorage.getItem(USER_KEY)||'null')}catch(_){return null}};\n\nfunction applyLabels(){\n  try{\n    document.querySelectorAll('.tm-app-brand small').forEach(el=>{\n      const wanted=PATCH_VERSION+' • WEB '+WEB_VERSION;\n      if(el.textContent.trim()!==wanted)el.textContent=wanted;\n    });\n    document.querySelectorAll('[data-tarefas-version],[data-app-version],.tm-about-version').forEach(el=>{\n      const text=String(el.textContent||'');\n      if(!text||text.length>160)return;\n      const next=text\n        .replace(/\\b2\\.4\\.1(?:\\.[123])?\\b/g,PATCH_VERSION)\n        .replace(/\\b2\\.3\\.222\\.1\\b/g,BASE_VERSION);\n      if(next!==text)el.textContent=next;\n    });\n  }catch(_){}\n}\n\nfunction markFreshAuthentication(){\n  if(!isLoginPage())return false;\n  const token=sessionToken();\n  const user=currentUser();\n  if(token.length<32||!user?.id)return false;\n  try{\n    sessionStorage.setItem(PROCESS_SESSION_KEY,'1');\n    sessionStorage.setItem(SECURE_UNLOCK_KEY,'1');\n    sessionStorage.removeItem(SECURE_LOCK_KEY);\n    sessionStorage.setItem('tarefasFreshAuth2416',String(Date.now()));\n  }catch(_){}\n  window.dispatchEvent(new CustomEvent('tarefas:secure-unlocked',{detail:{version:PATCH_VERSION,source:'login-handoff',at:Date.now()}}));\n  return true;\n}\n\nfunction installLoginHandoff(){\n  if(!isLoginPage()||globalThis.__TAREFAS_LOGIN_HANDOFF_2416__)return;\n  globalThis.__TAREFAS_LOGIN_HANDOFF_2416__=true;\n  const nativeSet=Storage.prototype.setItem;\n  Storage.prototype.setItem=function(key,value){\n    const result=nativeSet.call(this,key,value);\n    try{\n      if(this===localStorage&&(String(key)===SESSION_KEY||String(key)===USER_KEY)){\n        queueMicrotask(markFreshAuthentication);\n      }\n    }catch(_){}\n    return result;\n  };\n}\n\nlet syncing=null;\nasync function syncRegisteredVersion({force=false}={}){\n  if(syncing)return syncing;\n  syncing=(async()=>{\n    const token=sessionToken();\n    const client=getClient();\n    if(!token||token.length<32||!client)return false;\n    if(!force){\n      const last=Number(localStorage.getItem(SYNC_KEY)||0);\n      if(last&&Date.now()-last<5*60*1000)return true;\n    }\n    const {data,error}=await client.rpc('v2_4_1_1_sync_app_version',{p_session_token:token,p_app_version:BASE_VERSION});\n    if(error)throw error;\n    if(data!==true)return false;\n    localStorage.setItem(SYNC_KEY,String(Date.now()));\n    window.dispatchEvent(new CustomEvent('tarefas:app-version-synced',{detail:{baseVersion:BASE_VERSION,effectiveVersion:PATCH_VERSION,build:BASE_BUILD}}));\n    window.dispatchEvent(new CustomEvent('v6:notificacoes:update'));\n    return true;\n  })().catch(err=>{\n    console.warn('[TAREFAS 2.4.1.6] Falha ao sincronizar versão do aparelho:',err?.message||err);\n    return false;\n  }).finally(()=>{syncing=null});\n  return syncing;\n}\n\nasync function seedSiteControlTokens(){\n  try{\n    const panel=globalThis.SitePanel791;\n    if(!panel)return false;\n    let state=panel.state?.()||null;\n    if(!state&&panel.refresh){try{await panel.refresh()}catch(_){}state=panel.state?.()||null}\n    if(!state)return false;\n    if(localStorage.getItem(SITE_EXIT_KEY)===null&&state.acao_pendente!=='exit_users')localStorage.setItem(SITE_EXIT_KEY,String(Number(state.exit_token||0)));\n    if(localStorage.getItem(SITE_RESTART_KEY)===null&&state.acao_pendente!=='reiniciar')localStorage.setItem(SITE_RESTART_KEY,String(Number(state.restart_token||0)));\n    return true;\n  }catch(err){\n    console.warn('[TAREFAS 2.4.1.6] Falha ao criar baseline do Painel SITE:',err?.message||err);\n    return false;\n  }\n}\n\nlet baselineTimer=null;\nlet baselineAttempts=0;\nfunction ensureSiteBaseline(){\n  if(baselineTimer)return;\n  baselineAttempts=0;\n  const tick=async()=>{\n    baselineAttempts++;\n    const ok=await seedSiteControlTokens();\n    if(ok||baselineAttempts>=20){clearInterval(baselineTimer);baselineTimer=null}\n  };\n  tick();\n  baselineTimer=setInterval(tick,500);\n}\n\nfunction scheduleSync(force=false){setTimeout(()=>syncRegisteredVersion({force}),250)}\n\ninstallLoginHandoff();\napplyLabels();\nensureSiteBaseline();\nscheduleSync(true);\n\nwindow.addEventListener('pageshow',()=>{applyLabels();ensureSiteBaseline();scheduleSync(false)});\nwindow.addEventListener('focus',()=>{applyLabels();ensureSiteBaseline();scheduleSync(false)});\nwindow.addEventListener('tarefas:push-session-ready',()=>{markFreshAuthentication();ensureSiteBaseline();scheduleSync(true)});\nwindow.addEventListener('tarefas:push-status',event=>{if(event?.detail?.ready===true){ensureSiteBaseline();scheduleSync(true)}});\ndocument.addEventListener('visibilitychange',()=>{if(!document.hidden){applyLabels();ensureSiteBaseline();scheduleSync(false)}});\n\nconst observer=new MutationObserver(records=>{\n  for(const record of records){\n    for(const node of record.addedNodes){\n      if(node.nodeType!==1)continue;\n      if(node.matches?.('.tm-app-brand,.tm-about-version,[data-tarefas-version],[data-app-version]')||node.querySelector?.('.tm-app-brand,.tm-about-version,[data-tarefas-version],[data-app-version]')){queueMicrotask(applyLabels);return}\n    }\n  }\n});\nobserver.observe(document.body,{childList:true,subtree:true});\n\nglobalThis.TarefasAlpha2416=Object.freeze({\n  patchVersion:PATCH_VERSION,\n  baseVersion:BASE_VERSION,\n  build:BASE_BUILD,\n  webVersion:WEB_VERSION,\n  markFreshAuthentication,\n  sync:()=>syncRegisteredVersion({force:true}),\n  baselineSite:seedSiteControlTokens,\n  refresh:applyLabels\n});\n})();\n;(()=>{\n'use strict';\nconst MARK='__TAREFAS_ALPHA_2416_EXTERNAL_SCALES__';\nif(globalThis[MARK])return;globalThis[MARK]=true;\nconst VERSION='2.4.1.6';\nconst LINKS=Object.freeze([\n{id:'motorista',label:'Escala de motorista',url:'https://docs.google.com/spreadsheets/d/1T_BM9KY0NLwVhlifetQ6W6AdetujQjx--zOZHa27eQs/edit?usp=drivesdk',icon:'🚙'},\n{id:'patrulheiro',label:'Escala de patrulheiro',url:'https://docs.google.com/spreadsheets/d/1_LlfIHx4EuSHkC9BOR2VorvXoaiMyLa028wU6C0dQLs/edit?usp=drivesdk',icon:'🛡️'},\n{id:'permanencia',label:'Escala de permanência',url:'https://docs.google.com/spreadsheets/d/13eEei_JdGjAdVo371BGfPS59QdYySe9lJ47DLjWb_x0/edit?usp=drivesdk',icon:'🏢'}\n]);\nconst page=()=>String(location.pathname.split('/').pop()||'').toLowerCase();\nfunction ensureCss(){\n if(document.getElementById('tmExternalScalesCss2415'))return;\n const s=document.createElement('style');s.id='tmExternalScalesCss2415';\n s.textContent='.v7-pessoal-sub a[data-v2415-scale]{display:flex!important;align-items:center;justify-content:space-between;gap:8px}.v7-pessoal-sub a[data-v2415-scale]::after{content:\"↗\";font-size:11px;opacity:.68}body.tm2415-legacy-scale .v7-page{display:none!important}body.tm2415-legacy-scale .v7-modal-bg{display:none!important}.tm2415-scales-page{padding:18px;max-width:1050px;margin:0 auto}.tm2415-scales-head{margin-bottom:16px}.tm2415-scales-head h2{margin:0 0 6px;font-size:22px}.tm2415-scales-head p{margin:0;color:var(--v4-muted,#64748b);font-size:12px;line-height:1.5}.tm2415-scales-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.tm2415-scale-card{display:flex;align-items:center;gap:12px;min-height:88px;padding:15px;border:1px solid var(--v4-border,#d7dce3);border-radius:15px;background:var(--v4-surface,#fff);color:var(--v4-text,#111827);text-decoration:none;box-shadow:0 5px 18px rgba(15,23,42,.07)}.tm2415-scale-card:hover{transform:translateY(-1px);border-color:var(--v4-accent,#2563eb)}.tm2415-scale-icon{width:48px;height:48px;display:grid;place-items:center;flex:0 0 auto;border-radius:13px;background:var(--v4-surface-3,#eef2f7);font-size:23px}.tm2415-scale-copy{min-width:0;flex:1}.tm2415-scale-copy strong{display:block;font-size:14px}.tm2415-scale-copy small{display:block;margin-top:4px;color:var(--v4-muted,#64748b);font-size:10px}.tm2415-scale-arrow{font-size:18px;opacity:.55}.tm2415-scales-note{margin-top:13px;padding:11px 12px;border:1px solid var(--v4-border,#d7dce3);border-radius:11px;background:var(--v4-surface-2,#f8fafc);font-size:10px;line-height:1.5;color:var(--v4-muted,#64748b)}@media(max-width:760px){.tm2415-scales-grid{grid-template-columns:1fr}.tm2415-scales-page{padding:13px}}';\n document.head.appendChild(s);\n}\nfunction makeScaleLink(row,className){\n const a=document.createElement('a');a.href=row.url;a.target='_blank';a.rel='noopener noreferrer external';a.className=className||'';a.dataset.v2415Scale=row.id;a.dataset.externalScale='1';return a;\n}\nfunction rewritePessoalNav(){return true}\nfunction renderLegacyScalePage(){\n const p=page();if(p!=='pessoal.html'&&p!=='missao.html')return false;if(document.getElementById('tmExternalScalesPage2415'))return true;\n const main=document.querySelector('.v7-main')||document.querySelector('main');if(!main)return false;ensureCss();document.body.classList.add('tm2415-legacy-scale');\n const header=main.querySelector('.v7-top b,.topbar b');if(header)header.textContent='Pessoal · Escalas';\n const host=document.createElement('section');host.id='tmExternalScalesPage2415';host.className='tm2415-scales-page';\n host.innerHTML='<div class=\"tm2415-scales-head\"><h2>Escalas</h2><p>As escalas de serviço e missão internas foram substituídas pelas planilhas oficiais abaixo.</p></div><div class=\"tm2415-scales-grid\"></div><div class=\"tm2415-scales-note\">Os links abrem as planilhas no Google Planilhas/Google Drive. Férias, dispensas e usuários continuam disponíveis no menu Pessoal.</div>';\n const grid=host.querySelector('.tm2415-scales-grid');\n for(const row of LINKS){const a=makeScaleLink(row,'tm2415-scale-card');a.innerHTML='<span class=\"tm2415-scale-icon\">'+row.icon+'</span><span class=\"tm2415-scale-copy\"><strong>'+row.label+'</strong><small>Abrir planilha oficial</small></span><span class=\"tm2415-scale-arrow\">↗</span>';grid.appendChild(a)}\n const oldPage=main.querySelector('.v7-page');if(oldPage)main.insertBefore(host,oldPage);else main.appendChild(host);return true;\n}\nlet scheduled=false;\nfunction refresh(){ensureCss();rewritePessoalNav();renderLegacyScalePage()}\nfunction schedule(){if(scheduled)return;scheduled=true;queueMicrotask(()=>{scheduled=false;refresh()})}\nrefresh();\nif(document.readyState==='loading')document.addEventListener('DOMContentLoaded',refresh,{once:true});\nwindow.addEventListener('pageshow',refresh);\nnew MutationObserver(mutations=>{for(const m of mutations){if(m.type!=='childList')continue;for(const node of [...m.addedNodes,...m.removedNodes]){if(!(node instanceof Element))continue;if(node.matches?.('.v7-pessoal-parent,.v7-pessoal-sub,.v7-main,.v7-page')||node.querySelector?.('.v7-pessoal-parent,.v7-pessoal-sub,.v7-main,.v7-page')){schedule();return}}}}).observe(document.documentElement,{childList:true,subtree:true});\nglobalThis.TarefasExternalScales2416=Object.freeze({version:VERSION,links:LINKS.map(x=>({...x})),refresh});\n})();\n;(()=>{\n'use strict';\nconst MARK='__TAREFAS_ALPHA_2416_SCALES_NAV__';\nif(globalThis[MARK])return;globalThis[MARK]=true;\nconst VERSION='2.4.1.6';\nconst LINKS=[\n{id:'motorista',label:'Motorista',url:'https://docs.google.com/spreadsheets/d/1T_BM9KY0NLwVhlifetQ6W6AdetujQjx--zOZHa27eQs/edit?usp=drivesdk'},\n{id:'patrulheiro',label:'Patrulheiro',url:'https://docs.google.com/spreadsheets/d/1_LlfIHx4EuSHkC9BOR2VorvXoaiMyLa028wU6C0dQLs/edit?usp=drivesdk'},\n{id:'permanencia',label:'Permanência',url:'https://docs.google.com/spreadsheets/d/13eEei_JdGjAdVo371BGfPS59QdYySe9lJ47DLjWb_x0/edit?usp=drivesdk'}\n];\nfunction css(){\n if(document.getElementById('tmScalesNavCss2416'))return;\n const s=document.createElement('style');s.id='tmScalesNavCss2416';\n s.textContent='.v2416-scales-parent{position:relative}.v2416-scales-sub{display:none;padding:4px 7px 9px 30px}.v2416-scales-parent:hover .v2416-scales-sub,.v2416-scales-parent.v62-subopen .v2416-scales-sub{display:grid}.v2416-scales-sub a{display:flex;align-items:center;justify-content:space-between;gap:8px;text-decoration:none;border:0;background:transparent;color:var(--v4-sidebar-text);border-radius:7px;padding:7px 8px;text-align:left;font-size:9px}.v2416-scales-sub a:hover{background:var(--v4-sidebar-hover);color:var(--v4-gold)}.v2416-scales-sub a::after{content:\"↗\";font-size:11px;opacity:.68}.v2416-scales-parent .v6-orc-arrow{transition:transform .15s}.v2416-scales-parent.v62-subopen .v6-orc-arrow{transform:rotate(180deg)}@media(max-width:900px){.v2416-scales-parent:hover .v2416-scales-sub{display:none}.v2416-scales-parent.v62-subopen .v2416-scales-sub{display:grid}.v2416-scales-parent>.v6-orc-main{min-height:48px;padding:12px 11px!important}.v2416-scales-sub a{min-height:42px;padding:10px 11px!important;font-size:11px!important}}';\n document.head.appendChild(s);\n}\nfunction icon(){return '<svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M16 3v4M8 3v4M3 10h18\"/></svg>'}\nfunction arrow(){return '<svg viewBox=\"0 0 24 24\"><path d=\"m8 10 4 4 4-4\"/></svg>'}\nfunction cleanOldPessoal(){\n const p=document.querySelector('.v7-pessoal-parent');if(!p)return;\n p.querySelectorAll('[data-v2415-scale],[data-v7-link=\"escala\"],[data-v7-link=\"missao\"],a[href=\"missao.html\"]').forEach(x=>x.remove());\n}\nfunction nav(){\n css();cleanOldPessoal();\n const list=document.querySelector('.sidebar ul');if(!list)return false;\n let li=list.querySelector('.v2416-scales-parent');\n if(!li){\n  li=document.createElement('li');li.className='v6-orc-parent v2416-scales-parent';\n  li.innerHTML='<a class=\"v6-orc-main\" href=\"#\" data-v2416-main><span class=\"v6-nav-icon\">'+icon()+'</span><span class=\"v6-nav-label\">Escalas</span><span class=\"v6-orc-arrow\">'+arrow()+'</span></a><div class=\"v2416-scales-sub\"></div>';\n  const pessoal=list.querySelector('.v7-pessoal-parent');if(pessoal)list.insertBefore(li,pessoal);else list.appendChild(li);\n }\n const sub=li.querySelector('.v2416-scales-sub');if(sub){sub.textContent='';for(const row of LINKS){const a=document.createElement('a');a.href=row.url;a.target='_blank';a.rel='noopener noreferrer external';a.textContent=row.label;a.dataset.v2416Scale=row.id;sub.appendChild(a)}}\n const main=li.querySelector('[data-v2416-main]');\n if(main&&main.dataset.wired!=='1'){main.dataset.wired='1';main.setAttribute('aria-haspopup','true');main.addEventListener('click',e=>{e.preventDefault();e.stopPropagation();li.classList.toggle('v62-subopen');main.setAttribute('aria-expanded',li.classList.contains('v62-subopen')?'true':'false')},true)}\n return true;\n}\nfunction pageTitle(){\n const p=String(location.pathname.split('/').pop()||'').toLowerCase();\n if(p!=='pessoal.html'&&p!=='missao.html')return;\n document.querySelectorAll('.v7-top b,.topbar b').forEach(x=>x.textContent='Escalas');\n const h=document.querySelector('#tmExternalScalesPage2415 .tm2415-scales-head h2');if(h)h.textContent='Escalas';\n const d=document.querySelector('#tmExternalScalesPage2415 .tm2415-scales-head p');if(d)d.textContent='Acesse as planilhas oficiais de Motorista, Patrulheiro e Permanência.';\n}\nfunction refresh(){nav();pageTitle()}\nrefresh();\nwindow.addEventListener('pageshow',refresh);\nlet queued=false;new MutationObserver(()=>{if(queued)return;queued=true;queueMicrotask(()=>{queued=false;refresh()})}).observe(document.documentElement,{childList:true,subtree:true});\nglobalThis.TarefasScalesNav2416=Object.freeze({version:VERSION,links:LINKS.map(x=>({...x})),refresh});\n})();",

{
  "format": "tarefas-tpatch-v1",
  "id": "2.4.1.6",
  "name": "TAREFAS 2.4.1.6 — Escalas externas + IA",
  "patchVersion": 6,
  "createdAt": "2026-09-22T19:35:00Z",
  "baseVersion": "2.4.1",

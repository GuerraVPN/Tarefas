  ],
  "description": "Corrige o travamento causado pelo observador de mutações do 2.4.6.3, mantendo a única entrada Escalas em Serviços e as três planilhas oficiais.",
  "changelog": [
    "Remove o ciclo de MutationObserver que podia travar a interface.",
    "Mantém somente uma entrada Escalas dentro de Serviços.",
    "Escalas continua abrindo Motorista PA, Patrulheiro e Permanência.",
    "Mantém os links oficiais e as correções anteriores do patch."
  ],
  "order": 24604,
  "url": "https://raw.githubusercontent.com/GuerraVPN/Tarefas/app/releases/patches/TAREFAS-2.4.6.4.tpatch",
  "installable": true,
  "payload": {
    "js": "(()=>{'use strict';\nconst MARK='__TAREFAS_ALPHA_2464_PATCH__';\nif(globalThis[MARK])return;\nglobalThis[MARK]=true;\nconst LINKS=[\n['Motorista PA','https://docs.google.com/spreadsheets/d/1T_BM9KY0NLwVhlifetQ6W6AdetujQjx--zOZHa27eQs/edit?usp=drivesdk'],\n['Patrulheiro','https://docs.google.com/spreadsheets/d/1_LlfIHx4EuSHkC9BOR2VorvXoaiMyLa028wU6C0dQLs/edit?usp=drivesdk'],\n['Permanência','https://docs.google.com/spreadsheets/d/13eEei_JdGjAdVo371BGfPS59QdYySe9lJ47DLjWb_x0/edit?usp=drivesdk']\n];\nfunction removeNext(){\n for(const e of document.querySelectorAll('#kNextServiceCard,#kNextService,.tm-next-service-kpi,[data-tarefas-next-service],[data-next-service],.next-service-card'))e.remove();\n for(const el of document.querySelectorAll('h1,h2,h3,h4,h5,h6,strong,b,p,span,button,a')){\n  if(!el.children.length&&String(el.textContent||'').normalize('NFD').replace(/[̀-ͯ]/g,'').trim().toLowerCase()==='proximo servico'){\n   const c=el.closest('.tm-next-service-kpi,#kNextServiceCard,#kNextService,.dashboard-card,.v4-card,.card,article,section');if(c)c.remove();\n  }\n }\n}\nfunction openScales(){\n const old=document.getElementById('tmScales2464');if(old){old.remove();return}\n const wrap=document.createElement('div');wrap.id='tmScales2464';\n wrap.style.cssText='position:fixed;inset:0;z-index:2147483646;background:rgba(0,0,0,.58);display:flex;align-items:flex-end;justify-content:center;padding:12px';\n const box=document.createElement('div');box.style.cssText='width:min(560px,100%);max-height:82vh;overflow:auto;background:var(--v4-card,#101816);color:var(--v4-text,#fff);border:1px solid rgba(255,255,255,.12);border-radius:20px;padding:18px';\n box.innerHTML='<div style=\"display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px\"><strong style=\"font-size:20px\">Escalas</strong><button type=\"button\" data-close-scale style=\"border:0;background:transparent;color:inherit;font-size:24px\">×</button></div><div data-scale-list style=\"display:grid;gap:8px\"></div>';\n const list=box.querySelector('[data-scale-list]');\n for(const [label,url] of LINKS){const a=document.createElement('a');a.href=url;a.target='_blank';a.rel='noopener noreferrer external';a.textContent=label;a.style.cssText='display:flex;align-items:center;justify-content:space-between;gap:12px;padding:15px 14px;border:1px solid rgba(255,255,255,.1);border-radius:12px;color:inherit;text-decoration:none;font-weight:800';const s=document.createElement('span');s.textContent='↗';s.style.opacity='.65';a.appendChild(s);list.appendChild(a)}\n wrap.appendChild(box);document.documentElement.appendChild(wrap);\n wrap.addEventListener('click',e=>{if(e.target===wrap||e.target.closest('[data-close-scale]'))wrap.remove()});\n}\nfunction removeExistingScales(){\n for(const el of document.querySelectorAll('a,button,[role=\"button\"],li,span')){\n  const t=String(el.textContent||'').trim().normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').toLowerCase();\n  if(t==='escalas' && el.dataset.tarefasScale2464!=='keep'){\n   const item=el.closest('li,.nav-item,.menu-item,.tab-item,.hotbar-item,.drawer-item')||el;\n   if(item)item.remove();\n  }\n }\n}\nfunction wireServices(){\n removeExistingScales();\n for(const el of document.querySelectorAll('a,button,[role=\"button\"],li,span,div')){\n  const t=String(el.textContent||'').trim().normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').toLowerCase();\n  if(t==='serviços e pessoal'||t==='servicos e pessoal'||t==='serviços'||t==='servicos'){\n   const box=el.closest('li,.nav-item,.menu-item,.drawer-section,.menu-section,.hotbar-section')||el.parentElement;\n   if(!box)continue;\n   const a=document.createElement('a');a.href='#escalas';a.textContent='Escalas';a.dataset.tarefasScale2464='keep';a.style.cssText='cursor:pointer';\n   a.addEventListener('click',e=>{e.preventDefault();e.stopImmediatePropagation();openScales()},true);\n   box.appendChild(a);\n   break;\n  }\n }\n}\nfunction wireLegacy(){\n for(const el of document.querySelectorAll('a,button,[role=\"button\"],li,span')){\n  const t=String(el.textContent||'').trim().normalize('NFD').replace(/[̀-ͯ]/g,'').toLowerCase();\n  if(t==='pessoal / escalas'||t==='missões'||t==='missoes'){const item=el.closest('li,.nav-item,.menu-item,.tab-item')||el;if(item)item.remove()}\n }\n for(const el of document.querySelectorAll('a,button,[role=\"button\"],[data-target],.nav-item,.tab-item')){\n  const t=String(el.textContent||'').trim().normalize('NFD').replace(/[̀-ͯ]/g,'').toLowerCase(),h=String(el.getAttribute?.('href')||'').toLowerCase();\n  if((t==='escalas'||h==='#escalas')&&el.dataset.tarefasScale2464!=='keep'&&el.dataset.tarefasScale2464!=='1'){el.dataset.tarefasScale2464='1';el.addEventListener('click',e=>{e.preventDefault();e.stopImmediatePropagation();openScales()},true)}\n }\n}\nfunction boot(){removeNext();wireLegacy();wireServices();let n=0;const tm=setInterval(()=>{removeNext();wireLegacy();wireServices();if(++n>120)clearInterval(tm)},250);window.addEventListener('focus',()=>{removeNext();wireLegacy();wireServices()});window.addEventListener('pageshow',()=>{removeNext();wireLegacy();wireServices()})}\nif(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();\nglobalThis.TarefasAlpha2464Patch=Object.freeze({version:'2.4.6.4',base:'2.4.6',servicesScales:true,singleScalesEntry:true,removeNextService:true,scalesGoogleLinks:true});\n})();",
    "css": ""
  },
  "payloadSha256": "a401c46295de98d7e7b8a4bf0d4690ff6c87330d1e3ef9daa0f6c491c1fca7f1"
}

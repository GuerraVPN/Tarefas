  "description": "Android independente: remove referências à Web, corrige o carregamento das Notas Fiscais e adiciona a aba logo abaixo de Guias.",
  "changelog": [
    "Remove do Android a identificação de Base Web e Web da versão.",
    "Corrige o carregamento das Notas Fiscais incluindo os formulários de Empresa e Nota Fiscal.",
    "Adiciona Notas Fiscais como aba visível imediatamente abaixo de Guias.",
    "Mantém o Orçamentários local do Android e não carrega uma base Web externa.",
    "Substitui cumulativamente o 2.4.9.2."
  ],
  "order": 24903,
  "payload": {
    "js": "(()=>{'use strict';const M='__TAREFAS_ALPHA_2493_APP_ONLY__';if(globalThis[M])return;globalThis[M]=true;\nconst modal=`<div class=\"nf-modal\" id=\"empresaModal\"><div class=\"nf-modal-card\"><div class=\"nf-modal-head\"><h3>Nova empresa</h3><button class=\"nf-close\" id=\"closeEmpresa\">×</button></div><form class=\"nf-form\" id=\"empresaForm\"><div class=\"nf-field full\"><label>Empresa *</label><input class=\"nf-input\" id=\"empresaNome\" required maxlength=\"160\" placeholder=\"Nome / razão social\"></div><div class=\"nf-field\"><label>CNPJ (opcional)</label><input class=\"nf-input\" id=\"empresaCnpj\" inputmode=\"numeric\" maxlength=\"18\" placeholder=\"Somente números\"></div><div class=\"nf-form-actions\"><button type=\"button\" class=\"orc-btn\" id=\"cancelEmpresa\">Cancelar</button><button type=\"submit\" class=\"orc-btn primary\">Cadastrar empresa</button></div></form></div></div><div class=\"nf-modal\" id=\"nfModal\"><div class=\"nf-modal-card\"><div class=\"nf-modal-head\"><h3>Nova Nota Fiscal</h3><button class=\"nf-close\" id=\"closeNF\">×</button></div><form class=\"nf-form\" id=\"nfForm\"><div class=\"nf-field\"><label>Nº da Nota Fiscal *</label><input class=\"nf-input\" id=\"nfNumero\" required maxlength=\"60\" placeholder=\"Ex.: 000123\"></div><div class=\"nf-field\"><label>Valor total *</label><input class=\"nf-input\" id=\"nfValor\" required type=\"number\" min=\"0\" step=\"0.01\" placeholder=\"0,00\"></div><div class=\"nf-field\"><label>Empresa na origem *</label><select class=\"nf-select\" id=\"nfEmpresa\" required></select></div><div class=\"nf-field\"><label>Depósito no destino *</label><select class=\"nf-select\" id=\"nfDeposito\" required></select></div><div class=\"nf-field full\"><label>Classificação do material *</label><select class=\"nf-select\" id=\"nfND\" required><option value=\"\">Selecione...</option><option value=\"30\">Material Consumo ND 30</option><option value=\"32\">Uso duradouro ND 32</option><option value=\"52\">Permanente ND 52</option></select></div><div class=\"nf-form-actions\"><button type=\"button\" class=\"orc-btn\" id=\"cancelNF\">Cancelar</button><button type=\"submit\" class=\"orc-btn primary\">Cadastrar Nota Fiscal</button></div></form></div></div>`;\nfunction clean(){document.querySelectorAll('.tm-app-brand small').forEach(e=>e.textContent='2.4.9');document.querySelectorAll('article,section,div').forEach(e=>{const t=e.querySelector('small')?.textContent?.trim()||'';if(/^Base web$/i.test(t))e.remove()});document.querySelectorAll('*').forEach(e=>{if(e.children.length===0&&/^Base web$/i.test((e.textContent||'').trim()))e.remove();if(e.children.length===0&&/^WEB\\s*[0-9.]+$/i.test((e.textContent||'').trim()))e.textContent=''})}\nclean();new MutationObserver(clean).observe(document.documentElement,{childList:true,subtree:true});\nconst oldAppend=Element.prototype.appendChild;if(!Element.prototype.__tm2493){\nElement.prototype.__tm2493=true;Element.prototype.appendChild=function(node){const out=oldAppend.call(this,node);if(node?.id==='tm2492NfWrap'&&!node.querySelector('#empresaModal')){node.insertAdjacentHTML('beforeend',modal)}return out};\n}\nconst addTab=()=>{const nav=document.getElementById('orcModuleNav');if(!nav||nav.querySelector('[data-tm2493-nf]'))return;nav.hidden=false;nav.removeAttribute('aria-hidden');nav.style.removeProperty('display');const b=document.createElement('button');b.type='button';b.className='orc-module-btn';b.dataset.tm2493Nf='1';b.textContent='🧾 Notas Fiscais';b.onclick=()=>document.querySelector('[data-tm2492-nf-trigger]')?.click();const g=nav.querySelector('[data-orc-module=\"guias\"]');if(g?.nextSibling)nav.insertBefore(b,g.nextSibling);else nav.appendChild(b)};\nconst obs=new MutationObserver(addTab);obs.observe(document.documentElement,{childList:true,subtree:true});addTab();setTimeout(()=>obs.disconnect(),15000);\n})();\n(()=>{'use strict';\nconst MARK='__TAREFAS_ALPHA_2493_NOTAS_FISCAIS__';\nif(globalThis[MARK])return;\nglobalThis[MARK]=true;\nconst CSS=\"\\nbody{margin:0;background:var(--v4-bg);color:var(--v4-text)}.orc-nf-page{padding:16px 18px 34px}.orc-module-nav{display:flex;gap:7px;flex-wrap:wrap;margin:0 0 12px}.orc-module-nav a{display:inline-flex;align-items:center;text-decoration:none;border:1px solid var(--v4-border);background:var(--v4-surface);color:var(--v4-text-2);padding:8px 10px;border-radius:9px;font-size:9px;font-weight:800}.orc-module-nav a:hover,.orc-module-nav a.active{border-color:var(--v4-accent);color:var(--v4-accent);background:var(--v4-accent-soft)}\\n.nf-layout{display:grid;grid-template-columns:minmax(230px,.42fr) minmax(420px,1.58fr);gap:12px;min-width:0}.nf-panel{background:var(--v4-surface);border:1px solid var(--v4-border);border-radius:12px;min-width:0}.nf-head{padding:13px 14px;border-bottom:1px solid var(--v4-border);display:flex;align-items:center;justify-content:space-between;gap:10px}.nf-head h3{font-size:12px;margin:0}.nf-head span{font-size:9px;color:var(--v4-muted)}.nf-body{padding:12px}.nf-actions{display:flex;gap:7px;flex-wrap:wrap}.nf-search{width:100%;box-sizing:border-box;padding:9px 10px;border:1px solid var(--v4-border-strong);border-radius:8px;background:var(--v4-surface-2);color:var(--v4-text);outline:none}.nf-select,.nf-input{width:100%;box-sizing:border-box;padding:9px 10px;border:1px solid var(--v4-border-strong);border-radius:8px;background:var(--v4-surface-2);color:var(--v4-text)}.nf-filters{display:grid;grid-template-columns:minmax(200px,1.5fr) 180px 210px;gap:8px;margin-bottom:10px}.nf-company{border:1px solid var(--v4-border);border-radius:9px;padding:10px;margin-bottom:7px;cursor:pointer;background:var(--v4-surface-2)}.nf-company:hover,.nf-company.active{border-color:var(--v4-accent);background:var(--v4-accent-soft)}.nf-company strong{display:block;font-size:10px}.nf-company small{display:block;color:var(--v4-muted);font-size:8px;margin-top:3px}.nf-note-card{border:1px solid var(--v4-border);border-radius:10px;padding:11px;margin-bottom:7px;cursor:pointer;background:var(--v4-surface-2)}.nf-note-card:hover,.nf-note-card.active{border-color:var(--v4-accent);box-shadow:0 0 0 2px var(--v4-accent-soft)}.nf-note-top{display:flex;justify-content:space-between;align-items:flex-start;gap:8px}.nf-note-top strong{font-size:11px}.nf-note-meta{font-size:8px;color:var(--v4-muted);line-height:1.5;margin-top:5px}.nf-status{display:inline-flex;padding:4px 7px;border-radius:999px;font-size:8px;font-weight:800;border:1px solid var(--v4-border-strong);white-space:nowrap}.nf-status.wait{color:var(--v4-warning);border-color:var(--v4-warning)}.nf-status.ok{color:var(--v4-success,#16a34a);border-color:var(--v4-success,#16a34a)}.nf-status.info{color:var(--v4-accent);border-color:var(--v4-accent)}.nf-detail{padding:15px}.nf-detail-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.nf-kv{padding:10px;border:1px solid var(--v4-border);border-radius:9px;background:var(--v4-surface-2)}.nf-kv small{display:block;font-size:8px;color:var(--v4-muted);margin-bottom:4px}.nf-kv b{font-size:10px;overflow-wrap:anywhere}.nf-section{margin-top:12px;padding-top:12px;border-top:1px solid var(--v4-border)}.nf-flow{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}.nf-step{padding:9px 7px;border-radius:8px;border:1px solid var(--v4-border);background:var(--v4-surface-2);font-size:8px;text-align:center;line-height:1.3}.nf-step.current{border-color:var(--v4-accent);background:var(--v4-accent-soft);color:var(--v4-accent);font-weight:800}.nf-step.done{border-color:var(--v4-success,#16a34a);color:var(--v4-success,#16a34a)}.nf-actions-bar{display:flex;gap:7px;align-items:center;flex-wrap:wrap}.nf-empty{text-align:center;padding:35px 10px;color:var(--v4-muted);font-size:10px}.nf-history-item{padding:8px 0;border-bottom:1px solid var(--v4-border)}.nf-history-item:last-child{border-bottom:0}.nf-history-item strong{font-size:9px}.nf-history-item p{margin:3px 0;font-size:8px;color:var(--v4-text-2)}.nf-history-item small{font-size:7px;color:var(--v4-muted)}.nf-modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.65);align-items:center;justify-content:center;z-index:200}.nf-modal.open{display:flex}.nf-modal-card{width:min(620px,94vw);max-height:90vh;overflow:auto;background:var(--v4-surface);border:1px solid var(--v4-border);border-radius:14px;box-shadow:0 20px 60px rgba(0,0,0,.35)}.nf-modal-head{padding:13px 15px;border-bottom:1px solid var(--v4-border);display:flex;justify-content:space-between;align-items:center}.nf-modal-head h3{font-size:13px}.nf-close{border:0;background:transparent;color:var(--v4-text);font-size:22px;cursor:pointer}.nf-form{padding:15px;display:grid;grid-template-columns:1fr 1fr;gap:9px}.nf-field.full{grid-column:1/-1}.nf-field label{display:block;font-size:8px;font-weight:800;margin-bottom:5px;color:var(--v4-text-2)}.nf-form-actions{grid-column:1/-1;display:flex;justify-content:flex-end;gap:7px;padding-top:5px}.nf-note-list{max-height:520px;overflow:auto}.nf-company-list{max-height:520px;overflow:auto}.nf-hero{background:var(--v4-surface);border:1px solid var(--v4-border);border-radius:12px;padding:14px;margin-bottom:12px}.nf-hero h3{font-size:14px;margin:0}.nf-hero p{font-size:9px;color:var(--v4-muted);margin-top:4px}@media(max-width:950px){.nf-layout{grid-template-columns:1fr}.nf-filters{grid-template-columns:1fr}.nf-flow{grid-template-columns:1fr 1fr}}@media(max-width:650px){.orc-nf-page{padding:10px}.orc-module-nav{overflow:auto;flex-wrap:nowrap}.orc-module-nav a{white-space:nowrap}.nf-detail-grid{grid-template-columns:1fr}.nf-form{grid-template-columns:1fr}.nf-field.full{grid-column:auto}}\\n\";\nconst HTML=\"\\n\\n<div class=\\\"nf-hero\\\"><h3>Notas Fiscais</h3><p>Cadastre a empresa uma vez e selecione-a na origem de cada nota. O destino é um depósito já cadastrado no Orçamentários.</p></div>\\n<div class=\\\"nf-layout\\\">\\n<section class=\\\"nf-panel\\\"><div class=\\\"nf-head\\\"><div><h3>Empresas</h3><span id=\\\"nfCompanyCount\\\">0 empresa(s)</span></div><div class=\\\"nf-actions\\\"><button class=\\\"orc-btn primary\\\" id=\\\"btnNovaEmpresa\\\">＋ Empresa</button></div></div><div class=\\\"nf-body\\\"><input class=\\\"nf-search\\\" id=\\\"nfCompanySearch\\\" placeholder=\\\"Buscar empresa...\\\"><div class=\\\"nf-company-list\\\" id=\\\"nfCompanyList\\\"><div class=\\\"nf-empty\\\">Carregando...</div></div></div></section>\\n<section class=\\\"nf-panel\\\"><div class=\\\"nf-head\\\"><div><h3>Notas Fiscais</h3><span id=\\\"nfListInfo\\\">0 nota(s)</span></div><div class=\\\"nf-actions\\\"><button class=\\\"orc-btn primary\\\" id=\\\"btnNovaNF\\\">＋ Nota Fiscal</button></div></div><div class=\\\"nf-body\\\"><div class=\\\"nf-filters\\\"><input class=\\\"nf-search\\\" id=\\\"nfSearch\\\" placeholder=\\\"Buscar nº, empresa ou depósito...\\\"><select class=\\\"nf-select\\\" id=\\\"nfStatus\\\"><option value=\\\"\\\">Todos os andamentos</option></select><select class=\\\"nf-select\\\" id=\\\"nfNDFiltro\\\"><option value=\\\"\\\">Todas as ND</option><option value=\\\"30\\\">Material Consumo ND 30</option><option value=\\\"32\\\">Uso duradouro ND 32</option><option value=\\\"52\\\">Permanente ND 52</option></select></div><div class=\\\"nf-note-list\\\" id=\\\"nfList\\\"><div class=\\\"nf-empty\\\">Carregando...</div></div></div></section>\\n</div>\\n<section class=\\\"nf-panel\\\" id=\\\"nfDetailPanel\\\" style=\\\"margin-top:12px\\\"><div class=\\\"nf-detail\\\" id=\\\"nfDetail\\\"><div class=\\\"nf-empty\\\">Selecione uma Nota Fiscal para visualizar os dados.</div></div></section>\\n\";\nconst NFJS=\"(function(){\\n'use strict';\\nif(window.__TAREFAS_NF_V797__)return;window.__TAREFAS_NF_V797__=true;\\nconst $=id=>document.getElementById(id);\\nconst esc=v=>String(v??'').replace(/[&<>\\\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#039;'}[c]));\\nconst norm=v=>String(v??'').normalize('NFD').replace(/[\\\\u0300-\\\\u036f]/g,'').trim().toLowerCase();\\nconst money=v=>Number(v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});\\nconst dt=v=>v?new Date(v).toLocaleString('pt-BR'):'-';\\nconst STATUS=[\\n {id:'aguardando_aprovacao_fiscal_administrativo',label:'Aguardando aprovação do Fiscal Administrativo'},\\n {id:'aguardando_inclusao_siscofis',label:'Aguardando inclusão no Siscofis'},\\n {id:'aguardando_inclusao_carga',label:'Aguardando inclusão em carga'},\\n {id:'pronto',label:'Pronto'}\\n];\\nconst ND={30:'Material Consumo ND 30',32:'Uso duradouro ND 32',52:'Permanente ND 52'};\\nlet user=null,canApprove=false,empresas=[],depositos=[],notas=[],selected=null,historico=[];\\nfunction profileId(){return user?.perfil_id!=null?Number(user.perfil_id):null}\\nasync function initUser(){\\n const base=JSON.parse(localStorage.getItem('usuarioLogado')||'null');if(!base?.id)return false;\\n user=base;\\n if(window.Perfis26){try{const p=await Perfis26.carregar(supabaseClient,base);user=p.usuario}catch(_){}}\\n const sec=norm(user.secao),pos=norm(user.posicao);\\n canApprove=sec==='admin'||(sec==='fiscalizacao'&&['chefe','auxiliar','fiscal administrativo','fiscal_administrativo'].includes(pos));\\n return true;\\n}\\nfunction timeout(p,ms,label){return Promise.race([p,new Promise((_,reject)=>setTimeout(()=>reject(new Error(label+' demorou mais de 7s.')),ms))])}\\nasync function loadData(){\\n const results=await Promise.allSettled([\\n   timeout(supabaseClient.from('orc_empresas').select('*').eq('ativo',true).order('nome'),7000,'Empresas'),\\n   timeout(supabaseClient.from('orc_depositos').select('id,nome').eq('ativo',true).order('ordem'),7000,'Depósitos'),\\n   timeout(supabaseClient.from('orc_notas_fiscais_resumo').select('*').order('criado_em',{ascending:false}),7000,'Notas Fiscais')\\n ]);\\n const e=results[0],d=results[1],n=results[2];\\n if(e.status==='fulfilled'&&!e.value.error)empresas=e.value.data||[];else throw new Error(e.status==='rejected'?e.reason?.message:(e.value?.error?.message||'Falha ao carregar empresas.'));\\n if(d.status==='fulfilled'&&!d.value.error)depositos=d.value.data||[];else throw new Error(d.status==='rejected'?d.reason?.message:(d.value?.error?.message||'Falha ao carregar depósitos.'));\\n if(n.status==='fulfilled'&&!n.value.error)notas=n.value.data||[];else throw new Error(n.status==='rejected'?n.reason?.message:(n.value?.error?.message||'Falha ao carregar notas fiscais.'));\\n fillSelects();renderEmpresas();renderNotas();\\n}\\nfunction fillSelects(){\\n $('nfEmpresa').innerHTML='<option value=\\\"\\\">Selecione...</option>'+empresas.map(x=>'<option value=\\\"'+x.id+'\\\">'+esc(x.nome)+(x.cnpj?' · CNPJ '+esc(x.cnpj):'')+'</option>').join('');\\n $('nfDeposito').innerHTML='<option value=\\\"\\\">Selecione...</option>'+depositos.map(x=>'<option value=\\\"'+x.id+'\\\">'+esc(x.nome)+'</option>').join('');\\n $('nfStatus').innerHTML='<option value=\\\"\\\">Todos os andamentos</option>'+STATUS.map(x=>'<option value=\\\"'+x.id+'\\\">'+x.label+'</option>').join('');\\n}\\nfunction statusBy(id){return STATUS.find(x=>x.id===id)||STATUS[0]}\\nfunction statusClass(id){return id==='pronto'?'ok':id==='aguardando_aprovacao_fiscal_administrativo'?'wait':'info'}\\nfunction renderEmpresas(){\\n const q=norm($('nfCompanySearch').value);\\n const arr=empresas.filter(x=>!q||norm(x.nome+' '+(x.cnpj||'')).includes(q));\\n $('nfCompanyCount').textContent=empresas.length+' empresa(s)';\\n $('nfCompanyList').innerHTML=arr.length?arr.map(x=>'<article class=\\\"nf-company '+(selected&&String(selected.empresa_id)===String(x.id)?'active':'')+'\\\" data-company=\\\"'+x.id+'\\\"><strong>'+esc(x.nome)+'</strong><small>'+(x.cnpj?'CNPJ '+esc(x.cnpj):'Sem CNPJ cadastrado')+'</small></article>').join(''):'<div class=\\\"nf-empty\\\">Nenhuma empresa encontrada.</div>';\\n}\\nfunction filteredNotas(){\\n const q=norm($('nfSearch').value),s=$('nfStatus').value,nd=$('nfNDFiltro').value;\\n return notas.filter(n=>{\\n   if(s&&n.status!==s)return false;if(nd&&String(n.nd)!==nd)return false;\\n   return !q||norm(n.numero+' '+n.empresa_origem+' '+n.deposito_destino+' '+n.natureza_material).includes(q);\\n });\\n}\\nfunction renderNotas(){\\n const arr=filteredNotas();$('nfListInfo').textContent=arr.length+' nota(s)';\\n $('nfList').innerHTML=arr.length?arr.map(n=>{const st=statusBy(n.status);return '<article class=\\\"nf-note-card '+(selected&&String(selected.id)===String(n.id)?'active':'')+'\\\" data-note=\\\"'+n.id+'\\\"><div class=\\\"nf-note-top\\\"><strong>NF '+esc(n.numero)+'</strong><span class=\\\"nf-status '+statusClass(n.status)+'\\\">'+esc(st.label)+'</span></div><div class=\\\"nf-note-meta\\\">'+esc(n.empresa_origem)+' → '+esc(n.deposito_destino)+'<br>'+esc(n.natureza_material)+' · '+money(n.valor_total)+'</div></article>'}).join(''):'<div class=\\\"nf-empty\\\">Nenhuma nota fiscal encontrada.</div>';\\n}\\nfunction renderDetail(){\\n const e=$('nfDetail');if(!selected){e.innerHTML='<div class=\\\"nf-empty\\\">Selecione uma Nota Fiscal para visualizar os dados.</div>';return}\\n const idx=STATUS.findIndex(x=>x.id===selected.status),st=statusBy(selected.status);\\n const steps=STATUS.map((x,i)=>'<div class=\\\"nf-step '+(i<idx?'done ':'')+(i===idx?'current':'')+'\\\">'+(i<idx?'✓ ':'')+esc(x.label)+'</div>').join('');\\n let button='';\\n if(selected.status!=='pronto'){\\n   const next=STATUS[idx+1];\\n   const first=selected.status==='aguardando_aprovacao_fiscal_administrativo';\\n   if(first&&!canApprove)button='<span style=\\\"font-size:9px;color:var(--v4-muted)\\\">Aguardando aprovação do Fiscal Administrativo.</span>';\\n   else button='<button class=\\\"orc-btn primary\\\" id=\\\"btnNfAdvance\\\">Avançar para: '+esc(next.label)+'</button>';\\n }\\n e.innerHTML='<div class=\\\"nf-detail\\\"><div class=\\\"nf-head\\\" style=\\\"padding:0 0 12px;border:0\\\"><div><h3>Nota Fiscal '+esc(selected.numero)+'</h3><span>Cadastrada em '+dt(selected.criado_em)+'</span></div><span class=\\\"nf-status '+statusClass(selected.status)+'\\\">'+esc(st.label)+'</span></div><div class=\\\"nf-detail-grid\\\"><div class=\\\"nf-kv\\\"><small>Número</small><b>'+esc(selected.numero)+'</b></div><div class=\\\"nf-kv\\\"><small>Valor total</small><b>'+money(selected.valor_total)+'</b></div><div class=\\\"nf-kv\\\"><small>Empresa na origem</small><b>'+esc(selected.empresa_origem)+'</b></div><div class=\\\"nf-kv\\\"><small>Depósito no destino</small><b>'+esc(selected.deposito_destino)+'</b></div><div class=\\\"nf-kv\\\"><small>Classificação</small><b>'+esc(ND[selected.nd]||selected.natureza_material)+'</b></div><div class=\\\"nf-kv\\\"><small>Andamento atual</small><b>'+esc(st.label)+'</b></div></div><div class=\\\"nf-section\\\"><h3 style=\\\"font-size:11px;margin-bottom:8px\\\">Andamento</h3><div class=\\\"nf-flow\\\">'+steps+'</div><div class=\\\"nf-section nf-actions-bar\\\">'+button+'</div></div><div class=\\\"nf-section\\\"><h3 style=\\\"font-size:11px;margin-bottom:6px\\\">Histórico</h3><div id=\\\"nfHistory\\\"><div class=\\\"nf-empty\\\">Carregando histórico...</div></div></div></div>';\\n if(selected.status!=='pronto' && (! (selected.status==='aguardando_aprovacao_fiscal_administrativo'&&!canApprove))) $('btnNfAdvance').onclick=advance;\\n loadHistory(selected.id);\\n}\\nasync function loadHistory(id){\\n const r=await timeout(supabaseClient.from('orc_notas_fiscais_historico').select('*').eq('nota_fiscal_id',id).order('criado_em',{ascending:false}),7000,'Histórico');\\n historico=r.error?[]:r.data||[];\\n const box=$('nfHistory');if(!box)return;\\n box.innerHTML=historico.length?historico.map(h=>'<div class=\\\"nf-history-item\\\"><strong>'+esc(statusBy(h.status_novo).label)+'</strong><p>'+esc(h.mensagem||'Andamento atualizado.')+'</p><small>'+dt(h.criado_em)+'</small></div>').join(''):'<div class=\\\"nf-empty\\\">Sem histórico.</div>';\\n}\\nasync function advance(){\\n if(!selected)return;\\n const i=STATUS.findIndex(x=>x.id===selected.status),next=STATUS[i+1];if(!next)return;\\n if(selected.status==='aguardando_aprovacao_
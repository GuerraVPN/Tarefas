{
  "format": "tarefas-tpatch-v1",
  "id": "2.3.25.3",
  "name": "TAREFAS 2.3.25.3 — Abas para diagnóstico",
  "patchVersion": 1,
  "createdAt": "2026-09-21T19:18:00Z",
  "baseVersion": "2.3.25",
  "minBuild": 272,
  "maxBuild": 272,
  "channel": "alpha",
  "cumulative": true,
  "replacementMode": "replace-older-same-base",
  "replaces": [
    "2.3.25.1",
    "2.3.25.2"
  ],
  "description": "Troca o antigo Salvar filtro atual por um seletor de abas para diagnóstico na Central de Ferramentas.",
  "changelog": [
    "O botão Salvar filtro atual foi substituído por Abas para diagnóstico.",
    "Agora é possível escolher quais páginas, abas e módulos entram na visualização da Central de Erros.",
    "Incluídas subabas da Central e módulos internos de Orçamentários no seletor.",
    "Por padrão, Todas as abas permanece ativo para preservar o diagnóstico existente.",
    "Quando abas específicas são escolhidas, a Central de Erros mostra somente os erros dessas áreas.",
    "Erros de outras abas continuam armazenados; o filtro não apaga histórico.",
    "A seção Filtros salvos em Ferramentas passa a mostrar Abas em diagnóstico.",
    "Mantidas as correções da 2.3.25.2 para CSS bruto e a base Web 7.9.1."
  ],
  "order": 232503,
  "payload": {
    "js": "(()=>{\n'use strict';\n\nconst PATCH_VERSION='2.3.25.3';\nconst BASE_VERSION='2.3.25';\nconst BASE_BUILD=272;\nconst WEB_VERSION='7.9.1';\nconst MARK='__TAREFAS_PATCH_23253_WEB_791_SAFE__';\n\nif(globalThis[MARK])return;\nglobalThis[MARK]=true;\n\nglobalThis.__TAREFAS_WEB_BASE_VERSION__=WEB_VERSION;\nglobalThis.__TAREFAS_EFFECTIVE_VERSION__=PATCH_VERSION;\ndocument.documentElement.dataset.tarefasWebVersion=WEB_VERSION;\ndocument.documentElement.dataset.tarefasEffectiveVersion=PATCH_VERSION;\n\nfunction repairRogueCssText(){\n  try{\n    const walker=document.createTreeWalker(document.body,NodeFilter.SHOW_TEXT);\n    const bad=[];\n    let node;\n    while((node=walker.nextNode())){\n      const parent=node.parentElement;\n      if(!parent||/^(STYLE|SCRIPT|TEXTAREA|PRE|CODE)$/i.test(parent.tagName))continue;\n      const value=String(node.nodeValue||'');\n      if(value.length<300)continue;\n      const aiCss=value.includes('.ai237-wrap{')||value.includes('.ai238-auto-file{');\n      const layoutCss=value.includes('@media(min-width:901px)')&&value.includes('body.v3-shell');\n      const cssDensity=(value.match(/\\{[^{}]{0,500}\\}/g)||[]).length>=6;\n      if((aiCss||layoutCss)&&cssDensity)bad.push(node);\n    }\n    for(const n of bad)n.remove();\n    return bad.length;\n  }catch(_){return 0}\n}\n\nfunction applyHeader(){\n  try{\n    document.querySelectorAll('.tm-app-brand small').forEach(el=>{\n      const wanted=PATCH_VERSION+' • WEB '+WEB_VERSION;\n      if(el.textContent.trim()!==wanted)el.textContent=wanted;\n    });\n  }catch(_){}\n}\n\nfunction applyKnownVersionLabels(){\n  try{\n    const selectors=[\n      '#tmVersionSync2325',\n      '#tmAppUpdates .tm-update-installed',\n      '.tm-about-version',\n      '[data-tarefas-version]',\n      '[data-app-version]'\n    ];\n    for(const selector of selectors){\n      document.querySelectorAll(selector).forEach(el=>{\n        if(el.closest('style,script'))return;\n        const text=String(el.textContent||'');\n        if(!text||text.length>160)return;\n        let next=text;\n        next=next.replace(/WEB\\s*7\\.8(?:\\.0|\\.1|\\.2|\\.6)?/ig,'WEB '+WEB_VERSION);\n        next=next.replace(/Base\\s*Web\\s*[:•-]?\\s*7\\.8(?:\\.0|\\.1|\\.2|\\.6)?/ig,'Base Web: '+WEB_VERSION);\n        if(next!==text)el.textContent=next;\n      });\n    }\n  }catch(_){}\n}\n\nlet queued=false;\nfunction refresh(){\n  queued=false;\n  repairRogueCssText();\n  applyHeader();\n  applyKnownVersionLabels();\n}\nfunction schedule(){\n  if(queued)return;\n  queued=true;\n  queueMicrotask(refresh);\n}\n\nrefresh();\n\nwindow.addEventListener('pageshow',schedule);\nwindow.addEventListener('focus',schedule);\nwindow.addEventListener('tarefas:versions-synced',schedule);\nwindow.addEventListener('tarefas:patch-official-refreshed',schedule);\ndocument.addEventListener('visibilitychange',()=>{if(!document.hidden)schedule()});\n\nconst observer=new MutationObserver(records=>{\n  for(const record of records){\n    for(const node of record.addedNodes){\n      if(node.nodeType===3){\n        const text=String(node.nodeValue||'');\n        if(text.includes('.ai237-wrap{')||text.includes('.ai238-auto-file{')){\n          schedule();\n          return;\n        }\n        continue;\n      }\n      if(node.nodeType!==1)continue;\n      if(\n        node.matches?.('.tm-app-brand,#tmAppUpdates,.tm-about-version,[data-tarefas-version],[data-app-version]') ||\n        node.querySelector?.('.tm-app-brand,#tmAppUpdates,.tm-about-version,[data-tarefas-version],[data-app-version]')\n      ){\n        schedule();\n        return;\n      }\n    }\n  }\n});\nobserver.observe(document.body,{childList:true,subtree:true});\n\nglobalThis.TarefasWebBase23253=Object.freeze({\n  patchVersion:PATCH_VERSION,\n  baseVersion:BASE_VERSION,\n  baseBuild:BASE_BUILD,\n  webVersion:WEB_VERSION,\n  repair:repairRogueCssText,\n  refresh\n});\n})();\n;(()=>{\n'use strict';\n\nconst PATCH_VERSION='2.3.25.3';\nconst MARK='__TAREFAS_DIAGNOSTIC_TABS_23253__';\nif(globalThis[MARK])return;\nglobalThis[MARK]=true;\n\nconst user=()=>{try{return JSON.parse(localStorage.getItem('usuarioLogado')||'null')}catch(_){return null}};\nconst uid=()=>user()?.id!=null?String(user().id):'anon';\nconst PREF_KEY=()=>`tarefas_diag_tabs_23253_${uid()}`;\nconst ALPHA_STATE_KEY=()=>`tarefas_alpha_23221_state_${uid()}`;\nconst esc=v=>String(v??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#039;'}[c]));\n\nconst BASE_TABS=[\n  ['Início','dashboard.html','Principal'],\n  ['Quadro','menu.html','Tarefas'],\n  ['Minhas tarefas','minhas_tarefas.html','Tarefas'],\n  ['Calendário','calendario.html','Tarefas'],\n  ['Pessoal / Escalas','pessoal.html','Serviços'],\n  ['Missões','missao.html','Serviços'],\n  ['Férias e dispensas','ferias_dispensas.html','Serviços'],\n  ['Central › Notificações','central.html?tab=notificacoes','Central'],\n  ['Central › Mensagens','central.html?tab=mensagens','Central'],\n  ['Central › Downloads','central.html?tab=downloads','Central'],\n  ['Central › Favoritos','central.html?tab=favoritos','Central'],\n  ['Central › Ferramentas','central.html?tab=ferramentas','Central'],\n  ['Jogos','games.html','Outros'],\n  ['Usuários','usuarios.html','Gestão'],\n  ['Relatórios','relatorios.html','Gestão'],\n  ['Orçamentários › Resumo','orcamentarios.html?modulo=relatorio','Orçamentários'],\n  ['Orçamentários › Guias','orcamentarios.html?modulo=guias','Orçamentários'],\n  ['Orçamentários › Baixas','orcamentarios.html?modulo=baixas','Orçamentários'],\n  ['Orçamentários › Distribuição','orcamentarios.html?modulo=distribuicao','Orçamentários'],\n  ['Orçamentários › Movimentação','orcamentarios.html?modulo=movimentacao','Orçamentários'],\n  ['Orçamentários › Material Carga','orcamentarios.html?modulo=material_carga','Orçamentários'],\n  ['Orçamentários › Passagem de Carga','orcamentarios.html?modulo=passagem_carga','Orçamentários'],\n  ['Orçamentários › Lavanderia','orcamentarios.html?modulo=lavanderia','Orçamentários'],\n  ['Histórico / Auditoria','historico_auditoria.html','Gestão'],\n  ['Configurações','configuracoes.html','Sistema'],\n  ['Ajuda','help.html','Sistema'],\n  ['Sobre','about.html','Sistema']\n].map(([label,route,group])=>({label,route,group}));\n\nfunction readPrefs(){\n  try{\n    const x=JSON.parse(localStorage.getItem(PREF_KEY())||'null');\n    if(x&&typeof x==='object'&&Array.isArray(x.tabs))return{all:x.all!==false,tabs:[...new Set(x.tabs.map(String))],updatedAt:x.updatedAt||null};\n  }catch(_){}\n  return{all:true,tabs:[],updatedAt:null};\n}\nfunction savePrefs(next){\n  const data={all:next.all!==false,tabs:[...new Set((next.tabs||[]).map(String))],updatedAt:new Date().toISOString()};\n  localStorage.setItem(PREF_KEY(),JSON.stringify(data));\n  window.dispatchEvent(new CustomEvent('tarefas:diagnostic-tabs',{detail:data}));\n  return data;\n}\nfunction readAlphaState(){\n  try{return JSON.parse(localStorage.getItem(ALPHA_STATE_KEY())||'{}')||{}}catch(_){return{}}\n}\n\nfunction normalizeRoute(value){\n  try{\n    const u=new URL(String(value||''),location.href);\n    const page=(u.pathname.split('/').pop()||'dashboard.html').toLowerCase();\n    if(page==='central.html'){\n      const tab=u.searchParams.get('tab');\n      return tab?page+'?tab='+tab:page;\n    }\n    if(page==='orcamentarios.html'){\n      const modulo=u.searchParams.get('modulo');\n      return modulo?page+'?modulo='+modulo:page;\n    }\n    return page;\n  }catch(_){\n    return String(value||'').split('#')[0].toLowerCase();\n  }\n}\nfunction monitored(route,prefs=readPrefs()){\n  if(prefs.all)return true;\n  const key=normalizeRoute(route);\n  return prefs.tabs.some(x=>normalizeRoute(x)===key);\n}\nfunction diagnosticErrors(){\n  const state=readAlphaState();\n  const rows=Array.isArray(state.errors)?state.errors:[];\n  const prefs=readPrefs();\n  return rows.filter(row=>monitored(row?.page||'',prefs));\n}\n\nfunction discoverTabs(){\n  const map=new Map(BASE_TABS.map(x=>[x.route,x]));\n  const add=(label,href,group='Descobertas')=>{\n    if(!href||/^(?:javascript:|mailto:|tel:|https?:)/i.test(href))return;\n    try{\n      const u=new URL(href,location.href);\n      if(u.origin!==location.origin)return;\n      const page=(u.pathname.split('/').pop()||'').toLowerCase();\n      if(!/\\.html$/i.test(page))return;\n      let route=page;\n      if(page==='central.html'&&u.searchParams.get('tab'))route+='?tab='+u.searchParams.get('tab');\n      if(page==='orcamentarios.html'&&u.searchParams.get('modulo'))route+='?modulo='+u.searchParams.get('modulo');\n      if(!map.has(route))map.set(route,{label:String(label||route).trim().slice(0,100),route,group});\n    }catch(_){}\n  };\n  document.querySelectorAll('a[href],[data-href],[data-url]').forEach(el=>add(\n    el.textContent||el.title||'Tela',\n    el.getAttribute('href')||el.getAttribute('data-href')||el.getAttribute('data-url')\n  ));\n  return [...map.values()].sort((a,b)=>a.group.localeCompare(b.group,'pt-BR')||a.label.localeCompare(b.label,'pt-BR'));\n}\n\nfunction ensureCss(){\n  if(document.getElementById('diagTabs23253Css'))return;\n  const s=document.createElement('style');\n  s.id='diagTabs23253Css';\n  s.textContent=`\n  #diagTabs23253{position:fixed;inset:0;z-index:2147483644;background:rgba(2,8,18,.78);display:flex;align-items:flex-end;justify-content:center;padding-top:50px}\n  #diagTabs23253 .dt-card{width:min(720px,100%);max-height:88dvh;background:var(--v4-surface,#0b1114);color:inherit;border:1px solid var(--v4-border,#263244);border-radius:20px 20px 0 0;display:flex;flex-direction:column;overflow:hidden}\n  #diagTabs23253 header{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px;border-bottom:1px solid var(--v4-border,#263244)}\n  #diagTabs23253 header h3{margin:0;font-size:16px}#diagTabs23253 header small{display:block;font-size:9px;opacity:.65;margin-top:3px}\n  #diagTabs23253 main{overflow:auto;padding:12px}\n  #diagTabs23253 .dt-all{display:flex;align-items:center;gap:10px;border:1px solid var(--v4-border,#263244);border-radius:12px;padding:11px;margin-bottom:12px;background:var(--v4-surface-2,#101820);font-weight:850}\n  #diagTabs23253 h4{margin:14px 0 7px;font-size:11px;opacity:.7}\n  #diagTabs23253 .dt-row{display:flex;align-items:center;gap:10px;border:1px solid var(--v4-border,#263244);border-radius:10px;padding:10px;margin-bottom:6px;background:var(--v4-surface-2,#101820)}\n  #diagTabs23253 .dt-row span{min-width:0}#diagTabs23253 .dt-row strong{display:block;font-size:11px}#diagTabs23253 .dt-row small{display:block;font-size:8px;opacity:.62;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n  #diagTabs23253 footer{display:flex;justify-content:space-between;gap:8px;padding:12px;border-top:1px solid var(--v4-border,#263244)}\n  #diagTabs23253 button{border:0;border-radius:9px;padding:9px 11px;background:var(--v4-surface-3,#162131);color:inherit;font-weight:850}#diagTabs23253 button.primary{background:var(--v4-accent,#2563eb);color:#fff}\n  .diag23253-chip{display:inline-block;margin:2px 4px 2px 0;padding:4px 7px;border-radius:999px;background:var(--v4-surface-3,#162131);font-size:8px;font-weight:800}\n  `;\n  document.head.appendChild(s);\n}\n\nfunction openSelector(){\n  ensureCss();\n  document.getElementById('diagTabs23253')?.remove();\n  const prefs=readPrefs(),tabs=discoverTabs();\n  const selected=new Set(prefs.tabs);\n  const modal=document.createElement('div');\n  modal.id='diagTabs23253';\n\n  let currentGroup='';\n  const rows=tabs.map(t=>{\n    const heading=t.group!==currentGroup?'<h4>'+esc(currentGroup=t.group)+'</h4>':'';\n    return heading+'<label class=\"dt-row\"><input type=\"checkbox\" data-route=\"'+esc(t.route)+'\" '+((prefs.all||selected.has(t.route))?'checked':'')+'><span><strong>'+esc(t.label)+'</strong><small>'+esc(t.route)+'</small></span></label>';\n  }).join('');\n\n  modal.innerHTML='<section class=\"dt-card\"><header><div><h3>🩺 Abas para diagnóstico</h3><small>Escolha quais telas aparecem na Central de Erros.</small></div><button type=\"button\" data-close>✕</button></header><main><label class=\"dt-all\"><input type=\"checkbox\" data-all '+(prefs.all?'checked':'')+'> Diagnosticar todas as abas</label><div data-rows>'+rows+'</div></main><footer><button type=\"button\" data-close>Cancelar</button><button type=\"button\" class=\"primary\" data-save>Salvar seleção</button></footer></section>';\n  document.body.appendChild(modal);\n\n  const all=modal.querySelector('[data-all]');\n  const boxes=[...modal.querySelectorAll('[data-route]')];\n  const syncDisabled=()=>{\n    boxes.forEach(b=>{b.disabled=all.checked;if(all.checked)b.checked=true});\n  };\n  all.onchange=()=>{\n    if(!all.checked&&prefs.all)boxes.forEach(b=>b.checked=true);\n    syncDisabled();\n  };\n  syncDisabled();\n\n  modal.querySelectorAll('[data-close]').forEach(b=>b.onclick=()=>modal.remove());\n  modal.addEventListener('click',e=>{if(e.target===modal)modal.remove()});\n  modal.querySelector('[data-save]').onclick=()=>{\n    const next=all.checked\n      ?{all:true,tabs:[]}\n      :{all:false,tabs:boxes.filter(b=>b.checked).map(b=>b.dataset.route)};\n    savePrefs(next);\n    modal.remove();\n    enhanceTools(true);\n  };\n}\n\nfunction renderDiagnosticSection(section){\n  if(!section)return;\n  const prefs=readPrefs(),rows=diagnosticErrors();\n  const h=section.querySelector('h4');\n  if(!h)return;\n\n  const head=h.parentElement?.querySelector('div[style]');\n  if(head){\n    h.textContent='🧯 Central de erros';\n    let badge=head.querySelector('[data-diag-summary]');\n    if(!badge){\n      badge=document.createElement('small');\n      badge.dataset.diagSummary='1';\n      badge.style.cssText='margin-left:auto;margin-right:8px;font-size:9px;opacity:.65';\n      head.insertBefore(badge,head.querySelector('[data-clear-errors]')||null);\n    }\n    badge.textContent=prefs.all?'Todas as abas':prefs.tabs.length+' aba(s)';\n  }\n\n  [...section.querySelectorAll('.a23221-tab-row,.a23221-tab-empty')].forEach(el=>el.remove());\n\n  if(!rows.length){\n    const empty=document.createElement('div');\n    empty.className='a23221-tab-empty';\n    empty.textContent=prefs.all?'Nenhum erro registrado.':'Nenhum erro registrado nas abas selecionadas.';\n    section.appendChild(empty);\n    return;\n  }\n\n  for(const row of rows){\n    const d=document.createElement('div');\n    d.className='a23221-tab-row';\n    const route=normalizeRoute(row.page||'');\n    d.innerHTML='<span><strong>'+esc(row.source||'erro')+' · '+esc(row.severity||'error')+'</strong><small class=\"a23221-error-msg\">'+esc(row.message||'')+' · '+esc(row.at?new Date(row.at).toLocaleString('pt-BR'):'')+' · '+esc(route)+'</small></span>';\n    section.appendChild(d);\n  }\n}\n\nlet enhancing=false;\nfunction enhanceTools(force=false){\n  if(enhancing)return;\n  const aux=document.getElementById('a23221-central-aux');\n  if(!aux||!aux.querySelector('.a23221-tab-body'))return;\n\n  const rawButton=aux.querySelector('[data-save-filter]');\n  const diagButton=aux.querySelector('[data-diagnostic-tabs]');\n\n  if(!rawButton&&!diagButton&&!force)return;\n  enhancing=true;\n  try{\n    if(rawButton){\n      const b=rawButton.cloneNode(true);\n      b.removeAttribute('data-save-filter');\n      b.dataset.diagnosticTabs='1';\n      b.querySelector('strong').textContent='🩺 Abas para diagnóstico';\n      b.querySelector('small').textContent='Selecione as telas que quer acompanhar';\n      b.onclick=openSelector;\n      rawButton.replaceWith(b);\n    }else if(diagButton){\n      diagButton.onclick=openSelector;\n    }\n\n    const sections=[...aux.querySelectorAll('.a23221-tab-section')];\n    const filterSection=sections.find(sec=>/Filtros salvos/i.test(sec.querySelector('h4')?.textContent||''));\n    if(filterSection){\n      const prefs=readPrefs(),tabs=discoverTabs();\n      const selected=prefs.all?tabs:tabs.filter(t=>prefs.tabs.includes(t.route));\n      filterSection.innerHTML='<h4>Abas em diagnóstico</h4>'+(prefs.all\n        ?'<div class=\"a23221-tab-empty\" style=\"padding:14px\">Todas as abas estão sendo diagnosticadas.</div>'\n        :selected.length\n          ?'<div>'+selected.map(t=>'<span class=\"diag23253-chip\">'+esc(t.label)+'</span>').join('')+'</div>'\n          :'<div class=\"a23221-tab-empty\" style=\"padding:14px\">Nenhuma aba selecionada.</div>');\n    }\n\n    const errorSection=[...aux.querySelectorAll('.a23221-tab-section')].find(sec=>/Central de erros/i.test(sec.textContent||''));\n    renderDiagnosticSection(errorSection);\n  }finally{\n    enhancing=false;\n  }\n}\n\nensureCss();\n\nif(document.readyState==='loading'){\n  document.addEventListener('DOMContentLoaded',()=>setTimeout(()=>enhanceTools(),0),{once:true});\n}else setTimeout(()=>enhanceTools(),0);\n\nconst observer=new MutationObserver(records=>{\n  if(enhancing)return;\n  let relevant=false;\n  for(const rec of records){\n    if(rec.target?.closest?.('#diagTabs23253'))continue;\n    for(const node of rec.addedNodes){\n      if(node.nodeType!==1)continue;\n      if(\n        node.matches?.('[data-save-filter],.a23221-tab-body') ||\n        node.querySelector?.('[data-save-filter],.a23221-tab-body')\n      ){\n        relevant=true;break;\n      }\n    }\n    if(relevant)break;\n  }\n  if(relevant)queueMicrotask(()=>enhanceTools());\n});\nobserver.observe(document.body,{childList:true,subtree:true});\n\nwindow.addEventListener('tarefas:alpha-state',()=>queueMicrotask(()=>enhanceTools(true)));\nwindow.addEventListener('tarefas:diagnostic-tabs',()=>queueMicrotask(()=>enhanceTools(true)));\n\nglobalThis.TarefasDiagnosticTabs23253=Object.freeze({\n  version:PATCH_VERSION,\n  preferences:readPrefs,\n  errors:diagnosticErrors,\n  open:openSelector,\n  refresh:()=>enhanceTools(true)\n});\n})();",
    "css": ""
  },
  "payloadSha256": "8277427c12f98579d15d8a944eb69441331ddfcc5d41ca508a5adaa4e252aa2e"
}

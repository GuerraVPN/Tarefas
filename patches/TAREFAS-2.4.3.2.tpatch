  "description": "Integra a tela Escalas ao Supabase, que valida a sessão do TAREFAS e consulta em tempo real os dados das planilhas Google via Apps Script, identificando o nome do usuário logado.",
  "changelog": [
    "Escalas deixa de abrir diretamente as planilhas Google.",
    "A tela passa a consultar o Supabase para validar a sessão do usuário.",
    "Supabase consulta a ponte Apps Script ligada às três planilhas.",
    "Patrulheiro passa a localizar automaticamente o nome do usuário logado.",
    "Incluídas as escalas Motorista PA, Patrulheiro e Permanência.",
    "Mantida a remoção de Pessoal / Escalas e Missões.",
    "O patch 2.4.3.2 substitui cumulativamente o 2.4.3.1."
  ],
  "order": 24302,
  "payload": {
    "js": "(()=>{ \n  'use strict';\n  const MARK='__TAREFAS_ALPHA_2432_ESCALAS__';\n  if(globalThis[MARK])return;\n  globalThis[MARK]=true;\n  const API='https://bpvijatnsluwsgnzklrd.supabase.co/functions/v1/tarefas-escalas';\n  const norm=v=>String(v??'').normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').replace(/\\s+/g,' ').trim().toLowerCase();\n  function user(){try{return JSON.parse(localStorage.getItem('usuarioLogado')||'null')}catch(_){return null}}\n  function session(){return String(localStorage.getItem('tarefasPushSession17')||'').trim()}\n  function hideOldMenu(root=document){\n    const els=[...root.querySelectorAll?.('a,button,li,[role=\"menuitem\"]')||[]];\n    els.forEach(el=>{\n      const href=norm(el.getAttribute?.('href')||el.dataset?.href||'');\n      const text=norm(el.textContent);\n      if(href.includes('pessoal.html')||href.includes('missao.html')||text==='pessoal / escalas'||text==='missões'){\n        const item=el.closest?.('li,[role=\"menuitem\"]')||el;\n        item.style.display='none';\n        item.setAttribute('data-tarefas-hidden-old-menu','true');\n      }\n    });\n  }\n  function esc(v){return String(v??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#039;'}[c]))}\n  function style(){\n    if(document.getElementById('tm2432-scale-style'))return;\n    const s=document.createElement('style');\n    s.id='tm2432-scale-style';\n    s.textContent=[\n      '.tm2432-back{position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:2147483000;display:flex;align-items:flex-end;justify-content:center}',\n      '.tm2432-panel{width:min(680px,100%);max-height:92vh;background:var(--card,#10151b);color:var(--text,#fff);border-radius:24px 24px 0 0;overflow:auto;box-shadow:0 -12px 50px rgba(0,0,0,.35);padding:18px}',\n      '.tm2432-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}',\n      '.tm2432-title{font-size:22px;font-weight:800}.tm2432-sub{opacity:.7;font-size:13px;margin-top:3px}',\n      '.tm2432-close{border:0;background:transparent;color:inherit;font-size:28px;padding:4px 8px}',\n      '.tm2432-tabs{display:flex;gap:8px;overflow:auto;margin:8px 0 14px}',\n      '.tm2432-tab{border:1px solid rgba(127,127,127,.28);background:transparent;color:inherit;border-radius:999px;padding:10px 13px;font-weight:700;white-space:nowrap}',\n      '.tm2432-tab.active{background:rgba(85,199,255,.16);border-color:rgba(85,199,255,.45)}',\n      '.tm2432-sync{width:100%;border:0;border-radius:14px;padding:12px 14px;background:rgba(85,199,255,.14);color:inherit;font-weight:800;margin-bottom:12px}',\n      '.tm2432-card{border:1px solid rgba(127,127,127,.18);border-radius:16px;padding:14px;margin:10px 0}',\n      '.tm2432-date{font-size:16px;font-weight:800}.tm2432-meta{font-size:12px;opacity:.65;margin-top:3px}',\n      '.tm2432-values{font-size:13px;line-height:1.5;margin-top:9px;opacity:.86;word-break:break-word}',\n      '.tm2432-empty{border:1px dashed rgba(127,127,127,.25);border-radius:16px;padding:18px;text-align:center;opacity:.75}',\n      '.tm2432-error{border:1px solid rgba(220,80,80,.35);background:rgba(220,80,80,.08);padding:14px;border-radius:14px}',\n      '.tm2432-source{font-size:11px;opacity:.5;margin-top:12px;text-align:center}'\n    ].join('');\n    document.head.appendChild(s);\n  }\n  async function requestScale(kind){\n    const token=session();\n    if(token.length<32)throw new Error('Sessão do TAREFAS ausente ou expirada. Faça login novamente.');\n    const r=await fetch(API,{method:'POST',headers:{'Content-Type':'application/json','x-tarefas-session':token},body:JSON.stringify({escala:kind})});\n    let data=null;try{data=await r.json()}catch(_){}\n    if(!r.ok||!data?.ok)throw new Error(data?.error||('Falha ao consultar a escala (HTTP '+r.status+').'));\n    return data;\n  }\n  function render(root,kind,data){\n    const box=root.querySelector('.tm2432-body');\n    const result=data?.escalas?.[kind];\n    const matches=Array.isArray(result?.matches)?result.matches:[];\n    if(!matches.length){\n      box.innerHTML='<div class=\"tm2432-empty\">Não encontrei seu nome nesta escala.<div class=\"tm2432-meta\">Usuário: '+esc((data?.usuario?.patente||'')+' '+(data?.usuario?.nome_guerra||''))+'</div></div>';\n      return;\n    }\n    box.innerHTML=matches.map(m=>{\n      const values=(m.values||[]).map(x=>esc((x.value||''))).join(' · ');\n      return '<div class=\"tm2432-card\"><div class=\"tm2432-date\">'+esc(m.date||'Data não identificada')+'</div><div class=\"tm2432-meta\">'+esc(m.aba||'')+' · linha '+esc(m.row)+' · coluna '+esc(m.col)+'</div><div class=\"tm2432-values\">'+esc(m.cell)+(values?' — '+values:'')+'</div></div>';\n    }).join('');\n  }\n  function openScale(kind='patrulheiro'){\n    style();\n    const old=document.getElementById('tm2432-scale-back');if(old)old.remove();\n    const u=user()||{};\n    const root=document.createElement('div');\n    root.id='tm2432-scale-back';root.className='tm2432-back';\n    root.innerHTML='<section class=\"tm2432-panel\" role=\"dialog\" aria-modal=\"true\">'+\n      '<div class=\"tm2432-head\"><div><div class=\"tm2432-title\">Escalas</div><div class=\"tm2432-sub\">'+esc((u.patente||'')+' '+(u.nome_guerra||''))+'</div></div><button class=\"tm2432-close\" type=\"button\" aria-label=\"Fechar\">×</button></div>'+\n      '<div class=\"tm2432-tabs\"><button class=\"tm2432-tab\" data-k=\"motorista_pa\">Motorista PA</button><button class=\"tm2432-tab\" data-k=\"patrulheiro\">Patrulheiro</button><button class=\"tm2432-tab\" data-k=\"permanencia\">Permanência</button></div>'+\n      '<button class=\"tm2432-sync\" type=\"button\">Sincronizar agora</button>'+\n      '<div class=\"tm2432-body\"><div class=\"tm2432-empty\">Carregando escala…</div></div>'+\n      '<div class=\"tm2432-source\">Google Sheets → Apps Script → Supabase → TAREFAS</div></section>';\n    document.body.appendChild(root);\n    const tabs=[...root.querySelectorAll('.tm2432-tab')],body=root.querySelector('.tm2432-body'),sync=root.querySelector('.tm2432-sync');\n    const close=()=>root.remove();\n    root.querySelector('.tm2432-close').addEventListener('click',close);\n    root.addEventListener('click',e=>{if(e.target===root)close()});\n    async function load(k){\n      tabs.forEach(t=>t.classList.toggle('active',t.dataset.k===k));\n      body.innerHTML='<div class=\"tm2432-empty\">Sincronizando com a planilha…</div>';\n      try{render(root,k,await requestScale(k))}catch(err){body.innerHTML='<div class=\"tm2432-error\">'+esc(err?.message||err)+'</div>'}\n    }\n    tabs.forEach(t=>t.addEventListener('click',()=>load(t.dataset.k)));\n    sync.addEventListener('click',()=>load(root.querySelector('.tm2432-tab.active')?.dataset.k||kind));\n    load(kind);\n  }\n  document.addEventListener('click',e=>{\n    const el=e.target?.closest?.('[data-href=\"#escalas\"],a[href=\"#escalas\"]');\n    if(!el)return;\n    e.preventDefault();e.stopPropagation();if(e.stopImmediatePropagation)e.stopImmediatePropagation();\n    openScale('patrulheiro');\n  },true);\n  hideOldMenu();\n  const mo=new MutationObserver(()=>hideOldMenu());\n  mo.observe(document.documentElement,{childList:true,subtree:true});\n  document.documentElement.dataset.tarefasAlpha2432='google-sheets-supabase';\n})();",
    "css": ""
  },
  "payloadSha256": "468abd5adf44c2c0c716a9ef7abc87baed81b4d754baa2478a3cc74e76e6307f"
}

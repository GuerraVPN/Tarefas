{
  "format": "tarefas-tpatch-v1",
  "id": "2.4.6.5",
  "name": "TAREFAS 2.4.6.5 — Hotbar de Escalas dinâmica e somente leitura",
  "patchVersion": 1,
  "createdAt": "2026-09-24T01:05:00Z",
  "baseVersion": "2.4.6",
  "minBuild": 281,
  "maxBuild": 281,
  "channel": "alpha",
  "cumulative": true,
  "replacementMode": "replace-older-same-base",
  "replaces": [
    "2.4.6.1",
    "2.4.6.2",
    "2.4.6.3",
    "2.4.6.4"
  ],
  "description": "Remove o componente legado de Escalas hardcoded da hotbar e passa a consumir dinamicamente as escalas do Google Planilhas pela API oficial de escalas do TAREFAS, em modo somente leitura.",
  "changelog": [
    "Remove do DOM os componentes e acessos legados de Pessoal / Escalas e Missões.",
    "A hotbar deixa de navegar para pessoal.html ao tocar em Escalas.",
    "Escalas passa a consultar a API tarefas-escalas, que faz a ponte com as planilhas Google.",
    "A interface aceita somente as chaves permitidas motorista_pa, patrulheiro e permanencia retornadas pela API.",
    "Os dados exibidos são somente leitura: não há edição, gravação ou abertura hardcoded de planilhas.",
    "Mantém a remoção do Próximo Serviço.",
    "Substitui integralmente as Alphas 2.4.6.1 até 2.4.6.4."
  ],
  "order": 24605,
  "url": "https://raw.githubusercontent.com/GuerraVPN/Tarefas/app/releases/patches/TAREFAS-2.4.6.5.tpatch",
  "installable": true,
  "payload": {
    "js": "(()=>{'use strict';\nconst MARK='__TAREFAS_ALPHA_2465_PATCH__';\nif(globalThis[MARK])return;\nglobalThis[MARK]=true;\n\nconst ESCALAS_EXTERNAS_API='https://bpvijatnsluwsgnzklrd.supabase.co/functions/v1/tarefas-escalas';\nconst ALLOWED_KEYS=Object.freeze(['motorista_pa','patrulheiro','permanencia']);\nconst LEGACY_SCALE_IDS=Object.freeze(['tmScales2461','tmScales2462','tmScales2463','tmScales2464','tmScales243']);\nconst norm=v=>String(v??'').normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').trim().toLowerCase();\nconst esc=v=>String(v??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#039;'}[c]));\nconst session=()=>String(localStorage.getItem('tarefasPushSession17')||'').trim();\n\nfunction removeNextService(){\n  document.querySelectorAll('#kNextServiceCard,#kNextService,.tm-next-service-kpi,[data-tarefas-next-service],[data-next-service],.next-service-card').forEach(e=>e.remove());\n  document.querySelectorAll('h1,h2,h3,h4,h5,h6,strong,b,p,span,button,a').forEach(el=>{\n    if(el.children.length)return;\n    if(norm(el.textContent)==='proximo servico'){\n      const c=el.closest('.tm-next-service-kpi,#kNextServiceCard,#kNextService,.dashboard-card,.v4-card,.card,article,section');\n      c?.remove();\n    }\n  });\n}\n\nfunction removeLegacyScaleDom(){\n  LEGACY_SCALE_IDS.forEach(id=>document.getElementById(id)?.remove());\n  document.querySelectorAll('.tm243-scales-list,.tm2464-scales-list,[data-tarefas-scale2464=\"legacy\"],[data-tarefas-scale2463=\"legacy\"]').forEach(e=>e.remove());\n  document.querySelectorAll('.tm-drawer-item,.tm-drawer-group button,.tm-bottom-nav button,a,[role=\"button\"],li').forEach(el=>{\n    const t=norm(el.textContent);\n    const h=norm(el.getAttribute?.('href'));\n    const dh=norm(el.getAttribute?.('data-href'));\n    if(['pessoal / escalas','missões','missoes'].includes(t)||h==='pessoal.html'||dh==='pessoal.html'||h==='missao.html'||dh==='missao.html'){\n      const item=el.closest('.tm-drawer-item,.hotbar-item,.nav-item,.menu-item,.tab-item,li');\n      if(item)item.remove();else el.remove();\n    }\n  });\n}\n\nfunction sheetBase(){\n  document.getElementById('tmScales2465')?.remove();\n  const wrap=document.createElement('div');\n  wrap.id='tmScales2465';\n  wrap.setAttribute('data-tarefas-scale-api','true');\n  wrap.dataset.readOnly='true';\n  wrap.setAttribute('aria-readonly','true');\n  wrap.style.cssText='position:fixed;inset:0;z-index:2147483646;background:rgba(0,0,0,.58);display:flex;align-items:flex-end;justify-content:center;padding:12px';\n  const box=document.createElement('section');\n  box.setAttribute('role','dialog');\n  box.setAttribute('aria-modal','true');\n  box.style.cssText='width:min(600px,100%);max-height:86vh;overflow:auto;background:var(--v4-card,#101816);color:var(--v4-text,#fff);border:1px solid rgba(255,255,255,.12);border-radius:20px;padding:18px';\n  box.innerHTML='<header style=\"display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px\"><div><strong style=\"font-size:20px\">Escalas</strong><div style=\"font-size:11px;opacity:.7;margin-top:3px\">Google Planilhas · somente leitura</div></div><button type=\"button\" data-close-scale aria-label=\"Fechar\" style=\"border:0;background:transparent;color:inherit;font-size:24px\">×</button></header><div data-scale-status style=\"font-size:12px;opacity:.75;margin-bottom:10px\">Consultando escalas…</div><div data-scale-list style=\"display:grid;gap:10px\"></div>';\n  wrap.appendChild(box);\n  document.documentElement.appendChild(wrap);\n  wrap.addEventListener('click',e=>{if(e.target===wrap||e.target.closest('[data-close-scale]'))wrap.remove()});\n  return wrap;\n}\n\nfunction normalizeEntries(payload){\n  const source=payload?.escalas||payload?.escalas_externas||payload?.data?.escalas||payload?.data?.escalas_externas||{};\n  if(!source||typeof source!=='object'||Array.isArray(source))return [];\n  return ALLOWED_KEYS.filter(key=>Object.prototype.hasOwnProperty.call(source,key)).map(key=>{\n    const value=(source[key]&&typeof source[key]==='object')?source[key]:{};\n    return {key,...value};\n  });\n}\n\nasync function fetchScales(){\n  const token=session();\n  if(token.length<32)throw new Error('Sessão de escalas indisponível. Faça login novamente.');\n  const u=ESCALAS_EXTERNAS_API+'?escala=todas&cb='+Date.now();\n  const r=await fetch(u,{method:'GET',headers:{'x-tarefas-session':token,'Cache-Control':'no-cache','Accept':'application/json'},cache:'no-store'});\n  if(!r.ok)throw new Error('API de escalas respondeu HTTP '+r.status+'.');\n  const d=await r.json();\n  if(d?.ok===false)throw new Error(d?.error||'A API de escalas não retornou sucesso.');\n  return normalizeEntries(d);\n}\n\nfunction entryCard(entry){\n  const matches=Array.isArray(entry.matches)?entry.matches:[];\n  const title=String(entry.tipo||entry.key);\n  const body=matches.length?matches.slice(0,20).map(m=>{\n    const values=Array.isArray(m?.values)?m.values.slice(0,12).map(v=>'<code style=\"display:block;font-size:10px;line-height:1.45;padding:2px 0\">'+esc((v?.col!=null?'C'+v.col+': ':'')+String(v?.value??''))+'</code>').join(''):'';\n    return '<article data-scale-entry style=\"border:1px solid rgba(255,255,255,.1);border-radius:12px;padding:11px;background:rgba(255,255,255,.025)\"><div style=\"display:flex;justify-content:space-between;gap:10px;font-size:11px;font-weight:800\"><span>'+esc(m?.aba||'Planilha')+'</span><span style=\"opacity:.65\">linha '+esc(m?.row??'-')+'</span></div><div style=\"margin-top:6px;font-size:12px\">'+esc(m?.cell||'Registro encontrado')+(m?.date?' · '+esc(m.date):'')+'</div>'+values+'</article>';\n  }).join(''):'<div style=\"border:1px dashed rgba(255,255,255,.14);border-radius:12px;padding:12px;font-size:12px;opacity:.7\">Nenhum registro encontrado para este usuário.</div>';\n  return '<section data-scale-card data-key=\"'+esc(entry.key)+'\" data-read-only=\"true\" aria-readonly=\"true\" style=\"border:1px solid rgba(255,255,255,.12);border-radius:14px;padding:13px\"><div style=\"display:flex;align-items:center;justify-content:space-between;gap:12px\"><strong>'+esc(title)+'</strong><span style=\"font-size:10px;font-weight:800;opacity:.65\">'+esc(entry.key)+'</span></div><div style=\"font-size:11px;opacity:.65;margin:4px 0 9px\">'+esc(String(entry.total??matches.length))+' registro(s) · somente leitura</div><div style=\"display:grid;gap:8px\">'+body+'</div></section>';\n}\n\nasync function openScales(){\n  const old=document.getElementById('tmScales2465');\n  if(old){old.remove();return}\n  removeLegacyScaleDom();\n  const wrap=sheetBase();\n  const status=wrap.querySelector('[data-scale-status]');\n  const list=wrap.querySelector('[data-scale-list]');\n  try{\n    const entries=await fetchScales();\n    if(!entries.length){\n      status.textContent='A API não retornou nenhuma das chaves permitidas.';\n      list.innerHTML='<div style=\"border:1px dashed rgba(255,255,255,.14);border-radius:12px;padding:12px;font-size:12px;opacity:.7\">Nenhuma escala disponível.</div>';\n      return;\n    }\n    status.textContent='Dados carregados do Google Planilhas. Nenhuma operação de edição está disponível.';\n    list.innerHTML=entries.map(entryCard).join('');\n  }catch(err){\n    status.textContent='Não foi possível carregar as escalas.';\n    list.innerHTML='<div style=\"border:1px solid rgba(255,255,255,.12);border-radius:12px;padding:12px;font-size:12px\">'+esc(err?.message||err)+'</div>';\n  }\n}\n\nfunction wireHotbar(){\n  const btn=document.querySelector('.tm-bottom-nav [data-key=\"services\"]');\n  if(!btn)return false;\n  const span=btn.querySelector('span');\n  if(span)span.textContent='Escalas';\n  btn.dataset.href='#escalas';\n  btn.setAttribute('aria-label','Escalas');\n  btn.dataset.tarefasScale2465='1';\n  if(!btn.__tarefasScale2465Click){\n    btn.__tarefasScale2465Click=true;\n    btn.addEventListener('click',e=>{e.preventDefault();e.stopImmediatePropagation();openScales()},true);\n  }\n  return true;\n}\n\nfunction wireDrawer(){\n  const drawer=document.getElementById('tmDrawer');\n  if(!drawer)return false;\n  removeLegacyScaleDom();\n  const groups=[...drawer.querySelectorAll('.tm-drawer-group')];\n  const group=groups.find(g=>['serviços e pessoal','servicos e pessoal','serviços'].includes(norm(g.querySelector('h3')?.textContent)));\n  if(!group)return false;\n  if(![...group.querySelectorAll('[data-href]')].some(el=>el.dataset.tarefasScale2465==='1')){\n    const b=document.createElement('button');\n    b.type='button';\n    b.className='tm-drawer-item';\n    b.dataset.href='#escalas';\n    b.dataset.tarefasScale2465='1';\n    b.innerHTML='<span><strong>Escalas</strong><small>Motorista, patrulheiro e permanência · Google Planilhas</small></span><span aria-hidden=\"true\">›</span>';\n    b.addEventListener('click',e=>{e.preventDefault();e.stopImmediatePropagation();openScales()},true);\n    group.appendChild(b);\n  }\n  return true;\n}\n\nfunction interceptLegacyClicks(){\n  document.addEventListener('click',e=>{\n    const more=e.target.closest?.('.tm-bottom-nav [data-key=\"more\"]');\n    if(more)setTimeout(()=>wireDrawer(),0);\n    const legacy=e.target.closest?.('.tm-drawer-item,a,button,[role=\"button\"]');\n    if(!legacy)return;\n    const t=norm(legacy.textContent);\n    const h=norm(legacy.getAttribute?.('href')||legacy.getAttribute?.('data-href'));\n    if(t==='pessoal / escalas'||t==='missões'||t==='missoes'||h==='pessoal.html'||h==='missao.html'){\n      e.preventDefault();e.stopImmediatePropagation();openScales();\n    }\n  },true);\n}\n\nfunction boot(){\n  removeLegacyScaleDom();\n  removeNextService();\n  wireHotbar();\n  wireDrawer();\n  interceptLegacyClicks();\n  let n=0;\n  const timer=setInterval(()=>{\n    n++;\n    removeLegacyScaleDom();\n    removeNextService();\n    wireHotbar();\n    wireDrawer();\n    if(n>=120)clearInterval(timer);\n  },250);\n  window.addEventListener('focus',()=>{removeLegacyScaleDom();removeNextService();wireHotbar();wireDrawer()});\n  window.addEventListener('pageshow',()=>{removeLegacyScaleDom();removeNextService();wireHotbar();wireDrawer()});\n}\n\nif(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();\n\nglobalThis.TarefasAlpha2465Patch=Object.freeze({\n  version:'2.4.6.5',\n  base:'2.4.6',\n  hotbarDynamicScales:true,\n  scalesApi:'tarefas-escalas',\n  readOnly:true,\n  allowedKeys:['motorista_pa','patrulheiro','permanencia'],\n  removeLegacyScaleDom:true,\n  removeNextService:true\n});\n})();",
    "css": ""
  },
  "payloadSha256": "1f44045e26f562dde031baa14726b55e047c32e5ec725b44f435827367a200ad"
}

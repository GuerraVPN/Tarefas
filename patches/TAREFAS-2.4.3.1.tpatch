{
  "format": "tarefas-tpatch-v1",
  "id": "2.4.3.1",
  "name": "TAREFAS 2.4.3.1 — Correção do menu Escalas",
  "patchVersion": 1,
  "createdAt": "2026-09-23T13:30:00Z",
  "baseVersion": "2.4.3",
  "minBuild": 278,
  "maxBuild": 278,
  "channel": "alpha",
  "cumulative": true,
  "replacementMode": "replace-older-same-base",
  "replaces": [],
  "description": "Patch Alpha cumulativo para remover definitivamente Pessoal / Escalas e Missões do menu móvel da base 2.4.3 e deixar somente Escalas.",
  "changelog": [
    "Remove do menu móvel Pessoal / Escalas.",
    "Remove do menu móvel Missões.",
    "Preserva a entrada Escalas já existente na base 2.4.3.",
    "Executa a limpeza somente sobre itens de menu, sem alterar páginas de conteúdo.",
    "Patch cumulativo da base 2.4.3."
  ],
  "order": 24301,
  "payload": {
    "js": "(()=>{ \n'use strict';\nconst MARK='__TAREFAS_ALPHA_2431_MENU_FIX__';\nif(globalThis[MARK])return;\nglobalThis[MARK]=true;\nconst norm=s=>String(s||'').replace(/\\s+/g,' ').trim().toLowerCase();\nfunction hideOldMenuItem(el){const item=el.closest?.('li,[role=\"menuitem\"]')||el;item.style.display='none';item.setAttribute('data-tarefas-hidden-old-menu','true');}\nfunction cleanup(root=document){\n const candidates=root.querySelectorAll?.(\"a[href*='pessoal.html'],a[href*='missao.html'],button,li,[role='menuitem']\")||[];\n candidates.forEach(el=>{const a=el.matches?.('a')?el:el.querySelector?.('a[href]');const href=norm(a?.getAttribute?.('href'));const text=norm(el.textContent);if(href.includes('pessoal.html')||href.includes('missao.html')||text==='pessoal / escalas'||text==='missões')hideOldMenuItem(el);});\n const direct=[...root.querySelectorAll?.(\"a,button,li,[role='menuitem']\")||[]];\n direct.forEach(el=>{const text=norm(el.textContent);if(text==='pessoal / escalas'||text==='missões')hideOldMenuItem(el);});\n}\nfunction run(){cleanup(document);setTimeout(()=>cleanup(document),80);setTimeout(()=>cleanup(document),300);setTimeout(()=>cleanup(document),800);}\nif(document.readyState==='loading')document.addEventListener('DOMContentLoaded',run,{once:true});else run();\ndocument.addEventListener('click',()=>setTimeout(()=>cleanup(document),0),true);\nlet timer=0;\nconst obs=new MutationObserver(()=>{if(timer)return;timer=setTimeout(()=>{timer=0;obs.disconnect();cleanup(document);obs.observe(document.body||document.documentElement,{childList:true,subtree:true});},50);});\nconst start=()=>obs.observe(document.body||document.documentElement,{childList:true,subtree:true});\nif(document.body)start();else document.addEventListener('DOMContentLoaded',start,{once:true});\ndocument.documentElement.dataset.tarefasAlpha2431='menu-fix';\n})();",
    "css": ""
  },
  "payloadSha256": "559df8cedbf13620cbcecbeeb76af6782158f882a0765582bc5fa6091b4b6d67"
}

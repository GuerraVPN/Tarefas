  "description": "Corrige exclusivamente o card Próximo serviço da tela inicial para buscar o próximo serviço confirmado do usuário logado diretamente em escala_servicos. A tela Escalas permanece com a integração Google Planilhas → Apps Script → Supabase.",
  "changelog": [
    "Corrige o Próximo serviço da tela inicial que podia calcular/puxar a pessoa errada.",
    "A tela inicial agora consulta escala_servicos filtrando diretamente pelo usuario_id do usuário logado.",
    "Seleciona a menor data futura do próprio usuário.",
    "Ao clicar, mantém a abertura da tela Escalas/Pessoal no dia correto e grava o usuário e serviço alvo para permitir seleção correta.",
    "Não altera a tela Escalas nem remove o acesso às planilhas Google.",
    "Mantém a correção de identificação de nome das versões anteriores."
  ],
  "order": 24305,
  "payload": {
    "js": "(()=>{'use strict';const MARK='__TAREFAS_ALPHA_2435_DASHBOARD_SERVICE_FIX__';if(globalThis[MARK])return;globalThis[MARK]=true;const API=window.__TAREFAS_ESCALAS_API__||'https://bpvijatnsluwsgnzklrd.supabase.co/functions/v1/tarefas-escalas';const norm=v=>String(v??'').normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').replace(/\\s+/g,' ').trim().toLowerCase();const user=()=>{try{return JSON.parse(localStorage.getItem('usuarioLogado')||'null')}catch(_){return null}};const client=()=>{try{return typeof supabaseClient!=='undefined'?supabaseClient:null}catch(_){return null}};const iso=d=>`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;const br=s=>{const [y,m,d]=String(s).split('-').map(Number);return new Date(y,m-1,d).toLocaleDateString('pt-BR')};const day=s=>{const [y,m,d]=String(s).split('-').map(Number);return new Date(y,m-1,d).toLocaleDateString('pt-BR',{weekday:'short',day:'2-digit',month:'2-digit'}).replace('.','').toUpperCase()};const label={sargento:'Sargentos',motorista:'Motoristas',patrulheiro:'Patrulheiros',permanencia:'Permanência',canil:'Permanência/Canil'};async function q(table,select,build){const c=client();if(!c)return[];try{let x=c.from(table).select(select);if(build)x=build(x);const r=await x;return r.error?[]:(r.data||[])}catch(_){return[]}}function setCard(s){const card=document.getElementById('kNextServiceCard');if(!card)return;const main=card.querySelector('#kNextService'),sub=card.querySelector('#kNextServiceSub');if(!s){main.textContent='—';sub.textContent='Sem próximo serviço confirmado';card.dataset.state='empty';return}main.textContent=day(s.data_servico);sub.textContent=`${s.marcacao||'SV'} · ${label[s.grupo]||s.grupo} · serviço de ${s.nome||'seu usuário'}`;card.dataset.state='confirmed';const open=()=>{try{localStorage.setItem('tarefas_v743_period',JSON.stringify({mode:'day',anchor:s.data_servico,targetUsuarioId:Number(s.usuario_id),targetGrupo:s.grupo,targetServiceId:Number(s.id)}))}catch(_){}location.href='pessoal.html'};card.onclick=open;card.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();open()}};card.title=`Seu serviço em ${br(s.data_servico)}`;}async function load(){const u=user(),c=client();if(!u?.id||!c){setCard(null);return}const today=iso(new Date());const rows=await q('escala_servicos','id,grupo,usuario_id,data_servico,marcacao,observacao',x=>x.eq('usuario_id',Number(u.id)).gte('data_servico',today).order('data_servico',{ascending:true}).order('id',{ascending:true}).limit(1));if(rows.length){const users=await q('usuarios','id,patente,nome_guerra',x=>x.eq('id',Number(u.id)).limit(1));const n=users[0]?[users[0].patente,users[0].nome_guerra].filter(Boolean).join(' '):'seu usuário';setCard({...rows[0],nome:n});}else setCard(null)}function start(){load();setTimeout(load,1200);setTimeout(load,5000)}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start,{once:true});else start();window.addEventListener('focus',()=>load());window.addEventListener('online',()=>load());})();",
    "css": ""
  },
  "payloadSha256": "de0eb59fa59c71c6ff1030e6210d8d7910ab993cd5f8585a31ca60295d87c583"
}

{
  "format": "tarefas-tpatch-v1",
  "id": "2.4.8.5",
  "name": "TAREFAS 2.4.8.5 — Restaurar Pessoal, Escala, Férias/Dispensas e Usuários",
  "patchVersion": 1,
  "createdAt": "2026-09-25T13:30:00Z",
  "baseVersion": "2.4.8",
  "minBuild": 290,
  "maxBuild": 290,
  "channel": "alpha",
  "cumulative": true,
  "replacementMode": "replace-older-same-base",
  "replaces": [
    "2.4.8.4"
  ],
  "description": "Restaura no menu Android a área Serviços e pessoal com Escala de serviço, Férias e dispensas e Usuários, mantendo Missões removida.",
  "changelog": [
    "Restaura a seção Serviços e pessoal no menu lateral do aplicativo.",
    "Escala de serviço volta a aparecer e abre pessoal.html.",
    "Férias e dispensas volta a aparecer e abre ferias_dispensas.html.",
    "Usuários volta a aparecer dentro de Serviços e pessoal.",
    "Remove duplicação de Usuários na área Gestão.",
    "Mantém Missões fora do menu, conforme a navegação atual."
  ],
  "order": 24805,
  "payload": {
    "js": "(()=>{'use strict';\nconst MARK='__TAREFAS_ALPHA_2485_PERSONAL_MENU_FIX__';if(globalThis[MARK])return;globalThis[MARK]=true;\nconst ITEMS=[['Escala de serviço','pessoal.html','Escala Preta, Vermelha, SV/TSV e serviços'],['Férias e dispensas','ferias_dispensas.html','Férias, dispensas e saldos'],['Usuários','usuarios.html','Cadastros, perfis e acessos']];\nconst esc=v=>String(v??'').replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]));\nconst active=href=>{const[p,q='']=href.split('?'),cur=(location.pathname.split('/').pop()||'index.html').toLowerCase();if(p!==cur)return false;if(!q)return !location.search;return new URLSearchParams(q).toString()===new URLSearchParams(location.search).toString()};\nfunction makeItem(name,href,desc){const b=document.createElement('button');b.type='button';b.className='tm-drawer-item tm-2485-personal-item'+(active(href)?' active':'');b.dataset.href=href;b.innerHTML='<span><strong>'+esc(name)+'</strong><small>'+esc(desc)+'</small></span><span aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"m9 18 6-6-6-6\"/></svg></span>';b.addEventListener('click',()=>{location.href=href});return b}\nfunction normalizeDrawer(){const drawer=document.getElementById('tmDrawer');if(!drawer||drawer.dataset.tm2485Fixed==='1')return false;const body=drawer.querySelector('.tm-sheet-body');if(!body)return false;let group=[...body.querySelectorAll('.tm-drawer-group')].find(g=>(g.querySelector('h3')?.textContent||'').trim().toLowerCase()==='serviços e pessoal');if(!group){group=document.createElement('div');group.className='tm-drawer-group';const ref=[...body.querySelectorAll('.tm-drawer-group')].find(g=>(g.querySelector('h3')?.textContent||'').trim().toLowerCase()==='comunicação');group.innerHTML='<h3>Serviços e pessoal</h3>';body.insertBefore(group,ref||null)}group.querySelectorAll('.tm-drawer-item').forEach(x=>{const h=x.dataset.href||'',t=(x.textContent||'').trim().toLowerCase();if(h==='usuarios.html'||h==='missao.html'||t==='usuários'||t==='pessoal / escalas'||t==='missões'||t==='missoes')x.remove()});const managed=[...group.querySelectorAll('.tm-drawer-item')];managed.forEach(x=>{if(x.dataset.href==='pessoal.html'||x.dataset.href==='ferias_dispensas.html')x.remove()});for(const[it,href,desc]of ITEMS)group.appendChild(makeItem(it,href,desc));[...body.querySelectorAll('.tm-drawer-group')].forEach(g=>{if((g.querySelector('h3')?.textContent||'').trim().toLowerCase()==='gestão')g.querySelectorAll('[data-href=\"usuarios.html\"]').forEach(x=>x.remove())});drawer.dataset.tm2485Fixed='1';return true}\nfunction start(){normalizeDrawer();const obs=new MutationObserver(()=>normalizeDrawer());obs.observe(document.body,{childList:true,subtree:true});setTimeout(()=>obs.disconnect(),15000)}\nif(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start,{once:true});else start();\nglobalThis.TarefasAlpha2485PersonalMenu=Object.freeze({version:'2.4.8.5',base:'2.4.8',build:290,servicesPersonalRestored:true,scaleServiceVisible:true,vacationsVisible:true,usersVisible:true,missionsRemoved:true});\n})();",
    "css": ".tm-drawer-group .tm-2485-personal-item{width:100%}.tm-drawer-group .tm-2485-personal-item svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:0 0 18px}.tm-drawer-group .tm-2485-personal-item.active{color:var(--v4-gold,#e0b44c)}@media(max-width:600px){.tm-drawer-group .tm-2485-personal-item{min-height:52px}}"
  },
  "payloadSha256": "7f3e4fbe2fc3e3510e2822065f283d824e53721f26de207b47084e91b36b7b35"
}

  ],
  "description": "Estabiliza a correção de EXIT USERS e Reinício na entrada do site/app, incluindo proteção contra corrida de inicialização.",
  "changelog": [
    "Mantém a correção que impede tokens históricos de EXIT USERS de expulsarem usuários ao entrar.",
    "Mantém a correção equivalente para Reinício.",
    "Adiciona tentativas de baseline por até 10 segundos para cobrir carregamento assíncrono do Painel SITE no app e no navegador.",
    "Mantém a correção da versão registrada para notificações de atualização introduzida na 2.4.1.1.",
    "Preserva o seletor nativo de ícones, Base Web 7.9.1 e todas as funções da Beta 2.4.1."
  ],
  "order": 241103,
  "payload": {
    "js": "(()=>{\n'use strict';\n\nconst PATCH_VERSION='2.4.1.3';\nconst BASE_VERSION='2.4.1';\nconst BASE_BUILD=276;\nconst WEB_VERSION='7.9.1';\nconst MARK='__TAREFAS_ALPHA_2413_SITE_SESSION_FIX__';\nconst SYNC_KEY='tarefas2413VersionSyncAt';\nconst SITE_EXIT_KEY='tarefas_site_791_exit_seen';\nconst SITE_RESTART_KEY='tarefas_site_791_restart_seen';\n\nif(globalThis[MARK])return;\nglobalThis[MARK]=true;\n\nglobalThis.__TAREFAS_EFFECTIVE_VERSION__=PATCH_VERSION;\nglobalThis.__TAREFAS_WEB_BASE_VERSION__=WEB_VERSION;\ndocument.documentElement.dataset.tarefasEffectiveVersion=PATCH_VERSION;\ndocument.documentElement.dataset.tarefasWebVersion=WEB_VERSION;\n\nconst getClient=()=>{try{return typeof supabaseClient!=='undefined'?supabaseClient:null}catch(_){return null}};\nconst sessionToken=()=>String(localStorage.getItem('tarefasPushSession17')||'').trim();\n\nfunction applyLabels(){\n  try{\n    document.querySelectorAll('.tm-app-brand small').forEach(el=>{\n      const wanted=PATCH_VERSION+' • WEB '+WEB_VERSION;\n      if(el.textContent.trim()!==wanted)el.textContent=wanted;\n    });\n    document.querySelectorAll('[data-tarefas-version],[data-app-version],.tm-about-version').forEach(el=>{\n      const text=String(el.textContent||'');\n      if(!text||text.length>160)return;\n      const next=text\n        .replace(/\\b2\\.4\\.1(?:\\.[12])?\\b/g,PATCH_VERSION)\n        .replace(/\\b2\\.3\\.222\\.1\\b/g,BASE_VERSION);\n      if(next!==text)el.textContent=next;\n    });\n  }catch(_){}\n}\n\nlet syncing=null;\nasync function syncRegisteredVersion({force=false}={}){\n  if(syncing)return syncing;\n  syncing=(async()=>{\n    const token=sessionToken();\n    const client=getClient();\n    if(!token||token.length<32||!client)return false;\n\n    if(!force){\n      const last=Number(localStorage.getItem(SYNC_KEY)||0);\n      if(last&&Date.now()-last<5*60*1000)return true;\n    }\n\n    const {data,error}=await client.rpc('v2_4_1_1_sync_app_version',{\n      p_session_token:token,\n      p_app_version:BASE_VERSION\n    });\n    if(error)throw error;\n    if(data!==true)return false;\n\n    localStorage.setItem(SYNC_KEY,String(Date.now()));\n    window.dispatchEvent(new CustomEvent('tarefas:app-version-synced',{\n      detail:{baseVersion:BASE_VERSION,effectiveVersion:PATCH_VERSION,build:BASE_BUILD}\n    }));\n    window.dispatchEvent(new CustomEvent('v6:notificacoes:update'));\n    return true;\n  })().catch(err=>{\n    console.warn('[TAREFAS 2.4.1.3] Falha ao sincronizar versão do aparelho:',err?.message||err);\n    return false;\n  }).finally(()=>{syncing=null});\n  return syncing;\n}\n\nasync function seedSiteControlTokens(){\n  try{\n    const panel=globalThis.SitePanel791;\n    if(!panel)return false;\n    let state=panel.state?.()||null;\n    if(!state&&panel.refresh){\n      try{await panel.refresh()}catch(_){}\n      state=panel.state?.()||null;\n    }\n    if(!state)return false;\n\n    if(localStorage.getItem(SITE_EXIT_KEY)===null&&state.acao_pendente!=='exit_users'){\n      localStorage.setItem(SITE_EXIT_KEY,String(Number(state.exit_token||0)));\n    }\n    if(localStorage.getItem(SITE_RESTART_KEY)===null&&state.acao_pendente!=='reiniciar'){\n      localStorage.setItem(SITE_RESTART_KEY,String(Number(state.restart_token||0)));\n    }\n    return true;\n  }catch(err){\n    console.warn('[TAREFAS 2.4.1.3] Falha ao criar baseline do Painel SITE:',err?.message||err);\n    return false;\n  }\n}\n\nlet baselineTimer=null;\nlet baselineAttempts=0;\nfunction ensureSiteBaseline(){\n  if(baselineTimer)return;\n  baselineAttempts=0;\n  const tick=async()=>{\n    baselineAttempts++;\n    const ok=await seedSiteControlTokens();\n    if(ok||baselineAttempts>=20){\n      clearInterval(baselineTimer);\n      baselineTimer=null;\n    }\n  };\n  tick();\n  baselineTimer=setInterval(tick,500);\n}\n\nfunction scheduleSync(force=false){setTimeout(()=>syncRegisteredVersion({force}),250)}\n\napplyLabels();\nensureSiteBaseline();\nscheduleSync(true);\n\nwindow.addEventListener('pageshow',()=>{applyLabels();ensureSiteBaseline();scheduleSync(false)});\nwindow.addEventListener('focus',()=>{applyLabels();ensureSiteBaseline();scheduleSync(false)});\nwindow.addEventListener('tarefas:push-session-ready',()=>{ensureSiteBaseline();scheduleSync(true)});\nwindow.addEventListener('tarefas:push-status',event=>{\n  if(event?.detail?.ready===true){ensureSiteBaseline();scheduleSync(true)}\n});\ndocument.addEventListener('visibilitychange',()=>{\n  if(!document.hidden){applyLabels();ensureSiteBaseline();scheduleSync(false)}\n});\n\nconst observer=new MutationObserver(records=>{\n  for(const record of records){\n    for(const node of record.addedNodes){\n      if(node.nodeType!==1)continue;\n      if(node.matches?.('.tm-app-brand,.tm-about-version,[data-tarefas-version],[data-app-version]')||\n         node.querySelector?.('.tm-app-brand,.tm-about-version,[data-tarefas-version],[data-app-version]')){\n        queueMicrotask(applyLabels);\n        return;\n      }\n    }\n  }\n});\nobserver.observe(document.body,{childList:true,subtree:true});\n\nglobalThis.TarefasAlpha2413=Object.freeze({\n  patchVersion:PATCH_VERSION,\n  baseVersion:BASE_VERSION,\n  build:BASE_BUILD,\n  webVersion:WEB_VERSION,\n  sync:()=>syncRegisteredVersion({force:true}),\n  baselineSite:seedSiteControlTokens,\n  refresh:applyLabels\n});\n})();",
    "css": ""
  },
  "payloadSha256": "20a7d14200e2b45e83da646fc2d0b4a2b99c81f22a795a1b70896aa851dc3591"
}

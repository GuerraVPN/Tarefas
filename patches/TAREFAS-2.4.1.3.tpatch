{
  "format": "tarefas-tpatch-v1",
  "id": "2.4.1.3",
  "name": "TAREFAS 2.4.1.3 — Estabilização de EXIT USERS e Reinício",
  "patchVersion": 3,
  "createdAt": "2026-09-22T17:45:00Z",
  "baseVersion": "2.4.1",
  "minBuild": 276,
  "maxBuild": 276,
  "channel": "alpha",
  "cumulative": true,
  "replacementMode": "replace-older-same-base",
  "replaces": [
    "2.4.1.1",
